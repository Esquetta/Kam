<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagevm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.PromptsView"
             x:DataType="pagevm:PromptsViewModel">
    <UserControl.Styles>
        <!-- Two columns (.p-cols): the list on the left, the selected prompt on the right.
             Below 980 px (the code-behind sets "narrow") the panes stack. -->
        <Style Selector="Border.PromptListPane">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.PromptDetailPane">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="StackPanel.narrow Border.PromptListPane">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.narrow Border.PromptDetailPane">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- A list row: /name in mono, the description under it -->
        <Style Selector="Button.PromptRow">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.PromptRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.PromptRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
        </Style>
        <Style Selector="Button.PromptRow.Selected /template/ ContentPresenter#PART_ContentPresenter, Button.PromptRow.Selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Prompts: the Markdown slash commands as a library -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Classes="WorkbenchPage PageColumn Wide">

            <!-- Header: make a prompt or open the folder -->
            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Prompts.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Prompts.Subtitle}" Classes="PageSubtitle"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="PageHeaderActions" IsVisible="{Binding !IsUnavailable}">
                    <Button Classes="SecondaryAction" Command="{Binding NewPromptCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconPlus}"/></Viewbox>
                            <TextBlock Text="{DynamicResource Lang.Prompts.Action.New}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="IconButton"
                            Width="32" Height="32"
                            AutomationProperties.Name="{DynamicResource Lang.Prompts.Action.OpenFolder}"
                            ToolTip.Tip="{DynamicResource Lang.Prompts.Action.OpenFolder}"
                            Command="{Binding OpenFolderCommand}">
                        <Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconFolder}"/></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Action result, shown only when something failed -->
            <Border Classes="Note" IsVisible="{Binding HasMessage}">
                <TextBlock Text="{Binding Message}"/>
            </Border>

            <!-- No catalog behind the page -->
            <StackPanel Classes="EmptyState" IsVisible="{Binding IsUnavailable}">
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconAlertCircle}"/></Viewbox>
                <TextBlock Text="{DynamicResource Lang.Prompts.Unavailable.Title}" Classes="EmptyTitle"/>
                <TextBlock Text="{DynamicResource Lang.Prompts.Unavailable.Body}" Classes="EmptyBody"/>
            </StackPanel>

            <!-- Empty library: where the files go; the header makes one or opens the folder -->
            <StackPanel Classes="EmptyState" IsVisible="{Binding IsEmpty}">
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconBookOpen}"/></Viewbox>
                <TextBlock Text="{DynamicResource Lang.Prompts.Empty.Title}" Classes="EmptyTitle"/>
                <TextBlock Text="{DynamicResource Lang.Prompts.Empty.Body}" Classes="EmptyBody"/>
                <SelectableTextBlock Text="{Binding UserDirectory}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"/>
            </StackPanel>

            <!-- The two panes -->
            <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14" IsVisible="{Binding HasPrompts}">

                <!-- Left: search and the prompts grouped by source -->
                <Border Classes="Pane PromptListPane">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <TextBox Text="{Binding SearchText}"
                                     PlaceholderText="{DynamicResource Lang.Prompts.Search.Placeholder}">
                                <TextBox.InnerLeftContent>
                                    <Viewbox Width="14" Height="14" Margin="10,0,0,0">
                                        <Path Classes="Icon Muted" Data="{StaticResource IconSearch}"/>
                                    </Viewbox>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </Border>

                        <TextBlock Text="{DynamicResource Lang.Prompts.NoMatches}" Classes="Caption" Margin="14,12"
                                   TextWrapping="Wrap" IsVisible="{Binding HasNoMatches}"/>

                        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="pagevm:PromptGroupViewModel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Classes="Overline" Margin="14,10,14,4"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="pagevm:PromptItemViewModel">
                                                    <Button Classes="PromptRow"
                                                            Classes.Selected="{Binding IsSelected}"
                                                            Command="{Binding SelectCommand}">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Slash}"
                                                                       FontSize="13"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}"
                                                                       Classes="Caption"
                                                                       IsVisible="{Binding HasDescription}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: the selected prompt -->
                <Border Classes="Pane PromptDetailPane">
                    <Panel>
                        <TextBlock Text="{DynamicResource Lang.Prompts.Detail.Select}" Classes="Caption" Margin="16"
                                   IsVisible="{Binding !HasSelection}"/>

                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="12" Margin="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" DataContext="{Binding SelectedPrompt}" x:DataType="pagevm:PromptItemViewModel">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Slash}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Classes="Pill" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceLabel}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               Classes="Caption"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasDescription}"/>
                                    <TextBlock Text="{DynamicResource Lang.Prompts.Detail.NoDescription}"
                                               Classes="Caption"
                                               IsVisible="{Binding !HasDescription}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="PrimaryAction Sm"
                                        Content="{DynamicResource Lang.Prompts.Action.Use}"
                                        Command="{Binding UseInNewTaskCommand}"/>
                                <Button Classes="SecondaryAction Sm"
                                        Content="{DynamicResource Lang.Prompts.Action.OpenFile}"
                                        Command="{Binding OpenFileCommand}"/>
                            </StackPanel>

                            <!-- Key/value facts -->
                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="6"
                                  DataContext="{Binding SelectedPrompt}" x:DataType="pagevm:PromptItemViewModel">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Lang.Prompts.Detail.Arguments}" Classes="KvKey"
                                           IsVisible="{Binding HasArgumentHint}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ArgumentHint}" Classes="KvValue"
                                           TextAlignment="Left"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           IsVisible="{Binding HasArgumentHint}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Lang.Prompts.Detail.File}" Classes="KvKey"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FilePath}" Classes="KvValue"
                                           TextAlignment="Left"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12"
                                           ToolTip.Tip="{Binding FilePath}"/>
                            </Grid>

                            <!-- Read-only preview of the file body -->
                            <TextBlock Text="{DynamicResource Lang.Prompts.Detail.Preview}" Classes="Overline"/>
                            <Border Classes="Code">
                                <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
