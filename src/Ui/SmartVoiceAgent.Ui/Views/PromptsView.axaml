<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagevm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.PromptsView"
             x:DataType="pagevm:PromptsViewModel">
    <UserControl.Styles>
        <!-- Master-detail: a 260 px unboxed list on the left, the selected prompt in one Pane on the right.
             Below 980 px (the code-behind sets "narrow") the list sits above the detail. -->
        <Style Selector="StackPanel.PromptList">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.PromptDetailPane">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="StackPanel.narrow StackPanel.PromptList">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.narrow Border.PromptDetailPane">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- A list item is two lines: /name in mono, the description under it -->
        <Style Selector="Button.ListItem.PromptItem">
            <Setter Property="MinHeight" Value="52"/>
        </Style>
    </UserControl.Styles>

    <!-- Prompts: the Markdown slash commands as a library -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Classes="WorkbenchPage PageColumn Wide">

            <!-- Header: make a prompt or open the folder -->
            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Prompts.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Prompts.Subtitle}" Classes="PageSubtitle"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="PageHeaderActions" IsVisible="{Binding !IsUnavailable}">
                    <Button Classes="SecondaryAction" Command="{Binding NewPromptCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconPlus}"/></Viewbox>
                            <TextBlock Text="{DynamicResource Lang.Prompts.Action.New}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="IconButton"
                            Width="32" Height="32"
                            AutomationProperties.Name="{DynamicResource Lang.Prompts.Action.OpenFolder}"
                            ToolTip.Tip="{DynamicResource Lang.Prompts.Action.OpenFolder}"
                            Command="{Binding OpenFolderCommand}">
                        <Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconFolder}"/></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Action result, shown only when something failed -->
            <Border Classes="Note" IsVisible="{Binding HasMessage}">
                <TextBlock Text="{Binding Message}"/>
            </Border>

            <!-- No catalog behind the page -->
            <StackPanel Classes="EmptyState" IsVisible="{Binding IsUnavailable}">
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconAlertCircle}"/></Viewbox>
                <TextBlock Text="{DynamicResource Lang.Prompts.Unavailable.Title}" Classes="EmptyTitle"/>
                <TextBlock Text="{DynamicResource Lang.Prompts.Unavailable.Body}" Classes="EmptyBody"/>
            </StackPanel>

            <!-- Empty library: where the files go; the header makes one or opens the folder -->
            <StackPanel Classes="EmptyState" IsVisible="{Binding IsEmpty}">
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconBookOpen}"/></Viewbox>
                <TextBlock Text="{DynamicResource Lang.Prompts.Empty.Title}" Classes="EmptyTitle"/>
                <TextBlock Text="{DynamicResource Lang.Prompts.Empty.Body}" Classes="EmptyBody"/>
                <SelectableTextBlock Text="{Binding UserDirectory}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"
                                     TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Master-detail -->
            <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="16" IsVisible="{Binding HasPrompts}">

                <!-- Left: search and the prompts grouped by source, no box -->
                <StackPanel Classes="PromptList" Spacing="12">
                    <TextBox Classes="Search"
                             Text="{Binding SearchText}"
                             PlaceholderText="{DynamicResource Lang.Prompts.Search.Placeholder}">
                        <TextBox.InnerLeftContent>
                            <Viewbox Classes="SearchIcon">
                                <Path Classes="Icon Muted" Data="{StaticResource IconSearch}"/>
                            </Viewbox>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <TextBlock Text="{DynamicResource Lang.Prompts.NoMatches}" Classes="Secondary" Margin="10,0"
                               TextWrapping="Wrap" IsVisible="{Binding HasNoMatches}"/>

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="pagevm:PromptGroupViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" Classes="Caption" Margin="10,0,10,4"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="pagevm:PromptItemViewModel">
                                                <Button Classes="ListItem PromptItem"
                                                        Classes.Selected="{Binding IsSelected}"
                                                        AutomationProperties.Name="{Binding Slash}"
                                                        Command="{Binding SelectCommand}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Slash}"
                                                                   Classes="Mono"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Classes="Secondary"
                                                                   IsVisible="{Binding HasDescription}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: the selected prompt in one Pane -->
                <Border Classes="Pane PromptDetailPane">
                    <Panel>
                        <TextBlock Text="{DynamicResource Lang.Prompts.Detail.Select}" Classes="Secondary" Margin="16"
                                   IsVisible="{Binding !HasSelection}"/>

                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="12" Margin="16">
                            <StackPanel Spacing="4" DataContext="{Binding SelectedPrompt}" x:DataType="pagevm:PromptItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Slash}" Classes="CardTitle Mono" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SourceLabel}" Classes="Caption" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           Classes="Secondary"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasDescription}"/>
                                <TextBlock Text="{DynamicResource Lang.Prompts.Detail.NoDescription}"
                                           Classes="Secondary"
                                           IsVisible="{Binding !HasDescription}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="PrimaryAction"
                                        Content="{DynamicResource Lang.Prompts.Action.Use}"
                                        Command="{Binding UseInNewTaskCommand}"/>
                                <Button Classes="GhostAction"
                                        Content="{DynamicResource Lang.Prompts.Action.OpenFile}"
                                        Command="{Binding OpenFileCommand}"/>
                            </StackPanel>

                            <!-- Arguments, when the prompt takes any, and the file on one mono line with a copy button -->
                            <StackPanel Spacing="4" DataContext="{Binding SelectedPrompt}" x:DataType="pagevm:PromptItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasArgumentHint}">
                                    <TextBlock Text="{DynamicResource Lang.Prompts.Detail.Arguments}" Classes="Secondary"/>
                                    <TextBlock Text="{Binding ArgumentHint}" Classes="Secondary Mono"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <TextBlock Text="{Binding FilePath}"
                                               Classes="Secondary Mono"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding FilePath}"/>
                                    <Button Grid.Column="1"
                                            Classes="IconButton"
                                            Width="24" Height="24" MinWidth="24" MinHeight="24"
                                            CornerRadius="6"
                                            AutomationProperties.Name="{DynamicResource Lang.Common.Copy}"
                                            ToolTip.Tip="{DynamicResource Lang.Common.Copy}"
                                            Click="OnCopyPathClick">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconCopy}"/></Viewbox>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Read-only preview of the file body -->
                            <Border Classes="Code">
                                <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
