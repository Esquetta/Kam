<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels"
		xmlns:pagevm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
		xmlns:local="clr-namespace:SmartVoiceAgent.Ui.Views"
		xmlns:services="clr-namespace:SmartVoiceAgent.Ui.Services"
		xmlns:converters="clr-namespace:SmartVoiceAgent.Ui.Converters"
		xmlns:controls="using:SmartVoiceAgent.Ui.Controls"
		x:Class="SmartVoiceAgent.Ui.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Background="{DynamicResource PanelBgBrush}"
		Foreground="{DynamicResource TextPrimaryBrush}"
		FontSize="13"
		TransparencyLevelHint="Mica"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaTitleBarHeightHint="48"
		Title="Kam"
		Icon="/Assets/favicon.ico"
		Width="1360" Height="860"
		MinWidth="640" MinHeight="560">

	<Window.Resources>
		<!-- One task row in the rail; the three task groups share it. A click opens the task from any page. -->
		<DataTemplate x:Key="TaskRowTemplate" DataType="vm:AgentChatSessionViewModel">
			<Panel Classes="ChatSessionRow" IsVisible="{Binding IsVisibleInList}">
				<Button Classes="ListItem TaskRow"
						Classes.Selected="{Binding IsSelected}"
						IsVisible="{Binding IsShowingSummary}"
						AutomationProperties.Name="{Binding Title}"
						Command="{Binding $parent[local:MainWindow].DataContext.OpenTaskCommand}"
						CommandParameter="{Binding}">
					<Button.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{DynamicResource Lang.Common.Rename}" InputGesture="F2" Click="OnRenameChatClick"/>
							<MenuItem Header="{DynamicResource Lang.Common.Delete}" IsEnabled="{Binding CanDelete}" Click="OnDeleteChatClick"/>
						</ContextMenu>
					</Button.ContextMenu>
					<!-- Title, then a dot while it runs (accent) or waits for you (orange), and the time -->
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<TextBlock Grid.Column="0" Classes="TaskRowTitle" Text="{Binding Title}"/>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<Border Classes="TaskDot"
									Classes.Working="{Binding IsWorking}"
									Classes.Waiting="{Binding HasPendingApproval}"
									Classes.Animated="{Binding !ReducedMotion, Source={x:Static services:WindowStateManager.Instance}}"
									IsVisible="{Binding HasStatus}"
									ToolTip.Tip="{Binding StatusText}"/>
							<TextBlock Classes="Caption ChatRowTime"
									   Text="{Binding RelativeTimeText}"
									   TextWrapping="NoWrap"
									   VerticalAlignment="Center"/>
						</StackPanel>
					</Grid>
				</Button>

				<!-- Row menu; shown on hover in place of the time -->
				<Button Classes="IconButton CompactIconButton ChatRowMenu"
						IsVisible="{Binding IsShowingSummary}"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Margin="0,0,2,0"
						Background="Transparent"
						BorderThickness="0"
						AutomationProperties.Name="{DynamicResource Lang.Chat.Options}"
						ToolTip.Tip="{DynamicResource Lang.Chat.Options}">
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<MenuItem Header="{DynamicResource Lang.Common.Rename}" InputGesture="F2" Click="OnRenameChatClick"/>
							<MenuItem Header="{DynamicResource Lang.Common.Delete}" IsEnabled="{Binding CanDelete}" Click="OnDeleteChatClick"/>
						</MenuFlyout>
					</Button.Flyout>
					<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconMore}" StrokeThickness="3" Stretch="None"/></Viewbox>
				</Button>

				<!-- Rename: Enter saves, Esc cancels -->
				<Border Classes="ChatSessionEditor"
						IsVisible="{Binding IsRenaming}"
						PropertyChanged="OnRenameEditorPropertyChanged">
					<TextBox Classes="ChatRenameInput"
							 Text="{Binding EditTitle, Mode=TwoWay}"
							 MaxLength="120"
							 KeyDown="OnRenameKeyDown"
							 LostFocus="OnRenameLostFocus"/>
				</Border>

				<!-- Delete confirmation -->
				<Border Classes="ChatSessionEditor"
						IsVisible="{Binding IsConfirmingDelete}">
					<StackPanel Spacing="8">
						<StackPanel Spacing="2">
							<TextBlock Text="{DynamicResource Lang.Chat.DeleteConfirm.Title}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource Lang.Chat.DeleteConfirm.Body}"
									   Classes="Caption"
									   TextWrapping="Wrap"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
							<Button Classes="SecondaryAction ChatRowAction"
									Content="{DynamicResource Lang.Common.Cancel}"
									Command="{Binding $parent[local:MainWindow].DataContext.CancelDeleteAgentChatCommand}"
									CommandParameter="{Binding}"/>
							<Button Classes="DestructiveAction ChatRowAction"
									Content="{DynamicResource Lang.Common.Delete}"
									Command="{Binding $parent[local:MainWindow].DataContext.ConfirmDeleteAgentChatCommand}"
									CommandParameter="{Binding}"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Panel>
		</DataTemplate>
	</Window.Resources>

	<Window.Styles>
		<!-- The window keeps its name for the taskbar and Alt-Tab, but the drawn title bar would paint it
			 over the sidebar logo; Kam's own header shows the page instead. The separate full-screen
			 button goes too; maximize covers it. -->
		<Style Selector="WindowDrawnDecorations /template/ TextBlock">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<Style Selector="WindowDrawnDecorations /template/ :is(Control)#PART_FullScreenButton">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- ========================= -->
		<!-- SIDEBAR NAVIGATION -->
		<!-- ========================= -->

		<!-- Rail: one sidebar for navigation and recent tasks, with a hairline on the right; icons only below 760 px -->
		<!-- The rail is as wide as the user dragged it (232 px by default); compact it is 60 px -->
		<Style Selector="Border.Sidebar" x:DataType="vm:MainWindowViewModel">
			<Setter Property="Width" Value="{Binding RailWidth}"/>
			<Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="0,0,1,0"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact">
			<Setter Property="Width" Value="60"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact TextBlock.NavLabel">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Holds what sits beside a label, such as a count or a key hint -->
		<Style Selector="Border.Sidebar.Compact Panel.NavLabelGroup">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Compact, the group labels and the recent tasks go; every nav icon shows, and Search (Ctrl+K) finds tasks -->
		<Style Selector="Border.Sidebar.Compact Button.RailGroupHeader, Border.Sidebar.Compact Grid.RailTasks">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Build and Manage: the label is a button that collapses its group; a chevron shows the state -->
		<Style Selector="Button.RailGroupHeader">
			<Setter Property="Height" Value="24"/>
			<Setter Property="Margin" Value="0,12,0,2"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.RailGroupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
		</Style>
		<Style Selector="Button.RailGroupHeader Viewbox.GroupChevron">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.RailGroupHeader.Collapsed Viewbox.GroupChevron">
			<Setter Property="RenderTransform" Value="rotate(-90deg)"/>
		</Style>
		<Style Selector="StackPanel.RailGroupItems.Collapsed">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<!-- After the rule above, so a collapsed group still shows its icons in the compact rail -->
		<Style Selector="Border.Sidebar.Compact StackPanel.RailGroupItems.Collapsed">
			<Setter Property="IsVisible" Value="True"/>
		</Style>

		<!-- Key hints on New task and Search show while the row is hovered -->
		<Style Selector="Button.NavBtn Border.HoverKbd">
			<Setter Property="Opacity" Value="0"/>
		</Style>
		<Style Selector="Button.NavBtn:pointerover Border.HoverKbd">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="Button.NavBtn">
			<Setter Property="Height" Value="32"/>
			<Setter Property="Margin" Value="0,0,0,1"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<!-- Tips open beside the rail, so they never cover the next row -->
			<Setter Property="ToolTip.Placement" Value="Right"/>
			<Setter Property="ToolTip.HorizontalOffset" Value="8"/>
		</Style>

		<Style Selector="Button.NavBtn /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn:pointerover Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn TextBlock.NavLabel">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Mic (.mic): 30 px square with a hairline; accent fill while listening -->
		<Style Selector="Button.MicButton">
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.MicButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>
		<Style Selector="Button.MicButton.listening /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}"/>
		</Style>
		<Style Selector="Button.MicButton.listening Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}"/>
		</Style>

		<!-- Below 980 px the top bar drops the wake pill -->
		<Style Selector="Grid.TopBar.narrow Panel.WakePill">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Context meter in the composer bar: thin, accent, orange near the budget -->
		<Style Selector="ProgressBar.ContextMeter">
			<Setter Property="Height" Value="6"/>
			<Setter Property="MinHeight" Value="6"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
		</Style>
		<Style Selector="ProgressBar.ContextMeter.Warning">
			<Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active TextBlock.NavLabel">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>

		<!-- ========================= -->
		<!-- SLASH COMMAND PALETTE -->
		<!-- ========================= -->

		<Style Selector="Button.SlashCommandItem">
			<Setter Property="MinHeight" Value="36"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SlashCommandItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:focus /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<!-- ========================= -->
		<!-- CHAT WORKBENCH -->
		<!-- ========================= -->

		<Style Selector="Border.AttachmentChip">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="Margin" Value="0,0,6,6"/>
		</Style>

		<!-- Strips above the composer: voice status, a missing model and queued messages -->
		<Style Selector="Border.VoiceStatusStrip">
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,4,4,4"/>
			<Setter Property="MinHeight" Value="30"/>
		</Style>

		<Style Selector="Border.QueuedMessageStrip">
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,4,4,4"/>
		</Style>

		<!-- Recent tasks in the rail: group labels, then 32 px rows (a ListItem) with the title and the time -->
		<Style Selector="Grid.TaskGroupHeader">
			<Setter Property="Margin" Value="8,10,8,4"/>
		</Style>

		<Style Selector="Button.TaskRow">
			<Setter Property="MinHeight" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>

		<!-- On other pages no task is the current one, so the rail shows only the page as selected -->
		<Style Selector="Border.Sidebar.OffTasks Button.TaskRow.Selected">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>
		<Style Selector="Border.Sidebar.OffTasks Button.TaskRow.Selected:not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="TextBlock.TaskRowTitle">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Running: a pulsing accent dot (still under reduced motion); waiting for you: an orange dot -->
		<Style Selector="Border.TaskDot">
			<Setter Property="Width" Value="6"/>
			<Setter Property="Height" Value="6"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
		<Style Selector="Border.TaskDot.Working">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
		</Style>
		<Style Selector="Border.TaskDot.Working.Animated">
			<Style.Animations>
				<Animation Duration="0:0:1.2" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
					<KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		<Style Selector="Border.TaskDot.Waiting">
			<Setter Property="Background" Value="{DynamicResource AccentOrangeBrush}"/>
		</Style>

		<!-- Row menu shows on hover, in place of the time -->
		<Style Selector="Button.ChatRowMenu">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Panel.ChatSessionRow:pointerover Button.ChatRowMenu, Button.ChatRowMenu:flyout-open, Button.ChatRowMenu:focus-visible">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="Panel.ChatSessionRow:pointerover TextBlock.ChatRowTime">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Border.ChatSessionEditor">
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<Style Selector="TextBox.ChatRenameInput">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>

		<Style Selector="Button.ChatRowAction">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<!-- Copy buttons under messages show on hover -->
		<Style Selector="Button.MessageAction">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Border.ChatMessage:pointerover Button.MessageAction, Button.MessageAction:focus-visible">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<!-- Thread title in the top bar (Tasks only): 14 Medium, trimmed -->
		<Style Selector="TextBlock.ThreadTitle">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="MaxWidth" Value="360"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Model picker and permission mode: ghost Sm combos, no fill or border until hovered -->
		<Style Selector="ComboBox.ModelPicker, ComboBox.ApprovalModePicker">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="MaxWidth" Value="360"/>
			<Setter Property="Padding" Value="8,0,4,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="ComboBox.ModelPicker:pointerover /template/ Border#Background, ComboBox.ApprovalModePicker:pointerover /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<!-- Title bar status: a dot and text, no pill -->
		<Style Selector="Button.HeaderStatus">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.HeaderStatus /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.HeaderStatus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
		</Style>
		<Style Selector="TextBlock.HeaderStatusText">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.HeaderStatusText.Warning">
			<Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>

		<!-- Transparent, so hovering anywhere in a message shows its copy button -->
		<Style Selector="Border.ChatMessage">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<!-- User message (.msg.user): accent fill, white text, a tight bottom-right corner -->
		<Style Selector="Border.UserBubble">
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="CornerRadius" Value="12,12,4,12"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="MaxWidth" Value="620"/>
		</Style>

		<!-- Tool items sit closer together than messages, so a run of steps reads as one block -->
		<Style Selector="Border.ChatMessage.Tool">
			<Setter Property="Margin" Value="0,0,0,2"/>
		</Style>

		<!-- Tool step (Claude / Codex style): one quiet line, no card. Waiting for approval makes it a bordered row. -->
		<Style Selector="Border.ToolLine">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Border.ToolLine.Approval">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentOrangeBrush}"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="Margin" Value="0,6"/>
		</Style>

		<!-- A subagent's step: one card holding the subagent's own steps -->
		<Style Selector="Border.SubagentCard">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="Margin" Value="0,6"/>
		</Style>

		<!-- Steps inside a read group or a subagent card, under a hairline rail -->
		<Style Selector="Border.ToolChildren">
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1,0,0,0"/>
			<Setter Property="Margin" Value="6,2,0,4"/>
			<Setter Property="Padding" Value="14,0,0,0"/>
		</Style>

		<Style Selector="Border.ToolArguments">
			<Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="9,7"/>
		</Style>

		<Style Selector="Panel.ToolStatusGlyph">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.ToolLineName">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="ToggleButton.ToolLineHeader:pointerover TextBlock.ToolLineName">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="TextBlock.ToolLineTarget">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.ToolLineMeta">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<!-- A failed step's one-line error, in a muted red -->
		<Style Selector="TextBlock.ToolLineError">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentErrorBrush}"/>
			<Setter Property="Opacity" Value="0.8"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="SelectableTextBlock.ToolResult">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style Selector="TextBlock.SubagentJob">
			<Setter Property="Margin" Value="22,0,0,0"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="LineHeight" Value="19"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="MaxLines" Value="2"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
		</Style>

		<!-- Risk tag on a step's line, only for writes (warn) and programs, external sends and hand-offs (danger) -->
		<Style Selector="TextBlock.RiskTag">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.RiskTag.Write">
			<Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
		</Style>
		<Style Selector="TextBlock.RiskTag.Shell">
			<Setter Property="Foreground" Value="{DynamicResource AccentErrorBrush}"/>
		</Style>

		<!-- The whole line is the toggle; it keeps the thread's look in every state -->
		<Style Selector="ToggleButton.ToolLineHeader">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0,4"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.ToolLineHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter,
						 ToggleButton.ToolLineHeader:pressed /template/ ContentPresenter#PART_ContentPresenter,
						 ToggleButton.ToolLineHeader:checked /template/ ContentPresenter#PART_ContentPresenter,
						 ToggleButton.ToolLineHeader:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<!-- The chevron of a group or a subagent card points down while its steps show -->
		<Style Selector="Viewbox.ToolLineChevron">
			<Setter Property="RenderTransform" Value="rotate(-90deg)"/>
		</Style>
		<Style Selector="Viewbox.ToolLineChevron.open">
			<Setter Property="RenderTransform" Value="none"/>
		</Style>

		<!-- Context meter in the composer bar: a small raised pill, shown once the context passes half the budget -->
		<Style Selector="Button.ComposerPill">
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.ComposerPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<!-- The composer's mic: a ghost icon like its neighbours; accent fill while listening -->
		<Style Selector="Button.TalkButton.listening /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
		</Style>
		<Style Selector="Button.TalkButton.listening Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}"/>
		</Style>

		<Style Selector="Ellipse.WorkingDot">
			<Style.Animations>
				<Animation Duration="0:0:1.2" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
					<KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<Style Selector="Button.SuggestionCard">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="14,12"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SuggestionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>

		<!-- Composer: one quiet panel, the prompt on top and the bar below; focus darkens the border, no accent -->
		<Style Selector="Border.ComposerSurface">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="12,10,8,8"/>
			<Setter Property="MinHeight" Value="88"/>
		</Style>
		<Style Selector="Border.ComposerSurface:focus-within">
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>

		<!-- Composer inputs render without their own chrome; the surrounding surface provides it -->
		<Style Selector="TextBox.BareInput">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="PlaceholderForeground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<Style Selector="TextBox.BareInput /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- Send: a 28 px round button with an arrow on AccentStrong; muted while the composer is empty.
		     While a turn runs the Stop variant takes its place with a square. -->
		<Style Selector="Button.SendButton">
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="MinWidth" Value="28"/>
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="999"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SendButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentStrongHoverBrush}"/>
		</Style>

		<Style Selector="Button.SendButton Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}"/>
			<Setter Property="StrokeThickness" Value="2.5"/>
		</Style>

		<Style Selector="Button.SendButton.Empty">
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
		</Style>

		<Style Selector="Button.SendButton.Empty:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
		</Style>

		<Style Selector="Button.SendButton.Empty Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="48,*">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ========================= -->
		<!-- RAIL: one sidebar. Brand, New task, Search, Needs you, Build and Manage, recent tasks, then Settings -->
		<!-- ========================= -->
		<!-- Drag the rail's right edge to resize it; a double click restores 232 px -->
		<controls:PaneResizeHandle Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
								   Width="8" Margin="0,0,-4,0" ZIndex="10"
								   HorizontalAlignment="Right"
								   IsVisible="{Binding !IsRailCompact, Source={x:Static services:WindowStateManager.Instance}}"
								   Size="{Binding RailWidth}"
								   DefaultSize="{Binding RailDefaultWidth}"
								   Committed="{Binding SavePaneWidthsCommand}"
								   LineBrush="{DynamicResource AccentBrush}"
								   ToolTip.Tip="{DynamicResource Lang.Shell.ResizeTip}"/>
		<Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
				Classes="Sidebar"
				Classes.Compact="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsRailCompact}"
				Classes.OffTasks="{Binding !IsChatWorkbenchVisible}"
				PointerPressed="OnHeaderPointerPressed">
			<Grid RowDefinitions="48,Auto,*,Auto" Margin="10,0,10,10">

				<!-- Brand: 48 px, level with the top bar and the caption buttons -->
				<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center">
					<Border Width="20" Height="20"
							CornerRadius="6"
							Background="{DynamicResource AccentStrongBrush}">
						<Viewbox Width="12" Height="12">
							<Path Classes="Icon"
								  Data="{StaticResource IconBrandWave}"
								  Stroke="{DynamicResource AccentOnBrush}"
								  StrokeThickness="2.6"/>
						</Viewbox>
					</Border>
					<TextBlock Classes="NavLabel"
							   Text="Kam"
							   FontSize="13"
							   FontWeight="SemiBold"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource TextPrimaryBrush}"/>
				</StackPanel>

				<!-- Navigation -->
				<StackPanel Grid.Row="1">
					<!-- New task: opens a new task on the Tasks page and focuses the composer -->
					<Button Classes="NavBtn"
							Click="OnNewTaskClick"
							AutomationProperties.Name="{DynamicResource Lang.Chat.NewTask}"
							ToolTip.Tip="{DynamicResource Lang.Chat.NewChatTip}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconPlus}"/></Viewbox>
							<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Chat.NewTask}"/>
							<Panel Grid.Column="2" Classes="NavLabelGroup">
								<Border Classes="Kbd HoverKbd"><TextBlock Text="Ctrl N"/></Border>
							</Panel>
						</Grid>
					</Button>
					<!-- Search: the command palette, which also lists every task -->
					<Button Classes="NavBtn"
							Click="OnTitleSearchClick"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Search}"
							ToolTip.Tip="{DynamicResource Lang.Shell.SearchTasksTip}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconSearch}"/></Viewbox>
							<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Search}"/>
							<Panel Grid.Column="2" Classes="NavLabelGroup">
								<Border Classes="Kbd HoverKbd"><TextBlock Text="Ctrl K"/></Border>
							</Panel>
						</Grid>
					</Button>
					<!-- Needs you: an orange dot and the count while approvals wait -->
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Inbox}}"
							Command="{Binding NavigateToInboxCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Inbox}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.InboxTip}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconInbox}"/></Viewbox>
							<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Inbox}"/>
							<Panel Grid.Column="2" Classes="NavLabelGroup">
								<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPendingApprovals}">
									<Border Classes="StatusDot Warning"/>
									<TextBlock Classes="Caption" Text="{Binding PendingApprovalCount}" VerticalAlignment="Center"/>
								</StackPanel>
							</Panel>
						</Grid>
					</Button>

					<!-- Build: prompts, agents, loops, graphs and runs. The label collapses the group; the choice is saved. -->
					<Button Classes="RailGroupHeader"
							Classes.Collapsed="{Binding IsBuildGroupCollapsed}"
							Command="{Binding ToggleRailGroupCommand}"
							CommandParameter="Build"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Build}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.GroupTip}">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Classes="NavLabel Overline" Text="{DynamicResource Lang.Shell.Nav.Build}" VerticalAlignment="Center"/>
							<Viewbox Grid.Column="1" Classes="GroupChevron"><Path Classes="Icon" Data="{StaticResource IconChevronDown}"/></Viewbox>
						</Grid>
					</Button>
					<StackPanel Classes="RailGroupItems" Classes.Collapsed="{Binding IsBuildGroupCollapsed}">
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Prompts}}"
								Command="{Binding NavigateToPageCommand}"
								CommandParameter="{x:Static vm:NavView.Prompts}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Prompts}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.PromptsTip}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconBookOpen}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Prompts}"/>
							</StackPanel>
						</Button>
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Agents}}"
								Command="{Binding NavigateToPageCommand}"
								CommandParameter="{x:Static vm:NavView.Agents}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Agents}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.AgentsTip}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconBot}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Agents}"/>
							</StackPanel>
						</Button>
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Loops}}"
								Command="{Binding NavigateToPageCommand}"
								CommandParameter="{x:Static vm:NavView.Loops}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Loops}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.LoopsTip}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconRefresh}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Loops}"/>
							</StackPanel>
						</Button>
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Graphs}}"
								Command="{Binding NavigateToPageCommand}"
								CommandParameter="{x:Static vm:NavView.Graphs}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Graphs}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.GraphsTip}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconNetwork}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Graphs}"/>
							</StackPanel>
						</Button>
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Runs}}"
								Command="{Binding NavigateToPageCommand}"
								CommandParameter="{x:Static vm:NavView.Runs}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Runs}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Nav.RunsTip}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconActivity}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Runs}"/>
							</StackPanel>
						</Button>
					</StackPanel>

					<!-- Manage: what agents can use -->
					<Button Classes="RailGroupHeader"
							Classes.Collapsed="{Binding IsManageGroupCollapsed}"
							Command="{Binding ToggleRailGroupCommand}"
							CommandParameter="Manage"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Manage}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.GroupTip}">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Classes="NavLabel Overline" Text="{DynamicResource Lang.Shell.Nav.Manage}" VerticalAlignment="Center"/>
							<Viewbox Grid.Column="1" Classes="GroupChevron"><Path Classes="Icon" Data="{StaticResource IconChevronDown}"/></Viewbox>
						</Grid>
					</Button>
					<StackPanel Classes="RailGroupItems" Classes.Collapsed="{Binding IsManageGroupCollapsed}">
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Extensions}}"
								Command="{Binding NavigateToExtensionsCommand}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Extensions}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Extensions}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconPuzzle}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Extensions}"/>
							</StackPanel>
						</Button>
						<Button Classes.NavBtn="True"
								Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Integrations}}"
								Command="{Binding NavigateToIntegrationsCommand}"
								AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Integrations}"
								ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Integrations}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconPlug}"/></Viewbox>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Integrations}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</StackPanel>

				<!-- Recent tasks fill the rest: waiting for you, running, then the rest. The compact rail hides them;
				     Search (Ctrl+K) lists every task there. -->
				<Grid Grid.Row="2" Classes="RailTasks" RowDefinitions="Auto,*" Margin="0,12,0,0">
					<!-- Search: matches titles and the last message -->
					<TextBox Grid.Row="0"
							 x:Name="ChatSearchInput"
							 Classes="Search"
							 PlaceholderText="{DynamicResource Lang.Chat.Search.Placeholder}"
							 Text="{Binding AgentChatSearchText, Mode=TwoWay}"
							 KeyDown="OnChatSearchKeyDown">
						<TextBox.InnerLeftContent>
							<Viewbox Classes="SearchIcon" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
						</TextBox.InnerLeftContent>
						<TextBox.InnerRightContent>
							<Button Classes="IconButton CompactIconButton"
									Margin="0,0,4,0"
									Background="Transparent"
									BorderThickness="0"
									AutomationProperties.Name="{DynamicResource Lang.Chat.Search.Clear}"
									ToolTip.Tip="{DynamicResource Lang.Chat.Search.Clear}"
									IsVisible="{Binding IsAgentChatSearchActive}"
									Command="{Binding ClearAgentChatSearchCommand}">
								<Viewbox Width="12" Height="12"><Path Classes="Icon" Data="{StaticResource IconX}"/></Viewbox>
							</Button>
						</TextBox.InnerRightContent>
					</TextBox>

					<Panel Grid.Row="1">
						<ScrollViewer VerticalScrollBarVisibility="Auto"
									  HorizontalScrollBarVisibility="Disabled">
							<StackPanel x:Name="ChatThreadList" Spacing="0">
								<StackPanel Spacing="0" IsVisible="{Binding HasWaitingTasks}">
									<Grid ColumnDefinitions="*,Auto" Classes="TaskGroupHeader">
										<TextBlock Text="{DynamicResource Lang.Chat.Group.NeedsYou}" Classes="Overline"/>
										<TextBlock Grid.Column="1" Text="{Binding WaitingTasks.Count}" Classes="Overline"/>
									</Grid>
									<ItemsControl ItemsSource="{Binding WaitingTasks}" ItemTemplate="{StaticResource TaskRowTemplate}"/>
								</StackPanel>
								<StackPanel Spacing="0" IsVisible="{Binding HasRunningTaskGroup}">
									<Grid ColumnDefinitions="*,Auto" Classes="TaskGroupHeader">
										<TextBlock Text="{DynamicResource Lang.Chat.Group.Running}" Classes="Overline"/>
										<TextBlock Grid.Column="1" Text="{Binding RunningTasks.Count}" Classes="Overline"/>
									</Grid>
									<ItemsControl ItemsSource="{Binding RunningTasks}" ItemTemplate="{StaticResource TaskRowTemplate}"/>
								</StackPanel>
								<StackPanel Spacing="0" IsVisible="{Binding HasRecentTasks}">
									<Grid ColumnDefinitions="*,Auto" Classes="TaskGroupHeader">
										<TextBlock Text="{DynamicResource Lang.Chat.Group.Recent}" Classes="Overline"/>
										<TextBlock Grid.Column="1" Text="{Binding RecentTasks.Count}" Classes="Overline"/>
									</Grid>
									<ItemsControl ItemsSource="{Binding RecentTasks}" ItemTemplate="{StaticResource TaskRowTemplate}"/>
								</StackPanel>
							</StackPanel>
						</ScrollViewer>

						<TextBlock Text="{DynamicResource Lang.Chat.Search.NoResults}"
								   Classes="Caption"
								   HorizontalAlignment="Center"
								   Margin="0,16,0,0"
								   IsVisible="{Binding HasNoAgentChatSearchResults}"/>
					</Panel>
				</Grid>

				<!-- Footer: Settings; the theme lives in Settings and the palette -->
				<StackPanel Grid.Row="3" Classes="SidebarFooter" Margin="0,8,0,0">
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Settings}}"
							Command="{Binding NavigateToSettingsCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Settings}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Settings}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconSliders}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Settings}"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ========================= -->
		<!-- TOP BAR (48 px, draggable): on Tasks the thread title, model and menu; status, search, wake phrase, push to talk.
		     Other pages own their title, so the left side stays empty there. -->
		<!-- ========================= -->
		<Border Grid.Row="0" Grid.Column="1"
				Background="Transparent"
				BorderBrush="{DynamicResource BorderSubtleBrush}"
				BorderThickness="0,0,0,1"
				PointerPressed="OnHeaderPointerPressed">
			<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
				  Classes="TopBar"
				  Classes.narrow="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsNarrow}"
				  ColumnSpacing="10"
				  Margin="14,0,210,0">
				<!-- Tasks: the thread title (trims), its status, the model for this chat and the chat menu -->
				<StackPanel Grid.Column="0"
							Orientation="Horizontal"
							Spacing="8"
							ClipToBounds="True"
							IsVisible="{Binding IsChatWorkbenchVisible}">
					<TextBlock Classes="ThreadTitle"
							   Text="{Binding SelectedAgentChatSession.Title}"
							   ToolTip.Tip="{Binding SelectedAgentChatSession.Title}"/>
					<!-- While the task runs or waits for an approval: a dot and text -->
					<StackPanel Orientation="Horizontal"
								Spacing="6"
								VerticalAlignment="Center"
								IsVisible="{Binding SelectedAgentChatSession.HasStatus}">
						<Border Classes="StatusDot"
								Classes.Accent="{Binding SelectedAgentChatSession.IsWorking}"
								Classes.Warning="{Binding SelectedAgentChatSession.HasPendingApproval}"
								VerticalAlignment="Center"/>
						<TextBlock Text="{Binding SelectedAgentChatSession.StatusText}"
								   FontSize="12"
								   Foreground="{DynamicResource TextMutedBrush}"
								   VerticalAlignment="Center"/>
					</StackPanel>
					<!-- Model for this chat; "Settings default" follows the model chosen in Settings -->
					<ComboBox Classes="ModelPicker"
							  ItemsSource="{Binding AgentChatModelOptions}"
							  SelectedItem="{Binding SelectedAgentChatModel, Mode=TwoWay}"
							  IsVisible="{Binding IsAgentRuntimeEnabled}"
							  ToolTip.Tip="{Binding AgentChatModelTip}">
						<!-- The closed picker shows only the model, so a long id cannot push the bar off screen -->
						<ComboBox.SelectionBoxItemTemplate>
							<DataTemplate DataType="vm:AgentChatModelOption">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
									<TextBlock Text="{Binding Label}"
											   FontSize="12"
											   MaxWidth="160"
											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center"/>
								</StackPanel>
							</DataTemplate>
						</ComboBox.SelectionBoxItemTemplate>
						<ComboBox.ItemTemplate>
							<DataTemplate DataType="vm:AgentChatModelOption">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<Viewbox Width="12" Height="12" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{Binding Label}"
											   FontSize="12"
											   MaxWidth="220"
											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center"/>
									<TextBlock Text="{Binding Caption}"
											   FontSize="11"
											   Foreground="{DynamicResource TextMutedBrush}"
											   VerticalAlignment="Center"/>
								</StackPanel>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<!-- Chat menu; with no thread passed, the commands act on the selected one -->
					<Button Classes="IconButton"
							Width="28" Height="28"
							VerticalAlignment="Center"
							AutomationProperties.Name="{DynamicResource Lang.Chat.Options}"
							ToolTip.Tip="{DynamicResource Lang.Chat.Options}">
						<Button.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedLeft">
								<MenuItem Header="{DynamicResource Lang.Common.Rename}" InputGesture="F2" Command="{Binding RenameAgentChatCommand}"/>
								<MenuItem Header="{DynamicResource Lang.Chat.CopyConversation}" Command="{Binding CopyAgentChatCommand}"/>
								<Separator/>
								<MenuItem Header="{DynamicResource Lang.Common.Delete}" Command="{Binding DeleteAgentChatCommand}"/>
							</MenuFlyout>
						</Button.Flyout>
						<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconMore}" StrokeThickness="3" Stretch="None"/></Viewbox>
					</Button>
				</StackPanel>
				<!-- Status: nothing while the agent is ready; a dot and text otherwise. "Set up a model" is
				     warning-colored and opens Settings; in command mode a click pauses or resumes the loop. -->
				<Button Grid.Column="1"
						x:Name="HeaderStatusButton"
						Classes="HeaderStatus"
						IsVisible="{Binding ShowsHeaderStatus}"
						Command="{Binding HeaderStatusCommand}"
						AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
						ToolTip.Tip="{Binding StatusToolTip}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<!-- While a turn runs the dot follows the accent preset; other states keep their status color -->
						<Ellipse Width="6" Height="6"
								 Fill="{Binding StatusColor, Mode=OneWay}"
								 IsVisible="{Binding !IsHeaderStatusWorking}"
								 VerticalAlignment="Center"/>
						<Ellipse Width="6" Height="6"
								 Fill="{DynamicResource AccentBrush}"
								 IsVisible="{Binding IsHeaderStatusWorking}"
								 VerticalAlignment="Center"/>
						<TextBlock Classes="HeaderStatusText"
								   Classes.Warning="{Binding IsHeaderStatusWarning}"
								   Text="{Binding StatusText, Mode=OneWay}"/>
					</StackPanel>
				</Button>
				<!-- The wake phrase listens locally; the pill shows only while it is listening -->
				<Panel Grid.Column="3" Classes="WakePill" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="6"
								IsVisible="{Binding VoiceState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static services:VoiceState.WakeListening}}"
								ToolTip.Tip="{DynamicResource Lang.Shell.WakeOnTip}">
						<Border Classes="StatusDot Success" VerticalAlignment="Center"/>
						<TextBlock Text="{DynamicResource Lang.Shell.WakeOn}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
					</StackPanel>
				</Panel>
				<!-- Push to talk -->
				<Button Grid.Column="4"
						x:Name="TopBarTalkButton"
						Classes="MicButton"
						Classes.listening="{Binding IsVoiceListening}"
						AutomationProperties.Name="{Binding TalkToolTip}"
						ToolTip.Tip="{Binding TalkToolTip}"
						IsEnabled="{Binding IsVoiceAvailable}"
						Command="{Binding TalkCommand}">
					<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconMic}"/></Viewbox>
				</Button>
			</Grid>
		</Border>

		<!-- ========================= -->
		<!-- CONTENT -->
		<!-- ========================= -->
		<Border Grid.Row="1" Grid.Column="1"
				Background="{DynamicResource SurfaceBgBrush}"
				ClipToBounds="True">
			<Grid>
				<!-- Tasks: task list, conversation and composer -->
				<local:TasksView x:Name="TasksPanel"
								 IsVisible="{Binding IsChatWorkbenchVisible}"/>

				<!-- Needs you: approvals waiting across all tasks -->
				<local:InboxView IsVisible="{Binding IsInboxVisible}"/>

				<!-- Page host -->
				<ContentControl Content="{Binding CurrentViewModel}"
								IsVisible="{Binding IsPageHostVisible}">
					<ContentControl.DataTemplates>
						<DataTemplate DataType="pagevm:PluginsViewModel">
							<local:PluginsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:RuntimeDiagnosticsViewModel">
							<local:RuntimeDiagnosticsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:IntegrationsViewModel">
							<local:IntegrationsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:ExtensionsViewModel">
							<local:ExtensionsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:SettingsViewModel">
							<local:SettingsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:PromptsViewModel">
							<local:PromptsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:AgentsViewModel">
							<local:AgentsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:LoopsViewModel">
							<local:LoopsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:RunsViewModel">
							<local:RunsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:GraphsViewModel">
							<local:GraphsView/>
						</DataTemplate>
					</ContentControl.DataTemplates>
				</ContentControl>
			</Grid>
		</Border>

		<!-- Command palette (Ctrl+K): over everything, closed by default -->
		<controls:CommandPalette Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
							  DataContext="{Binding CommandPalette}"/>
	</Grid>
</Window>
