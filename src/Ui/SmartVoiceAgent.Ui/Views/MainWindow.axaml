<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels"
		xmlns:pagevm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
		xmlns:local="clr-namespace:SmartVoiceAgent.Ui.Views"
		xmlns:services="clr-namespace:SmartVoiceAgent.Ui.Services"
		xmlns:converters="clr-namespace:SmartVoiceAgent.Ui.Converters"
		xmlns:controls="using:SmartVoiceAgent.Ui.Controls"
		x:Class="SmartVoiceAgent.Ui.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Background="{DynamicResource PanelBgBrush}"
		Foreground="{DynamicResource TextPrimaryBrush}"
		FontSize="13"
		TransparencyLevelHint="Mica"
		ExtendClientAreaToDecorationsHint="True"
		Title=""
		Icon="/Assets/favicon.ico"
		Width="1360" Height="860"
		MinWidth="800" MinHeight="600">

	<Window.Resources>
		<converters:LogPanelWidthConverter x:Key="LogPanelWidthConverter" />
	</Window.Resources>

	<Window.Styles>
		<!-- ========================= -->
		<!-- SIDEBAR NAVIGATION -->
		<!-- ========================= -->

		<Style Selector="Border.Sidebar">
			<Setter Property="Width" Value="232"/>
			<Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact">
			<Setter Property="Width" Value="68"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact TextBlock.NavLabel">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Holds labels that bind IsVisible themselves, such as the theme toggle's -->
		<Style Selector="Border.Sidebar.Compact Panel.NavLabelGroup">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<Style Selector="Button.NavBtn">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Margin" Value="0,1"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.NavBtn /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn:pointerover Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn TextBlock.NavLabel">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.NavBtn.Active TextBlock.NavLabel">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<!-- ========================= -->
		<!-- ACTIVITY PANEL -->
		<!-- ========================= -->

		<Style Selector="Border.ActivityLogItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Padding" Value="4,10"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="Border.ActivityLogItem:pointerover">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
		</Style>

		<Style Selector="TextBlock.ActivityMeta">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>

		<Style Selector="TextBlock.ActivityMessage">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="LineHeight" Value="18"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<!-- Segmented control used for the activity drawer tabs -->
		<Style Selector="Border.Segmented">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="3"/>
		</Style>

		<Style Selector="Button.DrawerTab">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.DrawerTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Button.DrawerTab.Selected">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<Style Selector="Button.DrawerTab.Selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BoxShadow" Value="0 1 2 0 #1F000000"/>
		</Style>

		<!-- ========================= -->
		<!-- SLASH COMMAND PALETTE -->
		<!-- ========================= -->

		<Style Selector="Button.SlashCommandItem">
			<Setter Property="MinHeight" Value="36"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SlashCommandItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:focus /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<!-- ========================= -->
		<!-- CHAT WORKBENCH -->
		<!-- ========================= -->

		<Style Selector="Border.AttachmentChip">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="Margin" Value="0,0,6,6"/>
		</Style>

		<Style Selector="Border.QueuedMessageStrip">
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,4,4,4"/>
		</Style>

		<Style Selector="Button.ChatSessionItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,0,2"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.ChatSessionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
		</Style>

		<Style Selector="Border.ChatSessionChrome">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,9"/>
		</Style>

		<!-- Row menu shows on hover, in place of the time -->
		<Style Selector="Button.ChatRowMenu">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Panel.ChatSessionRow:pointerover Button.ChatRowMenu, Button.ChatRowMenu:flyout-open, Button.ChatRowMenu:focus-visible">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="Panel.ChatSessionRow:pointerover TextBlock.ChatRowTime">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Border.ChatSessionEditor">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="Margin" Value="0,0,0,2"/>
			<Setter Property="Padding" Value="8"/>
		</Style>

		<Style Selector="TextBox.ChatRenameInput">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>

		<Style Selector="Button.ChatRowAction">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<Style Selector="TextBox.ChatSearch">
			<Setter Property="MinHeight" Value="32"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<!-- Copy buttons under messages show on hover -->
		<Style Selector="Button.MessageAction">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Border.ChatMessage:pointerover Button.MessageAction, Button.MessageAction:focus-visible">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="ComboBox.ModelPicker">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="MaxWidth" Value="360"/>
			<Setter Property="Padding" Value="10,2,6,2"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Transparent, so hovering anywhere in a message shows its copy button -->
		<Style Selector="Border.ChatMessage">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,0,22"/>
		</Style>

		<Style Selector="Border.UserBubble">
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="CornerRadius" Value="14,14,4,14"/>
			<Setter Property="Padding" Value="14,10"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="MaxWidth" Value="560"/>
		</Style>

		<Style Selector="Border.AgentAvatar">
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Background" Value="{DynamicResource BrandGradientBrush}"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
		</Style>

		<Style Selector="Border.ToolStep">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="Margin" Value="40,-10,0,0"/>
		</Style>

		<Style Selector="Border.ToolStep.Approval">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentOrangeBrush}"/>
			<Setter Property="BoxShadow" Value="0 6 18 0 #14000000"/>
		</Style>

		<Style Selector="Border.ToolGlyph">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Border.ToolArguments">
			<Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,7"/>
		</Style>

		<Style Selector="ComboBox.ApprovalModePicker">
			<Setter Property="MinHeight" Value="26"/>
			<Setter Property="Padding" Value="10,2,6,2"/>
			<Setter Property="CornerRadius" Value="13"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Ellipse.WorkingDot">
			<Style.Animations>
				<Animation Duration="0:0:1.2" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
					<KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<Style Selector="Button.SuggestionCard">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="14,12"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SuggestionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>

		<Style Selector="Border.ComposerSurface">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="14,12,10,10"/>
			<Setter Property="BoxShadow" Value="0 8 24 0 #14000000"/>
		</Style>

		<!-- Composer inputs render without their own chrome; the surrounding surface provides it -->
		<Style Selector="TextBox.BareInput">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SendButton">
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="16"/>
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SendButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentStrongHoverBrush}"/>
		</Style>

		<Style Selector="Button.SendButton Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}"/>
			<Setter Property="StrokeThickness" Value="2.5"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="44,*">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ========================= -->
		<!-- SIDEBAR -->
		<!-- ========================= -->
		<Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
				Classes="Sidebar"
				Classes.Compact="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsCompact}"
				PointerPressed="OnHeaderPointerPressed">
			<Grid RowDefinitions="Auto,*,Auto" Margin="12,12,12,14">

				<!-- Brand -->
				<Button Grid.Row="0"
						Classes="NavBtn"
						Height="44"
						Padding="4,0"
						Margin="0,0,0,18"
						Command="{Binding NavigateToCoordinatorCommand}"
						ToolTip.Tip="Kam">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Border Width="30" Height="30"
								CornerRadius="9"
								Background="{DynamicResource BrandGradientBrush}">
							<Viewbox Width="18" Height="18">
								<Path Classes="Icon"
									  Data="{StaticResource IconBrandWave}"
									  Stroke="White"
									  StrokeThickness="2.6"/>
							</Viewbox>
						</Border>
						<StackPanel VerticalAlignment="Center" Spacing="0">
							<TextBlock Classes="NavLabel"
									   Text="Kam"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Classes="NavLabel"
									   Text="{DynamicResource Lang.Shell.Brand.Tagline}"
									   FontSize="11"
									   FontWeight="Normal"
									   Foreground="{DynamicResource TextMutedBrush}"/>
						</StackPanel>
					</StackPanel>
				</Button>

				<!-- Primary navigation -->
				<StackPanel Grid.Row="1" VerticalAlignment="Top">
					<TextBlock Classes="NavLabel Overline"
							   Text="{DynamicResource Lang.Shell.Nav.Workspace}"
							   Margin="10,0,0,8"/>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Coordinator}}"
							Command="{Binding NavigateToCoordinatorCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Workbench}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Viewbox Width="18" Height="18"><Path Classes="Icon" Data="{StaticResource IconChat}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Workbench}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Diagnostics}}"
							Command="{Binding NavigateToDiagnosticsCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.DiagnosticsTip}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Viewbox Width="18" Height="18"><Path Classes="Icon" Data="{StaticResource IconActivity}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Diagnostics}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Plugins}}"
							Command="{Binding NavigateToPluginsCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Skills}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Viewbox Width="18" Height="18"><Path Classes="Icon" Data="{StaticResource IconBlocks}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Skills}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Extensions}}"
							Command="{Binding NavigateToExtensionsCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Extensions}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Viewbox Width="18" Height="18"><Path Classes="Icon" Data="{StaticResource IconPuzzle}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Extensions}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Integrations}}"
							Command="{Binding NavigateToIntegrationsCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Integrations}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Viewbox Width="18" Height="18"><Path Classes="Icon" Data="{StaticResource IconPlug}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Integrations}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Settings}}"
							Command="{Binding NavigateToSettingsCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Settings}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Viewbox Width="18" Height="18"><Path Classes="Icon" Data="{StaticResource IconSliders}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Settings}"/>
						</StackPanel>
					</Button>
				</StackPanel>

				<!-- Bottom navigation: theme toggle -->
				<StackPanel Grid.Row="2" Classes="SidebarFooter" Spacing="4">
					<Button Classes="NavBtn"
							Command="{Binding ToggleThemeCommand}"
							ToolTip.Tip="{DynamicResource Lang.Shell.ToggleTheme}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Panel Width="18" Height="18">
								<Viewbox IsVisible="{Binding IsDarkMode}"><Path Classes="Icon" Data="{StaticResource IconSun}"/></Viewbox>
								<Viewbox IsVisible="{Binding !IsDarkMode}"><Path Classes="Icon" Data="{StaticResource IconMoon}"/></Viewbox>
							</Panel>
							<!-- Names the theme a click switches to, in the interface language -->
							<Panel Classes="NavLabelGroup" VerticalAlignment="Center">
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.LightMode}" IsVisible="{Binding IsDarkMode}"/>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.DarkMode}" IsVisible="{Binding !IsDarkMode}"/>
							</Panel>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ========================= -->
		<!-- TITLE BAR (draggable) -->
		<!-- ========================= -->
		<Border Grid.Row="0" Grid.Column="1"
				Background="Transparent"
				PointerPressed="OnHeaderPointerPressed">
			<Grid ColumnDefinitions="Auto,Auto,*"
				  ColumnSpacing="12"
				  Margin="20,0,150,0">
				<TextBlock Grid.Column="0"
						   Text="{Binding ActivePageTitle}"
						   FontSize="13"
						   FontWeight="SemiBold"
						   Foreground="{DynamicResource TextPrimaryBrush}"
						   VerticalAlignment="Center"/>
				<Border Grid.Column="1" Classes="Pill">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<Ellipse Width="6" Height="6"
								 Fill="{Binding StatusColor, Mode=OneWay}"
								 VerticalAlignment="Center"/>
						<TextBlock Text="{Binding StatusText, Mode=OneWay}"
								   Foreground="{DynamicResource TextSecondaryBrush}"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- ========================= -->
		<!-- CONTENT + ACTIVITY (inset surface) -->
		<!-- ========================= -->
		<Border Grid.Row="1" Grid.Column="1"
				Background="{DynamicResource SurfaceBgBrush}"
				BorderBrush="{DynamicResource BorderSubtleBrush}"
				BorderThickness="1,1,0,0"
				CornerRadius="12,0,0,0"
				ClipToBounds="True">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsLogPanelVisible, Converter={StaticResource LogPanelWidthConverter}}"/>
				</Grid.ColumnDefinitions>

				<!-- Chat workbench -->
				<Grid Grid.Column="0"
					  ColumnDefinitions="260,*"
					  IsVisible="{Binding IsChatWorkbenchVisible}">

					<!-- Thread list -->
					<Border Grid.Column="0"
							BorderBrush="{DynamicResource BorderSubtleBrush}"
							BorderThickness="0,0,1,0"
							Padding="12,16,12,12">
						<Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
							<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0">
								<StackPanel Spacing="1">
									<TextBlock Text="{DynamicResource Lang.Chat.Threads.Title}" Classes="SectionTitle"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Threads.Subtitle}" Classes="Caption"/>
								</StackPanel>
								<Border Grid.Column="1" Classes="Pill">
									<TextBlock Text="{Binding AgentChatSessionCountText}"/>
								</Border>
							</Grid>

							<Button Grid.Row="1"
									Classes="PrimaryAction"
									HorizontalAlignment="Stretch"
									ToolTip.Tip="{DynamicResource Lang.Chat.NewChatTip}"
									Command="{Binding NewAgentChatCommand}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconPlus}" Stroke="{DynamicResource AccentOnBrush}" StrokeThickness="2.5"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.NewTask}" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<!-- Search: matches titles and the last message -->
							<TextBox Grid.Row="2"
									 x:Name="ChatSearchInput"
									 Classes="ChatSearch"
									 PlaceholderText="{DynamicResource Lang.Chat.Search.Placeholder}"
									 Text="{Binding AgentChatSearchText, Mode=TwoWay}"
									 KeyDown="OnChatSearchKeyDown">
								<TextBox.InnerLeftContent>
									<Viewbox Width="13" Height="13" Margin="10,0,0,0" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
								</TextBox.InnerLeftContent>
								<TextBox.InnerRightContent>
									<Button Classes="IconButton CompactIconButton"
											Margin="0,0,4,0"
											Background="Transparent"
											BorderThickness="0"
											ToolTip.Tip="{DynamicResource Lang.Chat.Search.Clear}"
											IsVisible="{Binding IsAgentChatSearchActive}"
											Command="{Binding ClearAgentChatSearchCommand}">
										<Viewbox Width="11" Height="11"><Path Classes="Icon" Data="{StaticResource IconX}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
									</Button>
								</TextBox.InnerRightContent>
							</TextBox>

							<Panel Grid.Row="3">
								<ScrollViewer VerticalScrollBarVisibility="Auto"
											  HorizontalScrollBarVisibility="Disabled">
									<ItemsControl x:Name="ChatThreadList" ItemsSource="{Binding AgentChatSessions}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="vm:AgentChatSessionViewModel">
												<Panel Classes="ChatSessionRow" IsVisible="{Binding IsVisibleInList}">
													<Button Classes="ChatSessionItem"
															IsVisible="{Binding IsShowingSummary}"
															Command="{Binding $parent[Window].DataContext.SelectAgentChatCommand}"
															CommandParameter="{Binding}">
														<Button.ContextMenu>
															<ContextMenu>
																<MenuItem Header="{DynamicResource Lang.Common.Rename}" InputGesture="F2" Click="OnRenameChatClick"/>
																<MenuItem Header="{DynamicResource Lang.Common.Delete}" IsEnabled="{Binding CanDelete}" Click="OnDeleteChatClick"/>
															</ContextMenu>
														</Button.ContextMenu>
														<Border Classes="ChatSessionChrome"
																Background="{Binding IsSelected, Converter={StaticResource BoolToStatusBrushConverter}, ConverterParameter='AccentSubtleBrush|TransparentBrush'}">
															<Grid RowDefinitions="Auto,Auto,Auto"
																  ColumnDefinitions="*,Auto"
																  RowSpacing="3"
																  ColumnSpacing="8">
																<TextBlock Grid.Row="0" Grid.Column="0"
																		   Text="{Binding Title}"
																		   FontSize="13"
																		   FontWeight="SemiBold"
																		   Foreground="{DynamicResource TextPrimaryBrush}"
																		   TextTrimming="CharacterEllipsis"/>
																<TextBlock Grid.Row="0" Grid.Column="1"
																		   Classes="ChatRowTime"
																		   Text="{Binding RelativeTimeText}"
																		   FontSize="11"
																		   Foreground="{DynamicResource TextMutedBrush}"/>
																<TextBlock Grid.Row="1" Grid.ColumnSpan="2"
																		   Text="{Binding Summary}"
																		   FontSize="12"
																		   Foreground="{DynamicResource TextMutedBrush}"
																		   TextTrimming="CharacterEllipsis"/>
																<StackPanel Grid.Row="2" Grid.ColumnSpan="2"
																			Orientation="Horizontal"
																			Spacing="6"
																			Margin="0,3,0,0">
																	<TextBlock Text="{Binding AgentName}"
																			   FontSize="11"
																			   Foreground="{DynamicResource TextSecondaryBrush}"/>
																	<TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
																	<TextBlock Text="{Binding StatusText}"
																			   FontSize="11"
																			   FontWeight="SemiBold"
																			   Foreground="{DynamicResource AccentBrush}"/>
																	<TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
																	<TextBlock Text="{Binding MessageCountText}"
																			   FontSize="11"
																			   Foreground="{DynamicResource TextMutedBrush}"/>
																</StackPanel>
															</Grid>
														</Border>
													</Button>

													<!-- Row menu; shown on hover in place of the time -->
													<Button Classes="IconButton CompactIconButton ChatRowMenu"
															IsVisible="{Binding IsShowingSummary}"
															HorizontalAlignment="Right"
															VerticalAlignment="Top"
															Margin="0,6,6,0"
															Background="Transparent"
															BorderThickness="0"
															ToolTip.Tip="{DynamicResource Lang.Chat.Options}">
														<Button.Flyout>
															<MenuFlyout Placement="BottomEdgeAlignedRight">
																<MenuItem Header="{DynamicResource Lang.Common.Rename}" InputGesture="F2" Click="OnRenameChatClick"/>
																<MenuItem Header="{DynamicResource Lang.Common.Delete}" IsEnabled="{Binding CanDelete}" Click="OnDeleteChatClick"/>
															</MenuFlyout>
														</Button.Flyout>
														<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconMore}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="3" Stretch="None"/></Viewbox>
													</Button>

													<!-- Rename: Enter saves, Esc cancels -->
													<Border Classes="ChatSessionChrome ChatSessionEditor"
															IsVisible="{Binding IsRenaming}"
															PropertyChanged="OnRenameEditorPropertyChanged">
														<TextBox Classes="ChatRenameInput"
																 Text="{Binding EditTitle, Mode=TwoWay}"
																 MaxLength="120"
																 KeyDown="OnRenameKeyDown"
																 LostFocus="OnRenameLostFocus"/>
													</Border>

													<!-- Delete confirmation -->
													<Border Classes="ChatSessionChrome ChatSessionEditor"
															IsVisible="{Binding IsConfirmingDelete}">
														<StackPanel Spacing="8">
															<StackPanel Spacing="2">
																<TextBlock Text="{DynamicResource Lang.Chat.DeleteConfirm.Title}"
																		   FontSize="13"
																		   FontWeight="SemiBold"
																		   Foreground="{DynamicResource TextPrimaryBrush}"/>
																<TextBlock Text="{DynamicResource Lang.Chat.DeleteConfirm.Body}"
																		   Classes="Caption"
																		   TextWrapping="Wrap"/>
															</StackPanel>
															<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
																<Button Classes="SecondaryAction ChatRowAction"
																		Content="{DynamicResource Lang.Common.Cancel}"
																		Command="{Binding $parent[Window].DataContext.CancelDeleteAgentChatCommand}"
																		CommandParameter="{Binding}"/>
																<Button Classes="DestructiveAction ChatRowAction"
																		Content="{DynamicResource Lang.Common.Delete}"
																		Command="{Binding $parent[Window].DataContext.ConfirmDeleteAgentChatCommand}"
																		CommandParameter="{Binding}"/>
															</StackPanel>
														</StackPanel>
													</Border>
												</Panel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>

								<TextBlock Text="{DynamicResource Lang.Chat.Search.NoResults}"
										   Classes="Caption"
										   HorizontalAlignment="Center"
										   Margin="0,16,0,0"
										   IsVisible="{Binding HasNoAgentChatSearchResults}"/>
							</Panel>
						</Grid>
					</Border>

					<!-- Conversation -->
					<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
						<Border Grid.Row="0"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="24,14">
							<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="{Binding SelectedAgentChatSession.Title}"
											   Classes="SectionTitle"
											   TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Timeline}" Classes="Caption"/>
								</StackPanel>
								<Border Grid.Column="1" Classes="Pill" VerticalAlignment="Center">
									<TextBlock Text="{Binding SelectedAgentChatMessageCountText}"/>
								</Border>

								<!-- Model for this chat; "Settings default" follows the model chosen in Settings -->
								<ComboBox Grid.Column="2"
										  Classes="ModelPicker"
										  ItemsSource="{Binding AgentChatModelOptions}"
										  SelectedItem="{Binding SelectedAgentChatModel, Mode=TwoWay}"
										  IsVisible="{Binding IsAgentRuntimeEnabled}"
										  ToolTip.Tip="{Binding AgentChatModelTip}">
									<ComboBox.ItemTemplate>
										<DataTemplate DataType="vm:AgentChatModelOption">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<Viewbox Width="12" Height="12" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
												<TextBlock Text="{Binding Label}"
														   FontSize="12"
														   MaxWidth="220"
														   TextTrimming="CharacterEllipsis"
														   VerticalAlignment="Center"/>
												<TextBlock Text="{Binding Caption}"
														   FontSize="11"
														   Foreground="{DynamicResource TextMutedBrush}"
														   VerticalAlignment="Center"/>
											</StackPanel>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>

								<Button Grid.Column="3"
										Classes="IconButton"
										Width="30" Height="30"
										CornerRadius="8"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										ToolTip.Tip="{DynamicResource Lang.Chat.Options}">
									<Button.Flyout>
										<MenuFlyout Placement="BottomEdgeAlignedRight">
											<MenuItem Header="{DynamicResource Lang.Common.Rename}" InputGesture="F2" Click="OnRenameChatClick"/>
											<MenuItem Header="{DynamicResource Lang.Chat.CopyConversation}" Command="{Binding CopyAgentChatCommand}"/>
											<Separator/>
											<MenuItem Header="{DynamicResource Lang.Common.Delete}" Click="OnDeleteChatClick"/>
										</MenuFlyout>
									</Button.Flyout>
									<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconMore}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="3" Stretch="None"/></Viewbox>
								</Button>
							</Grid>
						</Border>

						<ScrollViewer Grid.Row="1"
									  x:Name="ChatScrollViewer"
									  VerticalScrollBarVisibility="Auto"
									  HorizontalScrollBarVisibility="Disabled">
							<Grid MaxWidth="820" Margin="32,28,32,12">
								<!-- Empty state -->
								<StackPanel Spacing="22"
											VerticalAlignment="Center"
											Margin="0,48,0,0"
											IsVisible="{Binding !HasAgentChatMessages}">
									<Border Width="48" Height="48"
											CornerRadius="14"
											HorizontalAlignment="Center"
											Background="{DynamicResource BrandGradientBrush}">
										<Viewbox Width="24" Height="24"><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="White"/></Viewbox>
									</Border>
									<StackPanel Spacing="6" HorizontalAlignment="Center">
										<TextBlock Text="{DynamicResource Lang.Chat.Empty.Title}"
												   FontSize="22"
												   FontWeight="SemiBold"
												   LetterSpacing="-0.3"
												   HorizontalAlignment="Center"
												   Foreground="{DynamicResource TextPrimaryBrush}"/>
										<TextBlock Text="{DynamicResource Lang.Chat.Empty.Body}"
												   Classes="Caption"
												   FontSize="13"
												   TextAlignment="Center"
												   HorizontalAlignment="Center"/>
									</StackPanel>
									<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
										<Button Grid.Column="0"
												Classes="SuggestionCard"
												Command="{Binding UseComposerSuggestionCommand}"
												CommandParameter="{DynamicResource Lang.Chat.Suggestion.Review.Prompt}">
											<StackPanel Spacing="6">
												<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
												<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Review.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
												<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Review.Caption}" Classes="Caption"/>
											</StackPanel>
										</Button>
										<Button Grid.Column="1"
												Classes="SuggestionCard"
												Command="{Binding UseComposerSuggestionCommand}"
												CommandParameter="{DynamicResource Lang.Chat.Suggestion.Tests.Prompt}">
											<StackPanel Spacing="6">
												<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
												<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Tests.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
												<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Tests.Caption}" Classes="Caption"/>
											</StackPanel>
										</Button>
										<Button Grid.Column="2"
												Classes="SuggestionCard"
												Command="{Binding UseComposerSuggestionCommand}"
												CommandParameter="{DynamicResource Lang.Chat.Suggestion.Plan.Prompt}">
											<StackPanel Spacing="6">
												<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
												<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Plan.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
												<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Plan.Caption}" Classes="Caption"/>
											</StackPanel>
										</Button>
									</Grid>
								</StackPanel>

								<!-- Messages; virtualized, so a long thread only builds the rows on screen -->
								<StackPanel IsVisible="{Binding HasAgentChatMessages}">
								<ItemsControl x:Name="ChatMessageList" ItemsSource="{Binding SelectedAgentChatSession.Messages}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:AgentChatMessageViewModel">
											<Border Classes="ChatMessage">
												<Panel>
													<!-- Outgoing (user) -->
													<StackPanel Spacing="4"
																HorizontalAlignment="Right"
																IsVisible="{Binding IsUser}">
														<Border Classes="UserBubble">
															<SelectableTextBlock Text="{Binding Content}"
																				 FontSize="14"
																				 LineHeight="22"
																				 Foreground="{DynamicResource TextPrimaryBrush}"
																				 TextWrapping="Wrap"/>
														</Border>
														<StackPanel Orientation="Horizontal"
																	Spacing="4"
																	HorizontalAlignment="Right">
															<Button Classes="IconButton CompactIconButton MessageAction"
																	Background="Transparent"
																	BorderThickness="0"
																	ToolTip.Tip="{DynamicResource Lang.Chat.Message.Copy}"
																	Command="{Binding $parent[Window].DataContext.CopyAgentMessageCommand}"
																	CommandParameter="{Binding}">
																<Panel>
																	<Viewbox Width="12" Height="12" IsVisible="{Binding !IsCopied}"><Path Classes="Icon" Data="{StaticResource IconCopy}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
																	<Viewbox Width="12" Height="12" IsVisible="{Binding IsCopied}"><Path Classes="Icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
																</Panel>
															</Button>
															<TextBlock Text="{Binding TimeText}"
																	   FontSize="11"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   VerticalAlignment="Center"/>
														</StackPanel>
													</StackPanel>

													<!-- Incoming (agent / system) -->
													<Grid ColumnDefinitions="Auto,*"
														  ColumnSpacing="12"
														  IsVisible="{Binding IsAgent}">
														<Border Grid.Column="0" Classes="AgentAvatar">
															<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="White"/></Viewbox>
														</Border>
														<StackPanel Grid.Column="1" Spacing="4">
															<StackPanel Orientation="Horizontal" Spacing="8">
																<TextBlock Text="{Binding Role}"
																		   FontSize="13"
																		   FontWeight="SemiBold"
																		   Foreground="{DynamicResource TextPrimaryBrush}"/>
																<TextBlock Text="{Binding TimeText}"
																		   FontSize="11"
																		   Foreground="{DynamicResource TextMutedBrush}"
																		   VerticalAlignment="Center"/>
															</StackPanel>
															<controls:MarkdownView Markdown="{Binding Content}"/>
															<StackPanel Orientation="Horizontal"
																		Spacing="2"
																		Margin="-4,0,0,-12"
																		IsVisible="{Binding !IsStreaming}">
																<Button Classes="IconButton CompactIconButton MessageAction"
																		Background="Transparent"
																		BorderThickness="0"
																		ToolTip.Tip="{DynamicResource Lang.Chat.Message.Copy}"
																		Command="{Binding $parent[Window].DataContext.CopyAgentMessageCommand}"
																		CommandParameter="{Binding}">
																	<Panel>
																		<Viewbox Width="13" Height="13" IsVisible="{Binding !IsCopied}"><Path Classes="Icon" Data="{StaticResource IconCopy}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
																		<Viewbox Width="13" Height="13" IsVisible="{Binding IsCopied}"><Path Classes="Icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
																	</Panel>
																</Button>
															</StackPanel>
														</StackPanel>
													</Grid>

													<!-- Tool step, with an approval card while it waits -->
													<Border Classes="ToolStep"
															Classes.Approval="{Binding IsAwaitingApproval}"
															IsVisible="{Binding IsToolStep}">
														<StackPanel Spacing="8">
															<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
																<Border Grid.Column="0" Classes="ToolGlyph">
																	<Viewbox Width="13" Height="13"><Path Classes="Icon" Data="{StaticResource IconWrench}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
																</Border>
																<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
																	<TextBlock Text="{Binding ToolDisplayName}"
																			   FontSize="13"
																			   FontWeight="SemiBold"
																			   Foreground="{DynamicResource TextPrimaryBrush}"
																			   TextTrimming="CharacterEllipsis"/>
																	<StackPanel Orientation="Horizontal" Spacing="6">
																		<TextBlock Text="{Binding ToolName}"
																				   FontSize="11"
																				   FontFamily="{StaticResource MonoFontFamily}"
																				   Foreground="{DynamicResource TextMutedBrush}"/>
																		<TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
																		<TextBlock Text="{Binding RiskText}"
																				   FontSize="11"
																				   Foreground="{DynamicResource TextMutedBrush}"/>
																	</StackPanel>
																</StackPanel>
																<Border Grid.Column="2"
																		Classes="Pill"
																		Classes.Accent="{Binding IsToolRunning}"
																		Classes.Warning="{Binding IsAwaitingApproval}"
																		Classes.Success="{Binding IsToolSucceeded}"
																		Classes.Danger="{Binding IsToolFailed}"
																		VerticalAlignment="Center">
																	<TextBlock Text="{Binding ToolStatusText}"/>
																</Border>
															</Grid>

															<Border Classes="ToolArguments" IsVisible="{Binding HasArguments}">
																<SelectableTextBlock Text="{Binding ArgumentsPreview}"
																					 FontSize="12"
																					 FontFamily="{StaticResource MonoFontFamily}"
																					 Foreground="{DynamicResource TextSecondaryBrush}"
																					 TextWrapping="Wrap"/>
															</Border>

															<SelectableTextBlock Text="{Binding ToolSummary}"
																				 IsVisible="{Binding HasToolSummary}"
																				 FontSize="12"
																				 Foreground="{DynamicResource TextMutedBrush}"
																				 TextWrapping="Wrap"/>

															<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
																  ColumnSpacing="8"
																  IsVisible="{Binding IsAwaitingApproval}">
																<Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentOrangeBrush}"/></Viewbox>
																<TextBlock Grid.Column="1"
																		   Text="{DynamicResource Lang.Chat.Tool.RunPrompt}"
																		   FontSize="12"
																		   FontWeight="SemiBold"
																		   Foreground="{DynamicResource TextPrimaryBrush}"
																		   VerticalAlignment="Center"/>
																<Button Grid.Column="2"
																		Classes="SecondaryAction"
																		Content="{DynamicResource Lang.Common.Deny}"
																		Command="{Binding $parent[Window].DataContext.DenyToolCallCommand}"
																		CommandParameter="{Binding}"/>
																<Button Grid.Column="3"
																		Classes="SecondaryAction"
																		Content="{DynamicResource Lang.Common.AlwaysAllow}"
																		ToolTip.Tip="{Binding AlwaysAllowHint}"
																		Command="{Binding $parent[Window].DataContext.AlwaysAllowToolCallCommand}"
																		CommandParameter="{Binding}"/>
																<Button Grid.Column="4"
																		Classes="PrimaryAction"
																		Content="{DynamicResource Lang.Common.Approve}"
																		Command="{Binding $parent[Window].DataContext.ApproveToolCallCommand}"
																		CommandParameter="{Binding}"/>
															</Grid>
														</StackPanel>
													</Border>
												</Panel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<!-- Working indicator -->
								<StackPanel Orientation="Horizontal"
											Spacing="8"
											Margin="40,0,0,12"
											IsVisible="{Binding IsAgentTurnRunning}">
									<Ellipse Classes="WorkingDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Working}"
											   FontSize="12"
											   Foreground="{DynamicResource TextMutedBrush}"
											   VerticalAlignment="Center"/>
								</StackPanel>
								</StackPanel>
							</Grid>
						</ScrollViewer>

						<!-- Composer -->
						<StackPanel Grid.Row="2"
									MaxWidth="820"
									Margin="32,0,32,18"
									Spacing="8">

							<!-- Slash command palette -->
							<Border Background="{DynamicResource SurfaceBgElevatedBrush}"
									BorderBrush="{DynamicResource BorderMutedBrush}"
									BorderThickness="1"
									CornerRadius="10"
									Padding="4"
									ClipToBounds="True"
									BoxShadow="0 8 24 0 #1F000000"
									IsVisible="{Binding IsSlashCommandPaletteVisible}">
								<ItemsControl ItemsSource="{Binding SlashCommandSuggestions}"
											  HorizontalAlignment="Stretch">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:SlashCommandSuggestionViewModel">
											<Button Command="{Binding $parent[Window].DataContext.SelectSlashCommandCommand}"
													CommandParameter="{Binding}"
													Classes="SlashCommandItem"
													HorizontalAlignment="Stretch">
												<Border Background="{Binding IsSelected, Converter={StaticResource BoolToStatusBrushConverter}, ConverterParameter='CardBgHoverBrush|TransparentBrush'}"
														BorderBrush="Transparent"
														BorderThickness="0"
														CornerRadius="6"
														Padding="8,7"
														HorizontalAlignment="Stretch">
													<Grid ColumnDefinitions="Auto, *, Auto"
														  RowDefinitions="Auto, Auto"
														  RowSpacing="2">
														<Border Grid.Column="0"
																Grid.Row="0"
																Grid.RowSpan="2"
																Width="2"
																Height="24"
																Background="{DynamicResource AccentBrush}"
																CornerRadius="2"
																Opacity="{Binding IsSelected, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1|0'}"
																VerticalAlignment="Center"
																Margin="0,0,8,0"/>
														<TextBlock Grid.Column="1"
																   Grid.Row="0"
																   Text="{Binding Name}"
																   FontSize="12"
																   FontFamily="{StaticResource MonoFontFamily}"
																   FontWeight="SemiBold"
																   Foreground="{DynamicResource AccentBrush}"/>
														<TextBlock Grid.Column="2"
																   Grid.Row="0"
																   Text="{Binding Category}"
																   FontSize="11"
																   Foreground="{DynamicResource TextMutedBrush}"
																   VerticalAlignment="Center"
																   Margin="12,0,0,0"/>
														<TextBlock Grid.Column="1"
																   Grid.ColumnSpan="2"
																   Grid.Row="1"
																   Text="{Binding Summary}"
																   FontSize="12"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   TextTrimming="CharacterEllipsis"/>
													</Grid>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>

							<Border Classes="ComposerSurface">
								<Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">

									<!-- Context files -->
									<Grid Grid.Row="0"
										  RowDefinitions="Auto,Auto"
										  RowSpacing="6"
										  IsVisible="{Binding HasComposerAttachments}">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Text="{DynamicResource Lang.Chat.Composer.ContextFiles}" Classes="Overline"/>
											<Button Grid.Column="1"
													Classes="CompactAction"
													ToolTip.Tip="{DynamicResource Lang.Chat.Composer.ClearContextTip}"
													Command="{Binding ClearComposerAttachmentsCommand}">
												<TextBlock Text="{DynamicResource Lang.Chat.Composer.ClearContext}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
											</Button>
										</Grid>
										<ItemsControl Grid.Row="1" ItemsSource="{Binding ComposerAttachments}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate DataType="vm:ComposerAttachmentViewModel">
													<Border Classes="AttachmentChip">
														<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
															<Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
															<StackPanel Grid.Column="1" Spacing="1" MinWidth="0">
																<TextBlock Text="{Binding FileName}"
																		   FontSize="12"
																		   FontWeight="SemiBold"
																		   Foreground="{DynamicResource TextPrimaryBrush}"
																		   TextTrimming="CharacterEllipsis"/>
																<TextBlock Text="{Binding DisplayPath}"
																		   FontSize="11"
																		   Foreground="{DynamicResource TextMutedBrush}"
																		   TextTrimming="CharacterEllipsis"/>
															</StackPanel>
															<Button Grid.Column="2"
																	Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderThickness="0"
																	ToolTip.Tip="{DynamicResource Lang.Chat.Composer.RemoveFile}"
																	Command="{Binding $parent[Window].DataContext.RemoveComposerAttachmentCommand}"
																	CommandParameter="{Binding}">
																<Viewbox Width="12" Height="12"><Path Classes="Icon" Data="{StaticResource IconX}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
															</Button>
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>

									<!-- Messages sent while a turn runs -->
									<Border Grid.Row="1"
											Classes="QueuedMessageStrip"
											IsVisible="{Binding HasQueuedAgentMessages}">
										<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
											<Viewbox Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconClock}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
											<TextBlock Grid.Column="1"
													   Text="{Binding QueuedAgentMessagesText}"
													   FontSize="12"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   VerticalAlignment="Center"
													   TextTrimming="CharacterEllipsis"/>
											<Button Grid.Column="2"
													Classes="CompactAction"
													ToolTip.Tip="{DynamicResource Lang.Chat.Composer.ClearQueuedTip}"
													Command="{Binding ClearQueuedAgentMessagesCommand}">
												<TextBlock Text="{DynamicResource Lang.Common.Cancel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
											</Button>
										</Grid>
									</Border>

									<!-- Prompt -->
									<!-- Enter sends and Shift+Enter adds a line; MainWindow handles keys before the TextBox does -->
									<TextBox Grid.Row="2"
											 x:Name="WorkbenchPromptInput"
											 Classes="BareInput"
											 PlaceholderText="{DynamicResource Lang.Chat.Composer.Placeholder}"
											 FontSize="14"
											 Foreground="{DynamicResource TextPrimaryBrush}"
											 AcceptsReturn="True"
											 TextWrapping="Wrap"
											 MaxHeight="160"
											 Text="{Binding CommandInputText, Mode=TwoWay}"/>

									<!-- Toolbar -->
									<Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
										<Button Grid.Column="0"
												Classes="IconButton"
												Width="32" Height="32"
												CornerRadius="16"
												Background="Transparent"
												BorderThickness="0"
												ToolTip.Tip="{DynamicResource Lang.Chat.Composer.AttachFiles}"
												Click="OnAttachFilesClick">
											<Viewbox Width="17" Height="17"><Path Classes="Icon" Data="{StaticResource IconPaperclip}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
										</Button>
										<TextBlock Grid.Column="1"
												   Text="{Binding ActiveComposerContextText}"
												   FontSize="12"
												   Foreground="{DynamicResource TextMutedBrush}"
												   VerticalAlignment="Center"
												   TextTrimming="CharacterEllipsis"/>
										<ComboBox Grid.Column="2"
												  Classes="ApprovalModePicker"
												  ItemsSource="{x:Static vm:MainWindowViewModel.ApprovalModes}"
												  SelectedItem="{Binding SelectedApprovalMode}"
												  IsVisible="{Binding IsAgentRuntimeEnabled}"
												  ToolTip.Tip="{Binding SelectedApprovalMode.Description}">
											<ComboBox.ItemTemplate>
												<DataTemplate DataType="vm:ApprovalModeOption">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<Viewbox Width="12" Height="12" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource TextSecondaryBrush}"/></Viewbox>
														<TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
													</StackPanel>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
										<StackPanel Grid.Column="3"
													Orientation="Horizontal"
													Spacing="5"
													VerticalAlignment="Center"
													Margin="0,0,4,0"
													IsVisible="{Binding IsVoiceEnabled}">
											<Ellipse Width="6" Height="6" Fill="{Binding VoiceStatusColor}" VerticalAlignment="Center"/>
											<TextBlock Text="{Binding VoiceStatusText}"
													   FontSize="11"
													   Foreground="{Binding VoiceStatusColor}"
													   VerticalAlignment="Center"/>
										</StackPanel>
										<Button Grid.Column="4"
												Classes="IconButton"
												Width="32" Height="32"
												CornerRadius="16"
												Background="Transparent"
												BorderThickness="0"
												ToolTip.Tip="Toggle Voice Control"
												Command="{Binding ToggleVoiceCommand}">
											<Viewbox Width="17" Height="17"><Path Classes="Icon" Data="{StaticResource IconMic}" Stroke="{Binding VoiceStatusColor}"/></Viewbox>
										</Button>
										<Button Grid.Column="5"
												Classes="SendButton"
												ToolTip.Tip="{DynamicResource Lang.Chat.Composer.Send}"
												IsVisible="{Binding IsSendVisible}"
												Command="{Binding SubmitCommand}">
											<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconArrowUp}"/></Viewbox>
										</Button>
										<Button Grid.Column="5"
												Classes="SendButton"
												ToolTip.Tip="{DynamicResource Lang.Chat.Composer.Stop}"
												IsVisible="{Binding IsAgentTurnRunning}"
												Command="{Binding StopAgentTurnCommand}">
											<Viewbox Width="12" Height="12"><Path Classes="Icon" Data="{StaticResource IconStop}"/></Viewbox>
										</Button>
									</Grid>
								</Grid>
							</Border>

							<TextBlock Text="{DynamicResource Lang.Chat.Composer.Hint}"
									   FontSize="11"
									   Foreground="{DynamicResource TextMutedBrush}"
									   HorizontalAlignment="Center"/>
						</StackPanel>
					</Grid>
				</Grid>

				<!-- Page host -->
				<ContentControl Content="{Binding CurrentViewModel}"
								Grid.Column="0"
								IsVisible="{Binding IsPageHostVisible}">
					<ContentControl.DataTemplates>
						<DataTemplate DataType="pagevm:PluginsViewModel">
							<local:PluginsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:RuntimeDiagnosticsViewModel">
							<local:RuntimeDiagnosticsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:IntegrationsViewModel">
							<local:IntegrationsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:ExtensionsViewModel">
							<local:ExtensionsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:SettingsViewModel">
							<local:SettingsView/>
						</DataTemplate>
					</ContentControl.DataTemplates>
				</ContentControl>

				<!-- ========================= -->
				<!-- ACTIVITY PANEL -->
				<!-- ========================= -->
				<Border Grid.Column="1"
						Background="{DynamicResource PanelBgBrush}"
						BorderBrush="{DynamicResource BorderSubtleBrush}"
						BorderThickness="1,0,0,0"
						IsVisible="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsLogPanelVisible}">
					<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto">

						<!-- Activity Header -->
						<Border Grid.Row="0"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1">
							<Grid RowDefinitions="Auto,Auto"
								  RowSpacing="12"
								  Margin="16,14,16,12">
								<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
										<TextBlock Text="{DynamicResource Lang.Activity.Title}" Classes="SectionTitle"/>
										<TextBlock Text="{DynamicResource Lang.Activity.Subtitle}" Classes="Caption"/>
									</StackPanel>
									<Border Grid.Column="1" Classes="Pill Success">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<Ellipse Width="6" Height="6"
													 Fill="{DynamicResource AccentGreenBrush}"
													 VerticalAlignment="Center"/>
											<TextBlock Text="{DynamicResource Lang.Activity.Live}"/>
										</StackPanel>
									</Border>
								</Grid>
								<Border Grid.Row="1" Classes="Segmented">
									<Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
										<Button Grid.Column="0"
												Classes="DrawerTab"
												Classes.Selected="{Binding IsActivityRunsPanelVisible}"
												Content="{DynamicResource Lang.Activity.Tab.Runs}"
												Command="{Binding ShowRunsCommand}"/>
										<Button Grid.Column="1"
												Classes="DrawerTab"
												Classes.Selected="{Binding IsActivityContextPanelVisible}"
												Content="{DynamicResource Lang.Activity.Context}"
												Command="{Binding ShowContextCommand}"/>
										<Button Grid.Column="2"
												Classes="DrawerTab"
												Classes.Selected="{Binding IsActivityEventsPanelVisible}"
												Content="{DynamicResource Lang.Activity.Tab.Events}"
												Command="{Binding ShowEventsCommand}"/>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<!-- Pending Skill Confirmations -->
						<Border Grid.Row="1"
								Background="{DynamicResource CardBgHoverBrush}"
								BorderBrush="{DynamicResource AccentStrongBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding HasPendingSkillConfirmations}">
							<StackPanel Spacing="8">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Path Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"
										  Fill="{DynamicResource AccentBrush}"
										  Width="14" Height="14"
										  Stretch="Uniform"
										  VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource Lang.Activity.ApprovalNeeded}"
											   FontSize="12"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource AccentBrush}"
											   VerticalAlignment="Center"/>
								</StackPanel>

								<ItemsControl ItemsSource="{Binding PendingSkillConfirmations}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource CardBgBrush}"
													BorderBrush="{DynamicResource BorderSubtleBrush}"
													BorderThickness="1"
													CornerRadius="8"
													Padding="10"
													Margin="0,0,0,6">
												<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
													<TextBlock Grid.Row="0" Grid.Column="0"
															   Text="{Binding SkillId}"
															   Foreground="{DynamicResource TextPrimaryBrush}"
															   FontSize="12"
															   FontFamily="{StaticResource MonoFontFamily}"
															   FontWeight="SemiBold"
															   TextWrapping="Wrap"/>
													<TextBlock Grid.Row="1" Grid.Column="0"
															   Text="{Binding UserCommand}"
															   Foreground="{DynamicResource TextSecondaryBrush}"
															   FontSize="11"
															   TextWrapping="Wrap"
															   Margin="0,4,12,0"/>
													<TextBlock Grid.Row="2" Grid.Column="0"
															   Text="{Binding Reason}"
															   Foreground="{DynamicResource TextMutedBrush}"
															   FontSize="10"
															   TextWrapping="Wrap"
															   Margin="0,4,12,0"/>
													<Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
															Background="{DynamicResource CardBgHoverBrush}"
															BorderBrush="{DynamicResource BorderSubtleBrush}"
															BorderThickness="1"
															CornerRadius="6"
															Padding="8"
															Margin="0,8,0,0"
															IsVisible="{Binding HasPreview}">
														<ScrollViewer MaxHeight="180"
																	  HorizontalScrollBarVisibility="Auto"
																	  VerticalScrollBarVisibility="Auto">
															<TextBlock Text="{Binding Preview}"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   TextWrapping="NoWrap"/>
														</ScrollViewer>
													</Border>
													<StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
																Orientation="Horizontal"
																VerticalAlignment="Top"
																Spacing="6">
														<Button Classes="IconButton"
																Width="28" Height="28"
																Background="Transparent"
																BorderBrush="{DynamicResource AccentGreenBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="0"
																Cursor="Hand"
																ToolTip.Tip="{DynamicResource Lang.Common.Approve}"
																Command="{Binding ApproveCommand}">
															<Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
																  Fill="{DynamicResource AccentGreenBrush}"
																  Width="15" Height="15"
																  Stretch="Uniform"/>
														</Button>
														<Button Classes="IconButton"
																Width="28" Height="28"
																Background="Transparent"
																BorderBrush="{DynamicResource AccentErrorBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="0"
																Cursor="Hand"
																ToolTip.Tip="{DynamicResource Lang.Activity.Reject}"
																Command="{Binding RejectCommand}">
															<Path Data="M18.3,5.71L12,12L5.7,5.71L4.29,7.12L10.59,13.41L4.29,19.71L5.7,21.12L12,14.83L18.3,21.12L19.71,19.71L13.41,13.41L19.71,7.12Z"
																  Fill="{DynamicResource AccentErrorBrush}"
																  Width="14" Height="14"
																  Stretch="Uniform"/>
														</Button>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!-- Runtime Agents -->
						<Border Grid.Row="2"
								Background="Transparent"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Runs}}">
							<StackPanel Spacing="8">
								<StackPanel Orientation="Horizontal"
											Spacing="8">
									<Path Data="M12,2A7,7 0 0,1 19,9C19,11.38 17.81,13.47 16,14.74V17A1,1 0 0,1 15,18H9A1,1 0 0,1 8,17V14.74C6.19,13.47 5,11.38 5,9A7,7 0 0,1 12,2M9,20H15V22H9V20Z"
										  Fill="{DynamicResource AccentBrush}"
										  Width="14" Height="14"
										  Stretch="Uniform"
										  VerticalAlignment="Center"/>
									<TextBlock Text="{DynamicResource Lang.Activity.Runs.Title}"
											   FontSize="12"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource TextMutedBrush}"
											   VerticalAlignment="Center"/>
								</StackPanel>
								<ItemsControl ItemsSource="{Binding RuntimeAgentActivities}">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:RuntimeAgentActivityViewModel">
											<Button Command="{Binding $parent[Window].DataContext.ShowRuntimeAgentRunDetailCommand}"
													CommandParameter="{Binding}"
													Background="Transparent"
													BorderThickness="0"
													Padding="0"
													HorizontalContentAlignment="Stretch">
												<Border Background="{DynamicResource CardBgHoverBrush}"
														BorderBrush="{DynamicResource BorderSubtleBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Padding="10"
														Margin="0,0,0,6">
													<Grid ColumnDefinitions="Auto, *, Auto"
														  RowDefinitions="Auto, Auto"
														  ColumnSpacing="8">
														<Border Grid.Row="0"
																Grid.RowSpan="2"
																Width="2"
																Background="{Binding StatusBrush}"
																CornerRadius="2"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="1"
																   Text="{Binding DisplayName}"
																   FontSize="12"
																   FontWeight="SemiBold"
																   Foreground="{DynamicResource TextPrimaryBrush}"
																   TextTrimming="CharacterEllipsis"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="2"
																   Text="{Binding StatusText}"
																   FontSize="10"
																   FontWeight="SemiBold"
																   Foreground="{Binding StatusBrush}"/>
														<TextBlock Grid.Row="1"
																   Grid.Column="1"
																   Text="{Binding LastMessage}"
																   FontSize="11"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   TextTrimming="CharacterEllipsis"
																   MaxLines="1"
																   Margin="0,4,8,0"/>
														<TextBlock Grid.Row="1"
																   Grid.Column="2"
																   Text="{Binding UpdatedText}"
																   FontSize="10"
																   FontFamily="{StaticResource MonoFontFamily}"
																   Foreground="{DynamicResource TextMutedBrush}"
																   Margin="0,4,0,0"/>
													</Grid>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Text="{DynamicResource Lang.Activity.Runs.Empty}"
										   FontSize="12"
										   Foreground="{DynamicResource TextMutedBrush}"
										   Margin="2,2,0,0"
										   IsVisible="{Binding !HasRuntimeAgentActivities}"/>
								<Border Background="{DynamicResource CardBgHoverBrush}"
										BorderBrush="{DynamicResource AccentBrush}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="12"
										IsVisible="{Binding HasSelectedRuntimeAgentRun}">
									<StackPanel Spacing="8">
										<Grid ColumnDefinitions="*, Auto">
											<TextBlock Grid.Column="0"
													   Text="{DynamicResource Lang.Activity.RunDetail.Title}"
													   FontSize="12"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource TextPrimaryBrush}"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding SelectedRuntimeAgentRun.StatusText}"
													   FontSize="10"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource AccentBrush}"/>
										</Grid>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.DisplayName}"
												   FontSize="12"
												   Foreground="{DynamicResource TextPrimaryBrush}"
												   TextTrimming="CharacterEllipsis"/>
										<Grid ColumnDefinitions="Auto, *"
											  RowDefinitions="Auto, Auto"
											  ColumnSpacing="10"
											  RowSpacing="4">
											<TextBlock Grid.Row="0"
													   Grid.Column="0"
													   Text="{DynamicResource Lang.Activity.RunDetail.Model}"
													   FontSize="10"
													   Foreground="{DynamicResource TextMutedBrush}"/>
											<TextBlock Grid.Row="0"
													   Grid.Column="1"
													   Text="{Binding SelectedRuntimeAgentRun.ModelIdText}"
													   FontSize="10"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Grid.Row="1"
													   Grid.Column="0"
													   Text="{DynamicResource Lang.Activity.RunDetail.Duration}"
													   FontSize="10"
													   Foreground="{DynamicResource TextMutedBrush}"/>
											<TextBlock Grid.Row="1"
													   Grid.Column="1"
													   Text="{Binding SelectedRuntimeAgentRun.DurationText}"
													   FontSize="10"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
										</Grid>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.TaskText}"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextWrapping="Wrap"
												   MaxLines="3"/>
										<ItemsControl ItemsSource="{Binding SelectedRuntimeAgentRun.Observations}"
													  IsVisible="{Binding SelectedRuntimeAgentRun.HasObservations}">
											<ItemsControl.ItemTemplate>
												<DataTemplate DataType="vm:RuntimeAgentObservationDetailViewModel">
													<Grid ColumnDefinitions="Auto, *, Auto"
														  RowDefinitions="Auto, Auto"
														  ColumnSpacing="8"
														  Margin="0,2">
														<TextBlock Grid.Row="0"
																   Grid.Column="0"
																   Text="{DynamicResource Lang.Activity.Context}"
																   FontSize="10"
																   Foreground="{DynamicResource TextMutedBrush}"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="1"
																   Text="{Binding DisplayName}"
																   FontSize="10"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   TextTrimming="CharacterEllipsis"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="2"
																   Text="{Binding StatusText}"
																   FontSize="10"
																   Foreground="{DynamicResource TextMutedBrush}"/>
														<TextBlock Grid.Row="1"
																   Grid.Column="1"
																   Grid.ColumnSpan="2"
																   Text="{Binding SummaryText}"
																   FontSize="10"
																   Foreground="{DynamicResource TextMutedBrush}"
																   TextTrimming="CharacterEllipsis"
																   MaxLines="1"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.ResponseText}"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextWrapping="Wrap"
												   MaxLines="4"
												   IsVisible="{Binding SelectedRuntimeAgentRun.HasResponse}"/>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.ErrorText}"
												   FontSize="11"
												   Foreground="{DynamicResource AccentErrorBrush}"
												   TextWrapping="Wrap"
												   MaxLines="3"
												   IsVisible="{Binding SelectedRuntimeAgentRun.HasError}"/>
									</StackPanel>
								</Border>
							</StackPanel>
						</Border>

						<!-- Planner Trace -->
						<Border Grid.Row="3"
								Background="{DynamicResource CardBgBrush}"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Context}}">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0"
												Orientation="Horizontal"
												Spacing="8">
										<Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M7,13H9V11H7V13M11,17H13V7H11V17M15,13H17V11H15V13Z"
											  Fill="{DynamicResource TextMutedBrush}"
											  Width="14" Height="14"
											  Stretch="Uniform"
											  VerticalAlignment="Center"/>
										<TextBlock Text="{DynamicResource Lang.Activity.PlanTrace.Title}"
												   FontSize="12"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextMutedBrush}"
												   VerticalAlignment="Center"/>
									</StackPanel>
									<Button Grid.Column="1"
											Classes="IconButton CompactIconButton"
											Background="Transparent"
											BorderBrush="{DynamicResource BorderSubtleBrush}"
											BorderThickness="1"
											CornerRadius="6"
											Padding="0"
											Cursor="Hand"
											ToolTip.Tip="{DynamicResource Lang.Activity.PlanTrace.Clear}"
											Command="{Binding ClearSkillPlannerTraceCommand}">
										<Path Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"
											  Fill="{DynamicResource TextMutedBrush}"
											  Width="13" Height="13"
											  Stretch="Uniform"/>
									</Button>
								</Grid>

								<ScrollViewer MaxHeight="220"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding SkillPlannerTraces}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource CardBgHoverBrush}"
														BorderBrush="{DynamicResource BorderSubtleBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Padding="10"
														Margin="0,0,0,8">
													<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">
														<StackPanel Grid.Row="0"
																	Orientation="Horizontal"
																	Spacing="8">
															<TextBlock Text="{Binding SkillIdText}"
																	   Foreground="{DynamicResource TextPrimaryBrush}"
																	   FontSize="11"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   FontWeight="SemiBold"/>
															<TextBlock Text="{Binding StatusText}"
																	   Foreground="{DynamicResource AccentBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
															<TextBlock Text="{Binding ConfidenceText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
															<TextBlock Text="{Binding DurationText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
														</StackPanel>
														<TextBlock Grid.Row="1"
																   Text="{Binding UserRequestText}"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   FontSize="10"
																   TextWrapping="Wrap"
																   MaxLines="2"
																   Margin="0,6,0,0"/>
														<TextBlock Grid.Row="2"
																   Text="{Binding ReasoningText}"
																   Foreground="{DynamicResource TextMutedBrush}"
																   FontSize="10"
																   TextWrapping="Wrap"
																   MaxLines="2"
																   IsVisible="{Binding HasReasoning}"
																   Margin="0,4,0,0"/>
														<TextBlock Grid.Row="3"
																   Text="{Binding ErrorText}"
																   Foreground="{DynamicResource AccentErrorBrush}"
																   FontSize="10"
																   TextWrapping="Wrap"
																   MaxLines="2"
																   IsVisible="{Binding HasError}"
																   Margin="0,4,0,0"/>
														<TextBlock Grid.Row="4"
																   Text="{Binding RawResponseText}"
																   Foreground="{DynamicResource TextMutedBrush}"
																   FontSize="10"
																   FontFamily="{StaticResource MonoFontFamily}"
																   TextWrapping="Wrap"
																   MaxLines="4"
																   IsVisible="{Binding HasRawResponse}"
																   Margin="0,6,0,0"/>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>
						</Border>

						<!-- Skill Execution History -->
						<Border Grid.Row="4"
								Background="{DynamicResource CardBgBrush}"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Context}}">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0"
												Orientation="Horizontal"
												Spacing="8">
										<Path Data="M13 3C8.03 3 4 7.03 4 12H1L5 16L9 12H6C6 8.13 9.13 5 13 5C16.87 5 20 8.13 20 12C20 15.87 16.87 19 13 19C11.07 19 9.32 18.22 8.05 16.95L6.64 18.36C8.27 19.99 10.52 21 13 21C17.97 21 22 16.97 22 12C22 7.03 17.97 3 13 3M12 7V13L17 16L18 14.27L14 11.9V7H12Z"
											  Fill="{DynamicResource TextMutedBrush}"
											  Width="14" Height="14"
											  Stretch="Uniform"
											  VerticalAlignment="Center"/>
										<TextBlock Text="{DynamicResource Lang.Activity.SkillResults.Title}"
												   FontSize="12"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextMutedBrush}"
												   VerticalAlignment="Center"/>
									</StackPanel>
									<Button Grid.Column="1"
											Classes="IconButton CompactIconButton"
											Background="Transparent"
											BorderBrush="{DynamicResource BorderSubtleBrush}"
											BorderThickness="1"
											CornerRadius="6"
											Padding="0"
											Cursor="Hand"
											ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.Clear}"
											Command="{Binding ClearSkillExecutionHistoryCommand}">
										<Path Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"
											  Fill="{DynamicResource TextMutedBrush}"
											  Width="13" Height="13"
											  Stretch="Uniform"/>
									</Button>
								</Grid>

								<Grid ColumnDefinitions="*, 132, Auto"
									  RowDefinitions="Auto, Auto"
									  ColumnSpacing="8"
									  RowSpacing="6"
									  Margin="0,10,0,10">
									<TextBox Grid.Row="0" Grid.Column="0"
											 Text="{Binding SkillExecutionHistoryFilterText, Mode=TwoWay}"
											 PlaceholderText="{DynamicResource Lang.Activity.SkillResults.Filter}"
											 FontSize="11"
											 FontFamily="{StaticResource MonoFontFamily}"
											 Background="{DynamicResource CardBgBrush}"
											 BorderBrush="{DynamicResource BorderSubtleBrush}"
											 BorderThickness="1"
											 CornerRadius="6"
											 Padding="8,5"/>
									<ComboBox Grid.Row="0" Grid.Column="1"
											  ItemsSource="{Binding SkillExecutionHistoryStatusFilters}"
											  SelectedItem="{Binding SkillExecutionHistoryStatusFilter, Mode=TwoWay}"
											  Height="30"
											  FontSize="11"
											  FontFamily="{StaticResource MonoFontFamily}"
											  Background="{DynamicResource CardBgBrush}"
											  BorderBrush="{DynamicResource BorderSubtleBrush}"
											  BorderThickness="1"
											  Padding="8,3"/>
									<Button Grid.Row="0" Grid.Column="2"
											Classes="IconButton"
											Width="30" Height="30"
											Background="Transparent"
											BorderBrush="{DynamicResource BorderSubtleBrush}"
											BorderThickness="1"
											CornerRadius="6"
											Padding="0"
											Cursor="Hand"
											ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.ClearFilters}"
											Command="{Binding ClearSkillExecutionHistoryFiltersCommand}"
											IsVisible="{Binding HasSkillExecutionHistoryFilter}">
										<Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
											  Fill="{DynamicResource TextMutedBrush}"
											  Width="12" Height="12"
											  Stretch="Uniform"/>
									</Button>
									<TextBlock Grid.Row="1" Grid.ColumnSpan="3"
											   Text="{Binding SkillExecutionHistorySummaryText}"
											   Foreground="{DynamicResource TextMutedBrush}"
											   FontSize="10"
											   FontFamily="{StaticResource MonoFontFamily}"/>
								</Grid>

								<TextBlock Text="{DynamicResource Lang.Activity.SkillResults.NoMatches}"
										   Foreground="{DynamicResource TextMutedBrush}"
										   FontSize="10"
										   FontFamily="{StaticResource MonoFontFamily}"
										   Margin="0,0,0,8"
										   IsVisible="{Binding HasNoSkillExecutionHistoryMatches}"/>

								<ScrollViewer MaxHeight="280"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding SkillExecutionHistory}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource CardBgHoverBrush}"
														BorderBrush="{DynamicResource BorderSubtleBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Padding="10"
														Margin="0,0,0,8">
													<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
														  ColumnDefinitions="*, Auto">
														<TextBlock Grid.Row="0" Grid.Column="0"
																   Text="{Binding SkillId}"
																   Foreground="{DynamicResource TextPrimaryBrush}"
																   FontSize="12"
																   FontFamily="{StaticResource MonoFontFamily}"
																   FontWeight="SemiBold"
																   TextWrapping="Wrap"/>
														<StackPanel Grid.Row="0" Grid.Column="1"
																	Orientation="Horizontal"
																	Spacing="6"
																	VerticalAlignment="Top">
															<TextBlock Text="{Binding StatusText}"
																	   Foreground="{DynamicResource AccentBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   FontWeight="SemiBold"/>
															<TextBlock Text="{Binding DurationText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
														</StackPanel>
														<StackPanel Grid.Row="1" Grid.ColumnSpan="2"
																	Orientation="Horizontal"
																	Spacing="8"
																	Margin="0,4,0,0">
															<TextBlock Text="{Binding TimestampText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
															<TextBlock Text="{Binding ExitCodeText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   IsVisible="{Binding HasExitCode}"/>
															<TextBlock Text="{Binding RuntimeFlagsText}"
																	   Foreground="{DynamicResource AccentErrorBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   IsVisible="{Binding HasRuntimeFlags}"/>
														</StackPanel>
														<StackPanel Grid.Row="2" Grid.ColumnSpan="2"
																	Orientation="Horizontal"
																	Spacing="6"
																	Margin="0,8,0,0">
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource BorderSubtleBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.CopyResult}"
																	Command="{Binding CopyResultCommand}">
																<Path Data="M19,21H8A2,2 0 0,1 6,19V7H8V19H19V21M16,3H4A2,2 0 0,0 2,5V17H4V5H16V3M20,7H10A2,2 0 0,0 8,9V17A2,2 0 0,0 10,19H20A2,2 0 0,0 22,17V9A2,2 0 0,0 20,7Z"
																	  Fill="{DynamicResource TextMutedBrush}"
																	  Width="13" Height="13"
																	  Stretch="Uniform"/>
															</Button>
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource BorderSubtleBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.CopyStdOut}"
																	Command="{Binding CopyStdOutCommand}"
																	IsVisible="{Binding HasStdOut}">
																<Path Data="M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M5,7V19H19V7H5M7,9H17V11H7V9M7,13H15V15H7V13Z"
																	  Fill="{DynamicResource TextSecondaryBrush}"
																	  Width="13" Height="13"
																	  Stretch="Uniform"/>
															</Button>
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource AccentErrorBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.CopyStdErr}"
																	Command="{Binding CopyStdErrCommand}"
																	IsVisible="{Binding HasStdErr}">
																<Path Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
																	  Fill="{DynamicResource AccentErrorBrush}"
																	  Width="13" Height="13"
																	  Stretch="Uniform"/>
															</Button>
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource AccentStrongBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.Rerun}"
																	Command="{Binding RerunCommand}"
																	IsVisible="{Binding CanRerun}">
																<Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.82,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
																	  Fill="{DynamicResource AccentBrush}"
																	  Width="13" Height="13"
																	  Stretch="Uniform"/>
															</Button>
														</StackPanel>
														<TextBlock Grid.Row="3" Grid.ColumnSpan="2"
																   Text="{Binding DetailText}"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   FontSize="10"
																   FontFamily="{StaticResource MonoFontFamily}"
																   TextWrapping="Wrap"
																   MaxLines="5"
																   Margin="0,6,0,0"
																   IsVisible="{Binding HasDetailText}"/>
														<Border Grid.Row="4" Grid.ColumnSpan="2"
																Background="{DynamicResource CardBgBrush}"
																BorderBrush="{DynamicResource BorderSubtleBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="8"
																Margin="0,8,0,0"
																IsVisible="{Binding HasStdOut}">
															<ScrollViewer MaxHeight="72"
																		  HorizontalScrollBarVisibility="Auto"
																		  VerticalScrollBarVisibility="Auto">
																<TextBlock Text="{Binding StdOut}"
																		   Foreground="{DynamicResource TextSecondaryBrush}"
																		   FontSize="10"
																		   FontFamily="{StaticResource MonoFontFamily}"
																		   TextWrapping="NoWrap"/>
															</ScrollViewer>
														</Border>
														<Border Grid.Row="5" Grid.ColumnSpan="2"
																Background="{DynamicResource CardBgBrush}"
																BorderBrush="{DynamicResource AccentErrorBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="8"
																Margin="0,8,0,0"
																IsVisible="{Binding HasStdErr}">
															<ScrollViewer MaxHeight="72"
																		  HorizontalScrollBarVisibility="Auto"
																		  VerticalScrollBarVisibility="Auto">
																<TextBlock Text="{Binding StdErr}"
																		   Foreground="{DynamicResource AccentErrorBrush}"
																		   FontSize="10"
																		   FontFamily="{StaticResource MonoFontFamily}"
																		   TextWrapping="NoWrap"/>
															</ScrollViewer>
														</Border>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>
						</Border>

						<!-- Log Content -->
						<ScrollViewer x:Name="LogScrollViewer" Grid.Row="5"
									  VerticalScrollBarVisibility="Auto"
									  Margin="18,10,18,0"
									  IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Events}}">
							<ItemsControl ItemsSource="{Binding ActivityLogEntries}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="vm:ActivityLogEntryViewModel">
										<Border Classes="ActivityLogItem">
											<Grid ColumnDefinitions="Auto, *"
												  RowDefinitions="Auto, Auto"
												  ColumnSpacing="9">
												<Border Grid.Row="0"
														Grid.RowSpan="2"
														Width="2"
														Background="{Binding AccentBrush}"
														CornerRadius="2"/>
												<Grid Grid.Row="0"
													  Grid.Column="1"
													  ColumnDefinitions="Auto, Auto, *"
													  ColumnSpacing="7">
													<TextBlock Grid.Column="0"
															   Text="{Binding CategoryText}"
															   Classes="ActivityMeta"
															   Foreground="{Binding AccentBrush}"/>
													<TextBlock Grid.Column="1"
															   Text="{Binding TimeText}"
															   Classes="ActivityMeta"
															   FontFamily="{StaticResource MonoFontFamily}"/>
													<TextBlock Grid.Column="2"
															   Text="{Binding SourceText}"
															   Classes="ActivityMeta"
															   TextTrimming="CharacterEllipsis"
															   IsVisible="{Binding HasSourceText}"/>
												</Grid>
												<TextBlock Grid.Row="1"
														   Grid.Column="1"
														   Text="{Binding MessageText}"
														   Classes="ActivityMessage"
														   MaxLines="4"
														   Margin="0,4,0,0"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>

						<!-- Command prompt (shown on pages that hide the chat composer) -->
						<Border Grid.Row="6"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,1,0,0"
								Padding="14,12"
								IsVisible="{Binding IsPageHostVisible}">
							<Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="8">
								<TextBlock Grid.Row="0" Text="{DynamicResource Lang.Chat.Composer.MessageLabel}" Classes="Overline"/>

								<Border Grid.Row="1"
										Background="{DynamicResource SurfaceBgElevatedBrush}"
										BorderBrush="{DynamicResource BorderMutedBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="4"
										IsVisible="{Binding IsSlashCommandPaletteVisible}">
									<ItemsControl ItemsSource="{Binding SlashCommandSuggestions}"
												  HorizontalAlignment="Stretch">
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="vm:SlashCommandSuggestionViewModel">
												<Button Command="{Binding $parent[Window].DataContext.SelectSlashCommandCommand}"
														CommandParameter="{Binding}"
														Classes="SlashCommandItem"
														HorizontalAlignment="Stretch">
													<Border Background="{Binding IsSelected, Converter={StaticResource BoolToStatusBrushConverter}, ConverterParameter='CardBgHoverBrush|TransparentBrush'}"
															BorderBrush="Transparent"
															BorderThickness="0"
															CornerRadius="6"
															Padding="8,6"
															HorizontalAlignment="Stretch">
														<Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="2">
															<Border Grid.Column="0"
																	Grid.RowSpan="2"
																	Width="2"
																	Height="22"
																	Background="{DynamicResource AccentBrush}"
																	CornerRadius="2"
																	Opacity="{Binding IsSelected, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1|0'}"
																	VerticalAlignment="Center"
																	Margin="0,0,8,0"/>
															<TextBlock Grid.Column="1"
																	   Text="{Binding Name}"
																	   FontSize="12"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   FontWeight="SemiBold"
																	   Foreground="{DynamicResource AccentBrush}"/>
															<TextBlock Grid.Column="1"
																	   Grid.Row="1"
																	   Text="{Binding Summary}"
																	   FontSize="11"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   TextTrimming="CharacterEllipsis"/>
														</Grid>
													</Border>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Border>

								<WrapPanel Grid.Row="2" IsVisible="{Binding HasComposerAttachments}">
									<ItemsControl ItemsSource="{Binding ComposerAttachments}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="vm:ComposerAttachmentViewModel">
												<Border Classes="AttachmentChip">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<TextBlock Text="{Binding FileName}"
																   FontSize="11"
																   FontWeight="SemiBold"
																   MaxWidth="160"
																   TextTrimming="CharacterEllipsis"
																   VerticalAlignment="Center"/>
														<Button Classes="IconButton CompactIconButton"
																Background="Transparent"
																BorderThickness="0"
																ToolTip.Tip="{DynamicResource Lang.Chat.Composer.RemoveFile}"
																Command="{Binding $parent[Window].DataContext.RemoveComposerAttachmentCommand}"
																CommandParameter="{Binding}">
															<Viewbox Width="10" Height="10"><Path Classes="Icon" Data="{StaticResource IconX}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
														</Button>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</WrapPanel>

								<Border Grid.Row="3"
										Background="{DynamicResource CardBgBrush}"
										BorderBrush="{DynamicResource BorderMutedBrush}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="6,4">
									<Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="4">
										<Button Grid.Column="0"
												Classes="IconButton"
												Width="28" Height="28"
												CornerRadius="14"
												Background="Transparent"
												BorderThickness="0"
												ToolTip.Tip="{DynamicResource Lang.Chat.Composer.AttachFiles}"
												Click="OnAttachFilesClick">
											<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconPaperclip}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
										</Button>
										<TextBox Grid.Column="1"
												 x:Name="PromptInput"
												 Classes="BareInput"
												 PlaceholderText="{DynamicResource Lang.Chat.Composer.SlashPlaceholder}"
												 FontSize="13"
												 VerticalAlignment="Center"
												 AcceptsReturn="False"
												 TextWrapping="NoWrap"
												 Text="{Binding CommandInputText, Mode=TwoWay}"/>
										<Button Grid.Column="2"
												Classes="IconButton"
												Width="28" Height="28"
												CornerRadius="14"
												Background="Transparent"
												BorderThickness="0"
												ToolTip.Tip="Toggle Voice Control (Say 'Hey Kam')"
												Command="{Binding ToggleVoiceCommand}">
											<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconMic}" Stroke="{Binding VoiceStatusColor}"/></Viewbox>
										</Button>
										<Button Grid.Column="3"
												Classes="SendButton"
												Width="28" Height="28"
												CornerRadius="14"
												ToolTip.Tip="{DynamicResource Lang.Chat.Composer.Send}"
												Command="{Binding SubmitCommand}">
											<Viewbox Width="13" Height="13"><Path Classes="Icon" Data="{StaticResource IconArrowUp}"/></Viewbox>
										</Button>
									</Grid>
								</Border>
							</Grid>
						</Border>
					</Grid>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>
