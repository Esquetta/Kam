<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels"
		xmlns:pagevm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
		xmlns:local="clr-namespace:SmartVoiceAgent.Ui.Views"
		xmlns:services="clr-namespace:SmartVoiceAgent.Ui.Services"
		xmlns:converters="clr-namespace:SmartVoiceAgent.Ui.Converters"
		xmlns:controls="using:SmartVoiceAgent.Ui.Controls"
		x:Class="SmartVoiceAgent.Ui.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Background="{DynamicResource PanelBgBrush}"
		Foreground="{DynamicResource TextPrimaryBrush}"
		FontSize="13.5"
		TransparencyLevelHint="Mica"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaTitleBarHeightHint="48"
		Title="Kam"
		Icon="/Assets/favicon.ico"
		Width="1360" Height="860"
		MinWidth="640" MinHeight="560">

	<Window.Styles>
		<!-- The window keeps its name for the taskbar and Alt-Tab, but the drawn title bar would paint it
			 over the sidebar logo; Kam's own header shows the page instead. The separate full-screen
			 button goes too; maximize covers it. -->
		<Style Selector="WindowDrawnDecorations /template/ TextBlock">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<Style Selector="WindowDrawnDecorations /template/ :is(Control)#PART_FullScreenButton">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- ========================= -->
		<!-- SIDEBAR NAVIGATION -->
		<!-- ========================= -->

		<!-- Rail (Kam Studio): 232 px panel with a hairline on the right; icons only below 760 px -->
		<Style Selector="Border.Sidebar">
			<Setter Property="Width" Value="232"/>
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="0,0,1,0"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact">
			<Setter Property="Width" Value="60"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact Border.LadderBadge, Border.Sidebar.Compact Panel.LadderBadge, Border.Sidebar.Compact Button.SpendCard, Border.Sidebar.Compact Border.LadderLine">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<Style Selector="Border.Sidebar.Compact TextBlock.NavLabel">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Holds labels that bind IsVisible themselves, such as the theme toggle's -->
		<Style Selector="Border.Sidebar.Compact Panel.NavLabelGroup">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<Style Selector="Button.NavBtn">
			<Setter Property="Height" Value="32"/>
			<Setter Property="Margin" Value="0,0,0,1"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="Cursor" Value="Hand"/>
			<!-- Tips open beside the rail, so they never cover the next row -->
			<Setter Property="ToolTip.Placement" Value="Right"/>
			<Setter Property="ToolTip.HorizontalOffset" Value="8"/>
		</Style>

		<Style Selector="Button.NavBtn /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button.NavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn:pointerover Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn TextBlock.NavLabel">
			<Setter Property="FontSize" Value="13.5"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Build ladder: numbered steps on a vertical line; each row is a nav button -->
		<Style Selector="Border.LadderLine">
			<Setter Property="Width" Value="1"/>
			<Setter Property="Margin" Value="18,16,0,16"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="Background" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>
		<Style Selector="Button.LadderStep TextBlock.NavLabel">
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
		</Style>
		<Style Selector="Button.LadderStep.Active Border.LadderLevel">
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}"/>
		</Style>
		<Style Selector="Button.LadderStep.Active Border.LadderLevel TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}"/>
		</Style>
		<Style Selector="Button.NavBtn.Active TextBlock.NavLabel">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<Style Selector="Border.LadderLevel">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="CornerRadius" Value="11"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
		</Style>
		<Style Selector="Border.LadderLevel TextBlock">
			<Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
			<Setter Property="FontSize" Value="10.5"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<!-- Status badge: partial (warn) or planned (muted, dashed outline) -->
		<Style Selector="Panel.LadderBadge">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Panel.LadderBadge TextBlock">
			<Setter Property="FontSize" Value="9.5"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Margin" Value="6,1"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
		<Style Selector="Panel.LadderBadge Rectangle">
			<Setter Property="RadiusX" Value="8"/>
			<Setter Property="RadiusY" Value="8"/>
			<Setter Property="Stroke" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="StrokeThickness" Value="1"/>
			<Setter Property="StrokeDashArray" Value="3,2"/>
		</Style>
		<Style Selector="Panel.LadderBadge.Partial Rectangle">
			<Setter Property="Fill" Value="{DynamicResource AccentOrangeGlowBrush}"/>
			<Setter Property="StrokeThickness" Value="0"/>
		</Style>
		<Style Selector="Panel.LadderBadge.Partial TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
		</Style>

		<!-- Spend meter in the rail foot: Kam does not track spend yet, so it only says planned; it opens Runs -->
		<Style Selector="Button.SpendCard">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.SpendCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>

		<!-- Top bar search: looks like an input, opens the task search -->
		<Style Selector="Button.TitleSearch">
			<Setter Property="MinWidth" Value="240"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="10,0,8,0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.TitleSearch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<!-- Mic (.mic): 30 px square with a hairline; accent fill while listening -->
		<Style Selector="Button.MicButton">
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.MicButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>
		<Style Selector="Button.MicButton.listening /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}"/>
		</Style>
		<Style Selector="Button.MicButton.listening Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}"/>
		</Style>

		<!-- Below 980 px the top bar keeps only the search icon -->
		<Style Selector="Grid.TopBar.narrow Button.TitleSearch">
			<Setter Property="MinWidth" Value="0"/>
		</Style>
		<Style Selector="Grid.TopBar.narrow TextBlock.TitleSearchText, Grid.TopBar.narrow Border.Kbd, Grid.TopBar.narrow Panel.WakePill">
			<Setter Property="IsVisible" Value="False"/>
		</Style>

		<!-- Context meter in the Activity panel: thin, accent, orange near the budget -->
		<Style Selector="ProgressBar.ContextMeter">
			<Setter Property="Height" Value="6"/>
			<Setter Property="MinHeight" Value="6"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
		</Style>
		<Style Selector="ProgressBar.ContextMeter.Warning">
			<Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
		</Style>

		<!-- Count badge on a nav row, e.g. running tasks or approvals waiting -->
		<Style Selector="Border.NavCount">
			<Setter Property="Padding" Value="5,0"/>
			<Setter Property="MinWidth" Value="18"/>
			<Setter Property="MinHeight" Value="18"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.NavCount TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Border.NavCount.Neutral TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<Style Selector="Button.NavBtn.Active TextBlock.NavLabel">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<!-- ========================= -->
		<!-- ACTIVITY PANEL -->
		<!-- ========================= -->

		<Style Selector="Border.ActivityLogItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Padding" Value="4,10"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="Border.ActivityLogItem:pointerover">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
		</Style>

		<Style Selector="TextBlock.ActivityMeta">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>

		<Style Selector="TextBlock.ActivityMessage">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="LineHeight" Value="18"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<!-- ========================= -->
		<!-- SLASH COMMAND PALETTE -->
		<!-- ========================= -->

		<Style Selector="Button.SlashCommandItem">
			<Setter Property="MinHeight" Value="36"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SlashCommandItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.SlashCommandItem:focus /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<!-- ========================= -->
		<!-- CHAT WORKBENCH -->
		<!-- ========================= -->

		<Style Selector="Border.AttachmentChip">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="Margin" Value="0,0,6,6"/>
		</Style>

		<Style Selector="Border.VoiceStatusStrip">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,4,4,4"/>
			<Setter Property="MinHeight" Value="30"/>
		</Style>

		<Style Selector="Border.QueuedMessageStrip">
			<Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,4,4,4"/>
		</Style>

		<!-- Task rows (.task): full-bleed, a 2 px accent edge when selected -->
		<Style Selector="Button.ChatSessionItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.ChatSessionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
		</Style>

		<Style Selector="Border.ChatSessionChrome">
			<Setter Property="BorderThickness" Value="2,0,0,0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Padding" Value="10,9,12,9"/>
		</Style>
		<Style Selector="Border.ChatSessionChrome.Selected">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
		</Style>
		<Style Selector="Border.TaskDot">
			<Setter Property="Width" Value="7"/>
			<Setter Property="Height" Value="7"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Margin" Value="0,5,0,0"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
		</Style>
		<Style Selector="Border.TaskDot.Working">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
			<Style.Animations>
				<Animation Duration="0:0:1.4" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
					<KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		<Style Selector="Border.TaskDot.Waiting">
			<Setter Property="Background" Value="{DynamicResource AccentOrangeBrush}"/>
		</Style>

		<!-- Row menu shows on hover, in place of the time -->
		<Style Selector="Button.ChatRowMenu">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Panel.ChatSessionRow:pointerover Button.ChatRowMenu, Button.ChatRowMenu:flyout-open, Button.ChatRowMenu:focus-visible">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="Panel.ChatSessionRow:pointerover TextBlock.ChatRowTime">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Border.ChatSessionEditor">
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="10,8"/>
		</Style>

		<Style Selector="TextBox.ChatRenameInput">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>

		<Style Selector="Button.ChatRowAction">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<Style Selector="TextBox.ChatSearch">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<!-- Copy buttons under messages show on hover -->
		<Style Selector="Button.MessageAction">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<Style Selector="Border.ChatMessage:pointerover Button.MessageAction, Button.MessageAction:focus-visible">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="ComboBox.ModelPicker">
			<Setter Property="MinHeight" Value="24"/>
			<Setter Property="MaxWidth" Value="360"/>
			<Setter Property="Padding" Value="8,0,4,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Transparent, so hovering anywhere in a message shows its copy button -->
		<Style Selector="Border.ChatMessage">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<!-- User message (.msg.user): accent fill, white text, a tight bottom-right corner -->
		<Style Selector="Border.UserBubble">
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="CornerRadius" Value="12,12,4,12"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="MaxWidth" Value="620"/>
		</Style>

		<!-- Tool step (details.tools): a quiet bordered row; open it for arguments and result -->
		<Style Selector="Border.ToolStep">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="9"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<!-- Approval (.card): stronger hairline, warn edge while it waits -->
		<Style Selector="Border.ToolStep.Approval">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentOrangeBrush}"/>
			<Setter Property="CornerRadius" Value="10"/>
		</Style>

		<Style Selector="Border.ToolArguments">
			<Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="9,7"/>
		</Style>

		<!-- The whole step header is the toggle; it keeps the card's look in every state -->
		<Style Selector="ToggleButton.ToolStepHeader">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.ToolStepHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter,
						 ToggleButton.ToolStepHeader:pressed /template/ ContentPresenter#PART_ContentPresenter,
						 ToggleButton.ToolStepHeader:checked /template/ ContentPresenter#PART_ContentPresenter,
						 ToggleButton.ToolStepHeader:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>
		<!-- The chevron follows what is shown: open while details are visible, also when approval or a failure keeps them open -->
		<Style Selector="ToggleButton.ToolStepHeader Viewbox.ToolStepChevron">
			<Setter Property="RenderTransform" Value="rotate(-90deg)"/>
		</Style>
		<Style Selector="ToggleButton.ToolStepHeader Viewbox.ToolStepChevron.open">
			<Setter Property="RenderTransform" Value="none"/>
		</Style>

		<!-- Mini select (.mini-select) in the composer bar -->
		<Style Selector="ComboBox.ApprovalModePicker">
			<Setter Property="MinHeight" Value="24"/>
			<Setter Property="Padding" Value="6,0,2,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Attach (.pill): a small raised button in the composer bar -->
		<Style Selector="Button.ComposerPill">
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Padding" Value="7,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.ComposerPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
		</Style>

		<!-- Context pane section heading (.ctx h3) -->
		<Style Selector="TextBlock.CtxHeading">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="LetterSpacing" Value="0.72"/>
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
		</Style>

		<Style Selector="Ellipse.WorkingDot">
			<Style.Animations>
				<Animation Duration="0:0:1.2" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
					<KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<Style Selector="Button.SuggestionCard">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="14,12"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SuggestionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
		</Style>

		<!-- Composer (.composer): one bordered panel, the prompt on top and the bar below -->
		<Style Selector="Border.ComposerSurface">
			<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="12,10,8,6"/>
		</Style>

		<!-- Composer inputs render without their own chrome; the surrounding surface provides it -->
		<Style Selector="TextBox.BareInput">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox.BareInput:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- Send (.btn.primary.sm) -->
		<Style Selector="Button.SendButton">
			<Setter Property="MinHeight" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.SendButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentStrongHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}"/>
		</Style>

		<Style Selector="Button.SendButton TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}"/>
		</Style>

		<Style Selector="Button.SendButton Path.Icon">
			<Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}"/>
			<Setter Property="StrokeThickness" Value="2.5"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="48,*">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ========================= -->
		<!-- RAIL: Work, the Build ladder, Manage, then the spend meter and the theme toggle -->
		<!-- ========================= -->
		<Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
				Classes="Sidebar"
				Classes.Compact="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsRailCompact}"
				PointerPressed="OnHeaderPointerPressed">
			<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10,12,10,10">

				<!-- Brand -->
				<Button Grid.Row="0"
						Classes="NavBtn"
						Height="40"
						Padding="4,0"
						Margin="0,0,0,4"
						Command="{Binding NavigateToCoordinatorCommand}"
						AutomationProperties.Name="Kam"
						ToolTip.Tip="Kam">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Border Width="28" Height="28"
								CornerRadius="8"
								Background="{DynamicResource AccentStrongBrush}">
							<Viewbox Width="16" Height="16">
								<Path Classes="Icon"
									  Data="{StaticResource IconBrandWave}"
									  Stroke="{DynamicResource AccentOnBrush}"
									  StrokeThickness="2.6"/>
							</Viewbox>
						</Border>
						<StackPanel VerticalAlignment="Center" Spacing="0">
							<TextBlock Classes="NavLabel"
									   Text="Kam"
									   FontSize="14"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Classes="NavLabel"
									   Text="{DynamicResource Lang.Shell.Brand.Tagline}"
									   FontSize="11.5"
									   FontWeight="Normal"
									   Foreground="{DynamicResource TextMutedBrush}"/>
						</StackPanel>
					</StackPanel>
				</Button>

				<!-- Navigation: Work (daily use), Build (the five-step ladder), Manage -->
				<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel VerticalAlignment="Top">
					<TextBlock Classes="NavLabel Overline"
								   Text="{DynamicResource Lang.Shell.Nav.Work}"
								   Margin="8,12,0,6"/>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Coordinator}}"
							Command="{Binding NavigateToCoordinatorCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Workbench}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Workbench}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconListTodo}"/></Viewbox>
							<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Workbench}"/>
							<Panel Grid.Column="2" Classes="NavLabelGroup">
								<Border Classes="Pill NavCount Neutral" IsVisible="{Binding HasRunningTasks}">
									<TextBlock Text="{Binding RunningTaskCount}"/>
								</Border>
							</Panel>
						</Grid>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Inbox}}"
							Command="{Binding NavigateToInboxCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Inbox}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.InboxTip}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconInbox}"/></Viewbox>
							<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Inbox}"/>
							<Panel Grid.Column="2" Classes="NavLabelGroup">
								<Border Classes="Pill Warning NavCount" IsVisible="{Binding HasPendingApprovals}">
									<TextBlock Text="{Binding PendingApprovalCount}"/>
								</Border>
							</Panel>
						</Grid>
					</Button>

					<!-- Build: the five-step ladder. Each step opens its page; the badge says how much of it Kam has today. -->
					<TextBlock Classes="NavLabel Overline"
								   Text="{DynamicResource Lang.Shell.Nav.Build}"
								   Margin="8,12,0,6"/>
					<Panel Classes="Ladder">
						<Border Classes="LadderLine"/>
						<StackPanel>
								<Button Classes.NavBtn="True"
										Classes.LadderStep="True"
										Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Prompts}}"
										Command="{Binding NavigateToPageCommand}"
										CommandParameter="{x:Static vm:NavView.Prompts}"
										AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Prompts}"
										AutomationProperties.HelpText="{DynamicResource Lang.Shell.Ladder.PromptsTip}"
										ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.PromptsTip}">
									<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
										<Border Classes="LadderLevel"><TextBlock Text="1"/></Border>
										<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Prompts}"/>
										<Panel Grid.Column="2" Classes="LadderBadge Partial">
											<Rectangle/>
											<TextBlock Text="{DynamicResource Lang.Shell.Ladder.Partial}"/>
										</Panel>
									</Grid>
								</Button>
								<Button Classes.NavBtn="True"
										Classes.LadderStep="True"
										Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Agents}}"
										Command="{Binding NavigateToPageCommand}"
										CommandParameter="{x:Static vm:NavView.Agents}"
										AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Agents}"
										AutomationProperties.HelpText="{DynamicResource Lang.Shell.Ladder.AgentsTip}"
										ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.AgentsTip}">
									<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
										<Border Classes="LadderLevel"><TextBlock Text="2"/></Border>
										<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Agents}"/>
										<Panel Grid.Column="2" Classes="LadderBadge Partial">
											<Rectangle/>
											<TextBlock Text="{DynamicResource Lang.Shell.Ladder.Partial}"/>
										</Panel>
									</Grid>
								</Button>
								<Button Classes.NavBtn="True"
										Classes.LadderStep="True"
										Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Loops}}"
										Command="{Binding NavigateToPageCommand}"
										CommandParameter="{x:Static vm:NavView.Loops}"
										AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Loops}"
										AutomationProperties.HelpText="{DynamicResource Lang.Shell.Ladder.LoopsTip}"
										ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.LoopsTip}">
									<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
										<Border Classes="LadderLevel"><TextBlock Text="3"/></Border>
										<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Loops}"/>
										<Panel Grid.Column="2" Classes="LadderBadge Partial">
											<Rectangle/>
											<TextBlock Text="{DynamicResource Lang.Shell.Ladder.Partial}"/>
										</Panel>
									</Grid>
								</Button>
								<Button Classes.NavBtn="True"
										Classes.LadderStep="True"
										Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Graphs}}"
										Command="{Binding NavigateToPageCommand}"
										CommandParameter="{x:Static vm:NavView.Graphs}"
										AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Graphs}"
										AutomationProperties.HelpText="{DynamicResource Lang.Shell.Ladder.GraphsTip}"
										ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.GraphsTip}">
									<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
										<Border Classes="LadderLevel"><TextBlock Text="4"/></Border>
										<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Graphs}"/>
										<Panel Grid.Column="2" Classes="LadderBadge Planned">
											<Rectangle/>
											<TextBlock Text="{DynamicResource Lang.Shell.Ladder.Planned}"/>
										</Panel>
									</Grid>
								</Button>
								<Button Classes.NavBtn="True"
										Classes.LadderStep="True"
										Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Builder}}"
										Command="{Binding NavigateToPageCommand}"
										CommandParameter="{x:Static vm:NavView.Builder}"
										AutomationProperties.Name="{DynamicResource Lang.Shell.Ladder.Builder}"
										AutomationProperties.HelpText="{DynamicResource Lang.Shell.Ladder.BuilderTip}"
										ToolTip.Tip="{DynamicResource Lang.Shell.Ladder.BuilderTip}">
									<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
										<Border Classes="LadderLevel"><TextBlock Text="5"/></Border>
										<TextBlock Grid.Column="1" Classes="NavLabel" Text="{DynamicResource Lang.Shell.Ladder.Builder}"/>
										<Panel Grid.Column="2" Classes="LadderBadge Planned">
											<Rectangle/>
											<TextBlock Text="{DynamicResource Lang.Shell.Ladder.Planned}"/>
										</Panel>
									</Grid>
								</Button>
						</StackPanel>
					</Panel>

					<!-- Manage: what agents can use and how Kam is set up -->
					<TextBlock Classes="NavLabel Overline"
								   Text="{DynamicResource Lang.Shell.Nav.Manage}"
								   Margin="8,12,0,6"/>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Runs}}"
							Command="{Binding NavigateToPageCommand}"
							CommandParameter="{x:Static vm:NavView.Runs}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Runs}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.RunsTip}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconActivity}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Runs}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Plugins}}"
							Command="{Binding NavigateToPluginsCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Skills}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Skills}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconBlocks}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Skills}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Extensions}}"
							Command="{Binding NavigateToExtensionsCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Extensions}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Extensions}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconPuzzle}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Extensions}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Integrations}}"
							Command="{Binding NavigateToIntegrationsCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Integrations}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Integrations}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconPlug}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Integrations}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Diagnostics}}"
							Command="{Binding NavigateToDiagnosticsCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Diagnostics}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.DiagnosticsTip}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconCpu}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Diagnostics}"/>
						</StackPanel>
					</Button>
					<Button Classes.NavBtn="True"
							Classes.Active="{Binding ActiveView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:NavView.Settings}}"
							Command="{Binding NavigateToSettingsCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.Nav.Settings}"
							ToolTip.Tip="{DynamicResource Lang.Shell.Nav.Settings}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconSliders}"/></Viewbox>
							<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.Nav.Settings}"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</ScrollViewer>

				<!-- Spend meter: Kam does not record model spend yet, so the card says so instead of showing a number; it opens Runs -->
				<Button Grid.Row="2"
						Classes="SpendCard"
						Margin="0,12,0,6"
						Command="{Binding NavigateToPageCommand}"
						CommandParameter="{x:Static vm:NavView.Runs}"
						AutomationProperties.Name="{DynamicResource Lang.Shell.Spend.Title}"
						AutomationProperties.HelpText="{DynamicResource Lang.Shell.Spend.Tip}"
						ToolTip.Tip="{DynamicResource Lang.Shell.Spend.Tip}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="{DynamicResource Lang.Shell.Spend.Title}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
						<Panel Grid.Column="1" Classes="LadderBadge Planned">
							<Rectangle/>
							<TextBlock Text="{DynamicResource Lang.Shell.Ladder.Planned}"/>
						</Panel>
					</Grid>
				</Button>

				<!-- Bottom navigation: theme toggle -->
				<StackPanel Grid.Row="3" Classes="SidebarFooter" Spacing="4">
					<Button Classes="NavBtn"
							Command="{Binding ToggleThemeCommand}"
							AutomationProperties.Name="{DynamicResource Lang.Shell.ToggleTheme}"
							ToolTip.Tip="{DynamicResource Lang.Shell.ToggleTheme}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Panel Width="15" Height="15">
								<Viewbox IsVisible="{Binding IsDarkMode}"><Path Classes="Icon" Data="{StaticResource IconSun}"/></Viewbox>
								<Viewbox IsVisible="{Binding !IsDarkMode}"><Path Classes="Icon" Data="{StaticResource IconMoon}"/></Viewbox>
							</Panel>
							<!-- Names the theme a click switches to, in the interface language -->
							<Panel Classes="NavLabelGroup" VerticalAlignment="Center">
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.LightMode}" IsVisible="{Binding IsDarkMode}"/>
								<TextBlock Classes="NavLabel" Text="{DynamicResource Lang.Shell.DarkMode}" IsVisible="{Binding !IsDarkMode}"/>
							</Panel>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ========================= -->
		<!-- TOP BAR (48 px, draggable): page name, status, search, wake phrase, push to talk -->
		<!-- ========================= -->
		<Border Grid.Row="0" Grid.Column="1"
				Background="Transparent"
				BorderBrush="{DynamicResource BorderSubtleBrush}"
				BorderThickness="0,0,0,1"
				PointerPressed="OnHeaderPointerPressed">
			<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
				  Classes="TopBar"
				  Classes.narrow="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsNarrow}"
				  ColumnSpacing="10"
				  Margin="14,0,210,0">
				<TextBlock Grid.Column="0"
						   Text="{Binding ActivePageTitle}"
						   FontSize="13.5"
						   FontWeight="SemiBold"
						   Foreground="{DynamicResource TextPrimaryBrush}"
						   VerticalAlignment="Center"/>
				<Button Grid.Column="1"
						x:Name="HeaderStatusButton"
						Classes="PillButton"
						Command="{Binding HeaderStatusCommand}"
						AutomationProperties.Name="{Binding StatusText, Mode=OneWay}"
						ToolTip.Tip="{Binding StatusToolTip}">
					<Border Classes="Pill">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Ellipse Width="6" Height="6"
									 Fill="{Binding StatusColor, Mode=OneWay}"
									 VerticalAlignment="Center"/>
							<TextBlock Text="{Binding StatusText, Mode=OneWay}"
									   Foreground="{DynamicResource TextSecondaryBrush}"/>
						</StackPanel>
					</Border>
				</Button>
				<!-- Search: looks like an input, opens the task search -->
				<Button Grid.Column="3"
						Classes="TitleSearch"
						Click="OnTitleSearchClick"
						AutomationProperties.Name="{DynamicResource Lang.Shell.SearchTasksTip}"
						ToolTip.Tip="{DynamicResource Lang.Shell.SearchTasksTip}">
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
						<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
						<TextBlock Grid.Column="1" Classes="TitleSearchText" Text="{DynamicResource Lang.Shell.SearchTasks}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
						<Border Grid.Column="2" Classes="Kbd"><TextBlock Text="Ctrl K"/></Border>
					</Grid>
				</Button>
				<!-- The wake phrase listens locally -->
				<Panel Grid.Column="4" Classes="WakePill" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsWakeWordEnabled}" ToolTip.Tip="{DynamicResource Lang.Shell.WakeOnTip}">
						<Border Classes="StatusDot Success" VerticalAlignment="Center"/>
						<TextBlock Text="{DynamicResource Lang.Shell.WakeOn}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
					</StackPanel>
				</Panel>
				<!-- Push to talk -->
				<Button Grid.Column="5"
						x:Name="TopBarTalkButton"
						Classes="MicButton"
						Classes.listening="{Binding IsVoiceListening}"
						AutomationProperties.Name="{Binding TalkToolTip}"
						ToolTip.Tip="{Binding TalkToolTip}"
						IsEnabled="{Binding IsVoiceAvailable}"
						Command="{Binding TalkCommand}">
					<Viewbox Width="15" Height="15"><Path Classes="Icon" Data="{StaticResource IconMic}"/></Viewbox>
				</Button>
			</Grid>
		</Border>

		<!-- ========================= -->
		<!-- CONTENT + CONTEXT PANE -->
		<!-- ========================= -->
		<Border Grid.Row="1" Grid.Column="1"
				Background="{DynamicResource SurfaceBgBrush}"
				ClipToBounds="True">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="{Binding ActivityPanelWidth}"/>
				</Grid.ColumnDefinitions>

				<!-- Tasks: task list, conversation and composer -->
				<local:TasksView x:Name="TasksPanel"
								 Grid.Column="0"
								 IsVisible="{Binding IsChatWorkbenchVisible}"/>

				<!-- Needs you: approvals waiting across all tasks -->
				<local:InboxView Grid.Column="0"
								 IsVisible="{Binding IsInboxVisible}"/>

				<!-- Page host -->
				<ContentControl Content="{Binding CurrentViewModel}"
								Grid.Column="0"
								IsVisible="{Binding IsPageHostVisible}">
					<ContentControl.DataTemplates>
						<DataTemplate DataType="pagevm:PluginsViewModel">
							<local:PluginsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:RuntimeDiagnosticsViewModel">
							<local:RuntimeDiagnosticsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:IntegrationsViewModel">
							<local:IntegrationsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:ExtensionsViewModel">
							<local:ExtensionsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:SettingsViewModel">
							<local:SettingsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:PromptsViewModel">
							<local:PromptsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:AgentsViewModel">
							<local:AgentsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:LoopsViewModel">
							<local:LoopsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:RunsViewModel">
							<local:RunsView/>
						</DataTemplate>

						<DataTemplate DataType="pagevm:PlannedStepViewModel">
							<local:PlannedStepView/>
						</DataTemplate>
					</ContentControl.DataTemplates>
				</ContentControl>

				<!-- ========================= -->
				<!-- ACTIVITY PANEL -->
				<!-- ========================= -->
				<!-- The 290 px context pane (.ctx) beside the thread, from 1280 px up -->
				<Border Grid.Column="1"
						Background="{DynamicResource CardBgBrush}"
						BorderBrush="{DynamicResource BorderSubtleBrush}"
						BorderThickness="1,0,0,0"
						IsVisible="{Binding IsActivityPanelShown}">
					<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *">

						<!-- Activity Header -->
						<Border Grid.Row="0"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1">
							<Grid RowDefinitions="Auto,Auto"
								  RowSpacing="10"
								  Margin="14,12,14,12">
								<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
										<TextBlock Text="{DynamicResource Lang.Activity.Title}" Classes="SectionTitle" FontSize="13.5"/>
										<TextBlock Text="{DynamicResource Lang.Activity.Subtitle}" Classes="Caption"/>
									</StackPanel>
									<Button Grid.Column="1"
											Classes="IconButton CompactIconButton"
											Background="Transparent"
											BorderThickness="0"
											VerticalAlignment="Center"
											AutomationProperties.Name="{DynamicResource Lang.Activity.Hide}"
											ToolTip.Tip="{DynamicResource Lang.Activity.Hide}"
											Command="{Binding ToggleActivityPanelCommand}">
										<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconX}"/></Viewbox>
									</Button>
								</Grid>
								<Border Grid.Row="1" Classes="Segmented" HorizontalAlignment="Left">
									<Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2" HorizontalAlignment="Left">
										<Button Grid.Column="0"
												Classes="DrawerTab"
												Classes.Selected="{Binding IsActivityRunsPanelVisible}"
												Content="{DynamicResource Lang.Activity.Tab.Runs}"
												Command="{Binding ShowRunsCommand}"/>
										<Button Grid.Column="1"
												Classes="DrawerTab"
												Classes.Selected="{Binding IsActivityContextPanelVisible}"
												Content="{DynamicResource Lang.Activity.Context}"
												Command="{Binding ShowContextCommand}"/>
										<Button Grid.Column="2"
												Classes="DrawerTab"
												Classes.Selected="{Binding IsActivityEventsPanelVisible}"
												Content="{DynamicResource Lang.Activity.Tab.Events}"
												Command="{Binding ShowEventsCommand}"/>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<!-- Pending Skill Confirmations -->
						<Border Grid.Row="1"
								Background="{DynamicResource CardBgHoverBrush}"
								BorderBrush="{DynamicResource AccentStrongBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding HasPendingSkillConfirmations}">
							<StackPanel Spacing="8">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon Accent" Data="{StaticResource IconAlert}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Activity.ApprovalNeeded}"
											   FontSize="12"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource AccentBrush}"
											   VerticalAlignment="Center"/>
								</StackPanel>

								<ItemsControl ItemsSource="{Binding PendingSkillConfirmations}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="{DynamicResource CardBgBrush}"
													BorderBrush="{DynamicResource BorderSubtleBrush}"
													BorderThickness="1"
													CornerRadius="8"
													Padding="10"
													Margin="0,0,0,6">
												<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
													<TextBlock Grid.Row="0" Grid.Column="0"
															   Text="{Binding SkillId}"
															   Foreground="{DynamicResource TextPrimaryBrush}"
															   FontSize="12"
															   FontFamily="{StaticResource MonoFontFamily}"
															   FontWeight="SemiBold"
															   TextWrapping="Wrap"/>
													<TextBlock Grid.Row="1" Grid.Column="0"
															   Text="{Binding UserCommand}"
															   Foreground="{DynamicResource TextSecondaryBrush}"
															   FontSize="11"
															   TextWrapping="Wrap"
															   Margin="0,4,12,0"/>
													<TextBlock Grid.Row="2" Grid.Column="0"
															   Text="{Binding Reason}"
															   Foreground="{DynamicResource TextMutedBrush}"
															   FontSize="10"
															   TextWrapping="Wrap"
															   Margin="0,4,12,0"/>
													<Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
															Background="{DynamicResource CardBgHoverBrush}"
															BorderBrush="{DynamicResource BorderSubtleBrush}"
															BorderThickness="1"
															CornerRadius="6"
															Padding="8"
															Margin="0,8,0,0"
															IsVisible="{Binding HasPreview}">
														<ScrollViewer MaxHeight="180"
																	  HorizontalScrollBarVisibility="Auto"
																	  VerticalScrollBarVisibility="Auto">
															<TextBlock Text="{Binding Preview}"
																	   Foreground="{DynamicResource TextSecondaryBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   TextWrapping="NoWrap"/>
														</ScrollViewer>
													</Border>
													<StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
																Orientation="Horizontal"
																VerticalAlignment="Top"
																Spacing="6">
														<Button Classes="IconButton"
																Width="28" Height="28"
																Background="Transparent"
																BorderBrush="{DynamicResource AccentGreenBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="0"
																Cursor="Hand"
																AutomationProperties.Name="{DynamicResource Lang.Common.Approve}"
																ToolTip.Tip="{DynamicResource Lang.Common.Approve}"
																Command="{Binding ApproveCommand}">
															<Viewbox Width="16" Height="16"><Path Classes="Icon Success" Data="{StaticResource IconCheck}"/></Viewbox>
														</Button>
														<Button Classes="IconButton"
																Width="28" Height="28"
																Background="Transparent"
																BorderBrush="{DynamicResource AccentErrorBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="0"
																Cursor="Hand"
																AutomationProperties.Name="{DynamicResource Lang.Activity.Reject}"
																ToolTip.Tip="{DynamicResource Lang.Activity.Reject}"
																Command="{Binding RejectCommand}">
															<Viewbox Width="16" Height="16"><Path Classes="Icon Danger" Data="{StaticResource IconX}"/></Viewbox>
														</Button>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!-- Runtime Agents -->
						<Border Grid.Row="2"
								Background="Transparent"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Runs}}">
							<StackPanel Spacing="12">
								<!-- Steps of the latest turn in the selected chat: each tool call, its outcome and time, then totals -->
								<StackPanel Spacing="10" IsVisible="{Binding SelectedAgentChatSession.HasLastTurn}">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBlock Text="{Binding SelectedAgentChatSession.LastTurn.Request}"
												   FontSize="12"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextPrimaryBrush}"
												   TextTrimming="CharacterEllipsis"
												   VerticalAlignment="Center"/>
										<Border Grid.Column="1" Classes="Pill" VerticalAlignment="Center">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<Border Classes="StatusDot Accent" IsVisible="{Binding SelectedAgentChatSession.LastTurn.IsRunning}"/>
												<Border Classes="StatusDot Success" IsVisible="{Binding SelectedAgentChatSession.LastTurn.IsDone}"/>
												<Border Classes="StatusDot Danger" IsVisible="{Binding SelectedAgentChatSession.LastTurn.IsFailed}"/>
												<TextBlock Text="{Binding SelectedAgentChatSession.LastTurn.OutcomeText}"/>
											</StackPanel>
										</Border>
									</Grid>
									<ItemsControl ItemsSource="{Binding SelectedAgentChatSession.LastTurn.Steps}">
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="vm:AgentChatMessageViewModel">
												<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
													<Border Grid.Column="0" Classes="StatusDot Accent" IsVisible="{Binding IsToolRunning}"/>
													<Border Grid.Column="0" Classes="StatusDot Warning" IsVisible="{Binding IsAwaitingApproval}"/>
													<Border Grid.Column="0" Classes="StatusDot Success" IsVisible="{Binding IsToolSucceeded}"/>
													<Border Grid.Column="0" Classes="StatusDot Danger" IsVisible="{Binding IsToolFailed}"/>
													<TextBlock Grid.Column="1"
															   Text="{Binding ToolDisplayName}"
															   FontSize="12"
															   Foreground="{DynamicResource TextSecondaryBrush}"
															   TextTrimming="CharacterEllipsis"/>
													<TextBlock Grid.Column="2"
															   Text="{Binding ToolDurationText}"
															   FontSize="11"
															   FontFamily="{StaticResource MonoFontFamily}"
															   Foreground="{DynamicResource TextMutedBrush}"/>
													<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
															   Text="{Binding ToolStatusText}"
															   FontSize="11"
															   Foreground="{DynamicResource TextMutedBrush}"
															   TextTrimming="CharacterEllipsis"/>
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="{DynamicResource Lang.Activity.Trace.NoTools}"
											   FontSize="12"
											   Foreground="{DynamicResource TextMutedBrush}"
											   IsVisible="{Binding !SelectedAgentChatSession.LastTurn.HasSteps}"/>
									<TextBlock Text="{Binding SelectedAgentChatSession.LastTurn.SummaryText}"
											   FontSize="11"
											   Foreground="{DynamicResource TextMutedBrush}"
											   TextWrapping="Wrap"/>
								</StackPanel>
								<TextBlock Text="{DynamicResource Lang.Activity.Trace.Empty}"
										   FontSize="12"
										   Foreground="{DynamicResource TextMutedBrush}"
										   TextWrapping="Wrap"
										   IsVisible="{Binding !SelectedAgentChatSession.HasLastTurn}"/>

								<!-- Older single-shot agent runs (command mode); shown only when there are any -->
								<StackPanel Spacing="8" IsVisible="{Binding HasRuntimeAgentActivities}">
								<StackPanel Orientation="Horizontal"
											Spacing="8">
									<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon Accent" Data="{StaticResource IconLightbulb}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Activity.Runs.Title}"
											   FontSize="12"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource TextMutedBrush}"
											   VerticalAlignment="Center"/>
								</StackPanel>
								<ItemsControl ItemsSource="{Binding RuntimeAgentActivities}">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:RuntimeAgentActivityViewModel">
											<Button Command="{Binding $parent[Window].DataContext.ShowRuntimeAgentRunDetailCommand}"
													CommandParameter="{Binding}"
													Background="Transparent"
													BorderThickness="0"
													Padding="0"
													HorizontalContentAlignment="Stretch">
												<Border Background="{DynamicResource CardBgHoverBrush}"
														BorderBrush="{DynamicResource BorderSubtleBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Padding="10"
														Margin="0,0,0,6">
													<Grid ColumnDefinitions="Auto, *, Auto"
														  RowDefinitions="Auto, Auto"
														  ColumnSpacing="8">
														<Border Grid.Row="0"
																Grid.RowSpan="2"
																Width="2"
																Background="{Binding StatusBrush}"
																CornerRadius="2"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="1"
																   Text="{Binding DisplayName}"
																   FontSize="12"
																   FontWeight="SemiBold"
																   Foreground="{DynamicResource TextPrimaryBrush}"
																   TextTrimming="CharacterEllipsis"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="2"
																   Text="{Binding StatusText}"
																   FontSize="10"
																   FontWeight="SemiBold"
																   Foreground="{Binding StatusBrush}"/>
														<TextBlock Grid.Row="1"
																   Grid.Column="1"
																   Text="{Binding LastMessage}"
																   FontSize="11"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   TextTrimming="CharacterEllipsis"
																   MaxLines="1"
																   Margin="0,4,8,0"/>
														<TextBlock Grid.Row="1"
																   Grid.Column="2"
																   Text="{Binding UpdatedText}"
																   FontSize="10"
																   FontFamily="{StaticResource MonoFontFamily}"
																   Foreground="{DynamicResource TextMutedBrush}"
																   Margin="0,4,0,0"/>
													</Grid>
												</Border>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								</StackPanel>
								<Border Background="{DynamicResource CardBgHoverBrush}"
										BorderBrush="{DynamicResource AccentBrush}"
										BorderThickness="1"
										CornerRadius="8"
										Padding="12"
										IsVisible="{Binding HasSelectedRuntimeAgentRun}">
									<StackPanel Spacing="8">
										<Grid ColumnDefinitions="*, Auto">
											<TextBlock Grid.Column="0"
													   Text="{DynamicResource Lang.Activity.RunDetail.Title}"
													   FontSize="12"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource TextPrimaryBrush}"/>
											<TextBlock Grid.Column="1"
													   Text="{Binding SelectedRuntimeAgentRun.StatusText}"
													   FontSize="10"
													   FontWeight="SemiBold"
													   Foreground="{DynamicResource AccentBrush}"/>
										</Grid>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.DisplayName}"
												   FontSize="12"
												   Foreground="{DynamicResource TextPrimaryBrush}"
												   TextTrimming="CharacterEllipsis"/>
										<Grid ColumnDefinitions="Auto, *"
											  RowDefinitions="Auto, Auto"
											  ColumnSpacing="10"
											  RowSpacing="4">
											<TextBlock Grid.Row="0"
													   Grid.Column="0"
													   Text="{DynamicResource Lang.Activity.RunDetail.Model}"
													   FontSize="10"
													   Foreground="{DynamicResource TextMutedBrush}"/>
											<TextBlock Grid.Row="0"
													   Grid.Column="1"
													   Text="{Binding SelectedRuntimeAgentRun.ModelIdText}"
													   FontSize="10"
													   Foreground="{DynamicResource TextSecondaryBrush}"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Grid.Row="1"
													   Grid.Column="0"
													   Text="{DynamicResource Lang.Activity.RunDetail.Duration}"
													   FontSize="10"
													   Foreground="{DynamicResource TextMutedBrush}"/>
											<TextBlock Grid.Row="1"
													   Grid.Column="1"
													   Text="{Binding SelectedRuntimeAgentRun.DurationText}"
													   FontSize="10"
													   Foreground="{DynamicResource TextSecondaryBrush}"/>
										</Grid>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.TaskText}"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextWrapping="Wrap"
												   MaxLines="3"/>
										<ItemsControl ItemsSource="{Binding SelectedRuntimeAgentRun.Observations}"
													  IsVisible="{Binding SelectedRuntimeAgentRun.HasObservations}">
											<ItemsControl.ItemTemplate>
												<DataTemplate DataType="vm:RuntimeAgentObservationDetailViewModel">
													<Grid ColumnDefinitions="Auto, *, Auto"
														  RowDefinitions="Auto, Auto"
														  ColumnSpacing="8"
														  Margin="0,2">
														<TextBlock Grid.Row="0"
																   Grid.Column="0"
																   Text="{DynamicResource Lang.Activity.Context}"
																   FontSize="10"
																   Foreground="{DynamicResource TextMutedBrush}"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="1"
																   Text="{Binding DisplayName}"
																   FontSize="10"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   TextTrimming="CharacterEllipsis"/>
														<TextBlock Grid.Row="0"
																   Grid.Column="2"
																   Text="{Binding StatusText}"
																   FontSize="10"
																   Foreground="{DynamicResource TextMutedBrush}"/>
														<TextBlock Grid.Row="1"
																   Grid.Column="1"
																   Grid.ColumnSpan="2"
																   Text="{Binding SummaryText}"
																   FontSize="10"
																   Foreground="{DynamicResource TextMutedBrush}"
																   TextTrimming="CharacterEllipsis"
																   MaxLines="1"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.ResponseText}"
												   FontSize="11"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextWrapping="Wrap"
												   MaxLines="4"
												   IsVisible="{Binding SelectedRuntimeAgentRun.HasResponse}"/>
										<TextBlock Text="{Binding SelectedRuntimeAgentRun.ErrorText}"
												   FontSize="11"
												   Foreground="{DynamicResource AccentErrorBrush}"
												   TextWrapping="Wrap"
												   MaxLines="3"
												   IsVisible="{Binding SelectedRuntimeAgentRun.HasError}"/>
									</StackPanel>
								</Border>
							</StackPanel>
						</Border>

						<!-- This task: how full the selected task's context window is, and a way to compact it -->
						<Border Grid.Row="2"
								Background="Transparent"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Context}}">
							<StackPanel Spacing="10">
								<TextBlock Text="{DynamicResource Lang.Activity.Task.Title}"
										   FontSize="12"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource TextMutedBrush}"/>
								<StackPanel Spacing="6">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBlock Text="{DynamicResource Lang.Activity.Task.Context}"
												   FontSize="12"
												   Foreground="{DynamicResource TextPrimaryBrush}"/>
										<TextBlock Grid.Column="1"
												   Text="{Binding SelectedContextText}"
												   FontSize="12"
												   Foreground="{DynamicResource TextSecondaryBrush}"/>
									</Grid>
									<ProgressBar Classes="ContextMeter"
											  Classes.Warning="{Binding IsSelectedContextNearBudget}"
											  Minimum="0"
											  Maximum="100"
											  Value="{Binding SelectedContextPercent}"
											  IsVisible="{Binding HasSelectedContextTokens}"/>
									<TextBlock Text="{DynamicResource Lang.Activity.Task.ContextHint}"
											   Classes="Caption"
											   TextWrapping="Wrap"/>
								</StackPanel>
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<TextBlock Text="{Binding SelectedCompactionText}"
											   FontSize="12"
											   Foreground="{DynamicResource TextSecondaryBrush}"
											   VerticalAlignment="Center"/>
									<Button Grid.Column="1"
											Classes="SecondaryAction"
											Content="{DynamicResource Lang.Activity.Task.CompactNow}"
											ToolTip.Tip="{DynamicResource Lang.Activity.Task.CompactNowTip}"
											IsEnabled="{Binding CanCompactSelectedTask}"
											Command="{Binding CompactAgentChatCommand}"/>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Planner Trace (command mode history; shown with the event stream) -->
						<Border Grid.Row="3"
								Background="{DynamicResource CardBgBrush}"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Events}}">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0"
												Orientation="Horizontal"
												Spacing="8">
										<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconListTree}"/></Viewbox>
										<TextBlock Text="{DynamicResource Lang.Activity.PlanTrace.Title}"
												   FontSize="12"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextMutedBrush}"
												   VerticalAlignment="Center"/>
									</StackPanel>
									<Button Grid.Column="1"
											Classes="IconButton CompactIconButton"
											Background="Transparent"
											BorderBrush="{DynamicResource BorderSubtleBrush}"
											BorderThickness="1"
											CornerRadius="6"
											Padding="0"
											Cursor="Hand"
											AutomationProperties.Name="{DynamicResource Lang.Activity.PlanTrace.Clear}"
											ToolTip.Tip="{DynamicResource Lang.Activity.PlanTrace.Clear}"
											Command="{Binding ClearSkillPlannerTraceCommand}">
										<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconTrash}"/></Viewbox>
									</Button>
								</Grid>

								<ScrollViewer MaxHeight="220"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding SkillPlannerTraces}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource CardBgHoverBrush}"
														BorderBrush="{DynamicResource BorderSubtleBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Padding="10"
														Margin="0,0,0,8">
													<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">
														<StackPanel Grid.Row="0"
																	Orientation="Horizontal"
																	Spacing="8">
															<TextBlock Text="{Binding SkillIdText}"
																	   Foreground="{DynamicResource TextPrimaryBrush}"
																	   FontSize="11"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   FontWeight="SemiBold"/>
															<TextBlock Text="{Binding StatusText}"
																	   Foreground="{DynamicResource AccentBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
															<TextBlock Text="{Binding ConfidenceText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
															<TextBlock Text="{Binding DurationText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
														</StackPanel>
														<TextBlock Grid.Row="1"
																   Text="{Binding UserRequestText}"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   FontSize="10"
																   TextWrapping="Wrap"
																   MaxLines="2"
																   Margin="0,6,0,0"/>
														<TextBlock Grid.Row="2"
																   Text="{Binding ReasoningText}"
																   Foreground="{DynamicResource TextMutedBrush}"
																   FontSize="10"
																   TextWrapping="Wrap"
																   MaxLines="2"
																   IsVisible="{Binding HasReasoning}"
																   Margin="0,4,0,0"/>
														<TextBlock Grid.Row="3"
																   Text="{Binding ErrorText}"
																   Foreground="{DynamicResource AccentErrorBrush}"
																   FontSize="10"
																   TextWrapping="Wrap"
																   MaxLines="2"
																   IsVisible="{Binding HasError}"
																   Margin="0,4,0,0"/>
														<TextBlock Grid.Row="4"
																   Text="{Binding RawResponseText}"
																   Foreground="{DynamicResource TextMutedBrush}"
																   FontSize="10"
																   FontFamily="{StaticResource MonoFontFamily}"
																   TextWrapping="Wrap"
																   MaxLines="4"
																   IsVisible="{Binding HasRawResponse}"
																   Margin="0,6,0,0"/>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>
						</Border>

						<!-- Skill Execution History (shown with the event stream) -->
						<Border Grid.Row="4"
								Background="{DynamicResource CardBgBrush}"
								BorderBrush="{DynamicResource BorderSubtleBrush}"
								BorderThickness="0,0,0,1"
								Padding="16,12"
								IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Events}}">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*, Auto">
									<StackPanel Grid.Column="0"
												Orientation="Horizontal"
												Spacing="8">
										<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconHistory}"/></Viewbox>
										<TextBlock Text="{DynamicResource Lang.Activity.SkillResults.Title}"
												   FontSize="12"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextMutedBrush}"
												   VerticalAlignment="Center"/>
									</StackPanel>
									<Button Grid.Column="1"
											Classes="IconButton CompactIconButton"
											Background="Transparent"
											BorderBrush="{DynamicResource BorderSubtleBrush}"
											BorderThickness="1"
											CornerRadius="6"
											Padding="0"
											Cursor="Hand"
											AutomationProperties.Name="{DynamicResource Lang.Activity.SkillResults.Clear}"
											ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.Clear}"
											Command="{Binding ClearSkillExecutionHistoryCommand}">
										<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconTrash}"/></Viewbox>
									</Button>
								</Grid>

								<Grid ColumnDefinitions="*, 132, Auto"
									  RowDefinitions="Auto, Auto"
									  ColumnSpacing="8"
									  RowSpacing="6"
									  Margin="0,10,0,10">
									<TextBox Grid.Row="0" Grid.Column="0"
											 Text="{Binding SkillExecutionHistoryFilterText, Mode=TwoWay}"
											 PlaceholderText="{DynamicResource Lang.Activity.SkillResults.Filter}"
											 FontSize="11"
											 FontFamily="{StaticResource MonoFontFamily}"
											 Background="{DynamicResource CardBgBrush}"
											 BorderBrush="{DynamicResource BorderSubtleBrush}"
											 BorderThickness="1"
											 CornerRadius="6"
											 Padding="8,5"/>
									<ComboBox Grid.Row="0" Grid.Column="1"
											  ItemsSource="{Binding SkillExecutionHistoryStatusFilters}"
											  SelectedItem="{Binding SkillExecutionHistoryStatusFilter, Mode=TwoWay}"
											  Height="30"
											  FontSize="11"
											  FontFamily="{StaticResource MonoFontFamily}"
											  Background="{DynamicResource CardBgBrush}"
											  BorderBrush="{DynamicResource BorderSubtleBrush}"
											  BorderThickness="1"
											  Padding="8,3"/>
									<Button Grid.Row="0" Grid.Column="2"
											Classes="IconButton"
											Width="30" Height="30"
											Background="Transparent"
											BorderBrush="{DynamicResource BorderSubtleBrush}"
											BorderThickness="1"
											CornerRadius="6"
											Padding="0"
											Cursor="Hand"
											AutomationProperties.Name="{DynamicResource Lang.Activity.SkillResults.ClearFilters}"
											ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.ClearFilters}"
											Command="{Binding ClearSkillExecutionHistoryFiltersCommand}"
											IsVisible="{Binding HasSkillExecutionHistoryFilter}">
										<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconX}"/></Viewbox>
									</Button>
									<TextBlock Grid.Row="1" Grid.ColumnSpan="3"
											   Text="{Binding SkillExecutionHistorySummaryText}"
											   Foreground="{DynamicResource TextMutedBrush}"
											   FontSize="10"
											   FontFamily="{StaticResource MonoFontFamily}"/>
								</Grid>

								<TextBlock Text="{DynamicResource Lang.Activity.SkillResults.NoMatches}"
										   Foreground="{DynamicResource TextMutedBrush}"
										   FontSize="10"
										   FontFamily="{StaticResource MonoFontFamily}"
										   Margin="0,0,0,8"
										   IsVisible="{Binding HasNoSkillExecutionHistoryMatches}"/>

								<ScrollViewer MaxHeight="280"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl ItemsSource="{Binding SkillExecutionHistory}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="{DynamicResource CardBgHoverBrush}"
														BorderBrush="{DynamicResource BorderSubtleBrush}"
														BorderThickness="1"
														CornerRadius="8"
														Padding="10"
														Margin="0,0,0,8">
													<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
														  ColumnDefinitions="*, Auto">
														<TextBlock Grid.Row="0" Grid.Column="0"
																   Text="{Binding SkillId}"
																   Foreground="{DynamicResource TextPrimaryBrush}"
																   FontSize="12"
																   FontFamily="{StaticResource MonoFontFamily}"
																   FontWeight="SemiBold"
																   TextWrapping="Wrap"/>
														<StackPanel Grid.Row="0" Grid.Column="1"
																	Orientation="Horizontal"
																	Spacing="6"
																	VerticalAlignment="Top">
															<TextBlock Text="{Binding StatusText}"
																	   Foreground="{DynamicResource AccentBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   FontWeight="SemiBold"/>
															<TextBlock Text="{Binding DurationText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
														</StackPanel>
														<StackPanel Grid.Row="1" Grid.ColumnSpan="2"
																	Orientation="Horizontal"
																	Spacing="8"
																	Margin="0,4,0,0">
															<TextBlock Text="{Binding TimestampText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"/>
															<TextBlock Text="{Binding ExitCodeText}"
																	   Foreground="{DynamicResource TextMutedBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   IsVisible="{Binding HasExitCode}"/>
															<TextBlock Text="{Binding RuntimeFlagsText}"
																	   Foreground="{DynamicResource AccentErrorBrush}"
																	   FontSize="10"
																	   FontFamily="{StaticResource MonoFontFamily}"
																	   IsVisible="{Binding HasRuntimeFlags}"/>
														</StackPanel>
														<StackPanel Grid.Row="2" Grid.ColumnSpan="2"
																	Orientation="Horizontal"
																	Spacing="6"
																	Margin="0,8,0,0">
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource BorderSubtleBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	AutomationProperties.Name="{DynamicResource Lang.Activity.SkillResults.CopyResult}"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.CopyResult}"
																	Command="{Binding CopyResultCommand}">
																<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconCopy}"/></Viewbox>
															</Button>
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource BorderSubtleBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	AutomationProperties.Name="{DynamicResource Lang.Activity.SkillResults.CopyStdOut}"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.CopyStdOut}"
																	Command="{Binding CopyStdOutCommand}"
																	IsVisible="{Binding HasStdOut}">
																<Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconTerminal}"/></Viewbox>
															</Button>
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource AccentErrorBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	AutomationProperties.Name="{DynamicResource Lang.Activity.SkillResults.CopyStdErr}"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.CopyStdErr}"
																	Command="{Binding CopyStdErrCommand}"
																	IsVisible="{Binding HasStdErr}">
																<Viewbox Width="14" Height="14"><Path Classes="Icon Danger" Data="{StaticResource IconAlert}"/></Viewbox>
															</Button>
															<Button Classes="IconButton CompactIconButton"
																	Background="Transparent"
																	BorderBrush="{DynamicResource AccentStrongBrush}"
																	BorderThickness="1"
																	CornerRadius="6"
																	Padding="0"
																	Cursor="Hand"
																	AutomationProperties.Name="{DynamicResource Lang.Activity.SkillResults.Rerun}"
																	ToolTip.Tip="{DynamicResource Lang.Activity.SkillResults.Rerun}"
																	Command="{Binding RerunCommand}"
																	IsVisible="{Binding CanRerun}">
																<Viewbox Width="14" Height="14"><Path Classes="Icon Accent" Data="{StaticResource IconRefresh}"/></Viewbox>
															</Button>
														</StackPanel>
														<TextBlock Grid.Row="3" Grid.ColumnSpan="2"
																   Text="{Binding DetailText}"
																   Foreground="{DynamicResource TextSecondaryBrush}"
																   FontSize="10"
																   FontFamily="{StaticResource MonoFontFamily}"
																   TextWrapping="Wrap"
																   MaxLines="5"
																   Margin="0,6,0,0"
																   IsVisible="{Binding HasDetailText}"/>
														<Border Grid.Row="4" Grid.ColumnSpan="2"
																Background="{DynamicResource CardBgBrush}"
																BorderBrush="{DynamicResource BorderSubtleBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="8"
																Margin="0,8,0,0"
																IsVisible="{Binding HasStdOut}">
															<ScrollViewer MaxHeight="72"
																		  HorizontalScrollBarVisibility="Auto"
																		  VerticalScrollBarVisibility="Auto">
																<TextBlock Text="{Binding StdOut}"
																		   Foreground="{DynamicResource TextSecondaryBrush}"
																		   FontSize="10"
																		   FontFamily="{StaticResource MonoFontFamily}"
																		   TextWrapping="NoWrap"/>
															</ScrollViewer>
														</Border>
														<Border Grid.Row="5" Grid.ColumnSpan="2"
																Background="{DynamicResource CardBgBrush}"
																BorderBrush="{DynamicResource AccentErrorBrush}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="8"
																Margin="0,8,0,0"
																IsVisible="{Binding HasStdErr}">
															<ScrollViewer MaxHeight="72"
																		  HorizontalScrollBarVisibility="Auto"
																		  VerticalScrollBarVisibility="Auto">
																<TextBlock Text="{Binding StdErr}"
																		   Foreground="{DynamicResource AccentErrorBrush}"
																		   FontSize="10"
																		   FontFamily="{StaticResource MonoFontFamily}"
																		   TextWrapping="NoWrap"/>
															</ScrollViewer>
														</Border>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>
						</Border>

						<!-- Log Content -->
						<ScrollViewer x:Name="LogScrollViewer" Grid.Row="5"
									  VerticalScrollBarVisibility="Auto"
									  Margin="18,10,18,0"
									  IsVisible="{Binding SelectedActivityPanelMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ActivityPanelMode.Events}}">
							<ItemsControl ItemsSource="{Binding ActivityLogEntries}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="vm:ActivityLogEntryViewModel">
										<Border Classes="ActivityLogItem">
											<Grid ColumnDefinitions="Auto, *"
												  RowDefinitions="Auto, Auto"
												  ColumnSpacing="9">
												<Border Grid.Row="0"
														Grid.RowSpan="2"
														Width="2"
														Background="{Binding AccentBrush}"
														CornerRadius="2"/>
												<Grid Grid.Row="0"
													  Grid.Column="1"
													  ColumnDefinitions="Auto, Auto, *"
													  ColumnSpacing="7">
													<TextBlock Grid.Column="0"
															   Text="{Binding CategoryText}"
															   Classes="ActivityMeta"
															   Foreground="{Binding AccentBrush}"/>
													<TextBlock Grid.Column="1"
															   Text="{Binding TimeText}"
															   Classes="ActivityMeta"
															   FontFamily="{StaticResource MonoFontFamily}"/>
													<TextBlock Grid.Column="2"
															   Text="{Binding SourceText}"
															   Classes="ActivityMeta"
															   TextTrimming="CharacterEllipsis"
															   IsVisible="{Binding HasSourceText}"/>
												</Grid>
												<TextBlock Grid.Row="1"
														   Grid.Column="1"
														   Text="{Binding MessageText}"
														   Classes="ActivityMessage"
														   MaxLines="4"
														   Margin="0,4,0,0"/>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>

						<!-- Command prompt (shown on pages that hide the chat composer) -->
					</Grid>
				</Border>
			</Grid>
		</Border>

		<!-- Command palette (Ctrl+K): over everything, closed by default -->
		<controls:CommandPalette Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
							  DataContext="{Binding CommandPalette}"/>
	</Grid>
</Window>
