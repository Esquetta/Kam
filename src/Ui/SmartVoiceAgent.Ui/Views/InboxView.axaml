<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels"
             xmlns:local="using:SmartVoiceAgent.Ui.Views"
             xmlns:services="using:SmartVoiceAgent.Ui.Services"
             x:Class="SmartVoiceAgent.Ui.Views.InboxView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- Inbox row (.inbox-item): risk badge, what waits and where, then the actions on the right.
             Below 760 px the actions move under the text. -->
        <Style Selector="Grid.InboxItem > StackPanel.InboxActions">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="StackPanel.WorkbenchPage.narrow Grid.InboxItem > StackPanel.InboxActions">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- The panel border closes the last row -->
        <Style Selector="ItemsControl > ContentPresenter:nth-last-child(1) > Border.PaneRow">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <!-- Needs you: every tool call waiting for approval, across all tasks, answerable here -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage PageColumn List"
                    Classes.narrow="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsRailCompact}">

            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Inbox.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Inbox.Subtitle}" Classes="PageSubtitle"/>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel Classes="EmptyState">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!HasPendingApprovals"/>
                        <Binding Path="!HasPendingSkillConfirmations"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconCheck}"/></Viewbox>
                <TextBlock Text="{DynamicResource Lang.Inbox.Empty.Title}" Classes="EmptyTitle"/>
                <TextBlock Text="{DynamicResource Lang.Inbox.Empty.Body}" Classes="EmptyBody"/>
            </StackPanel>

            <!-- One panel; every waiting tool call is a row in it -->
            <Border Classes="Pane" IsVisible="{Binding HasPendingApprovals}">
                <Panel>
                    <ItemsControl ItemsSource="{Binding PendingApprovals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PendingApprovalItem">
                                <Border Classes="PaneRow">
                                    <Grid Classes="InboxItem" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <Border Grid.Column="0"
                                                Classes="Risk"
                                                Classes.Read="{Binding Step.IsReadRisk}"
                                                Classes.Write="{Binding Step.IsWriteRisk}"
                                                Classes.Shell="{Binding Step.IsShellRisk}"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                                ToolTip.Tip="{Binding Step.RiskText}">
                                            <TextBlock Text="{Binding Step.RiskTag}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Step.ToolDisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Session.Title}"
                                                           FontSize="12"
                                                           MaxWidth="360"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Step.ToolName}"
                                                           FontSize="12"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <Border Classes="ToolArguments" IsVisible="{Binding Step.HasArguments}" Margin="0,4,0,0">
                                                <!-- Four lines for most tools; a hand-off to another agent shows its whole brief, scrolling -->
                                                <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock Text="{Binding Step.ArgumentsPreview}"
                                                                         FontSize="12"
                                                                         FontFamily="{StaticResource MonoFontFamily}"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                                         TextWrapping="Wrap"
                                                                         MaxLines="{Binding Step.ArgumentsMaxLines}"/>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions (.acts) -->
                                        <StackPanel Classes="InboxActions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                            <Button Classes="SecondaryAction Sm"
                                                    Content="{DynamicResource Lang.Inbox.OpenTask}"
                                                    Command="{Binding $parent[local:InboxView].DataContext.OpenTaskCommand}"
                                                    CommandParameter="{Binding Session}"/>
                                            <Button Classes="GhostAction Sm"
                                                    Content="{DynamicResource Lang.Common.Deny}"
                                                    Command="{Binding $parent[local:InboxView].DataContext.DenyToolCallCommand}"
                                                    CommandParameter="{Binding Step}"/>
                                            <Button Classes="SecondaryAction Sm"
                                                    Content="{DynamicResource Lang.Common.AlwaysAllow}"
                                                    IsVisible="{Binding Step.CanAlwaysAllow}"
                                                    ToolTip.Tip="{Binding Step.AlwaysAllowHint}"
                                                    Command="{Binding $parent[local:InboxView].DataContext.AlwaysAllowToolCallCommand}"
                                                    CommandParameter="{Binding Step}"/>
                                            <Button Classes="PrimaryAction Sm"
                                                    Content="{DynamicResource Lang.Common.Approve}"
                                                    Command="{Binding $parent[local:InboxView].DataContext.ApproveToolCallCommand}"
                                                    CommandParameter="{Binding Step}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Border>

            <!-- Command mode (AgentRuntime:Enabled=false): skill previews waiting for a yes -->
            <Border Classes="Pane" IsVisible="{Binding HasPendingSkillConfirmations}">
                <StackPanel>
                    <Border Classes="PaneHead">
                        <TextBlock Text="{DynamicResource Lang.Activity.ApprovalNeeded}" Classes="SectionTitle" VerticalAlignment="Center"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding PendingSkillConfirmations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PendingSkillConfirmationViewModel">
                                <Border Classes="PaneRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding SkillId}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding UserCommand}"
                                                   Classes="Caption"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Reason}"
                                                   Classes="Caption"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <Border Grid.Row="3" Grid.ColumnSpan="2"
                                                Classes="ToolArguments"
                                                Margin="0,8,0,0"
                                                IsVisible="{Binding HasPreview}">
                                            <ScrollViewer MaxHeight="180"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding Preview}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11"
                                                           TextWrapping="NoWrap"/>
                                            </ScrollViewer>
                                        </Border>
                                        <StackPanel Grid.Column="1" Grid.RowSpan="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top"
                                                    Spacing="6">
                                            <Button Classes="SecondaryAction Sm"
                                                    Content="{DynamicResource Lang.Activity.Reject}"
                                                    Command="{Binding RejectCommand}"/>
                                            <Button Classes="PrimaryAction Sm"
                                                    Content="{DynamicResource Lang.Common.Approve}"
                                                    Command="{Binding ApproveCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
