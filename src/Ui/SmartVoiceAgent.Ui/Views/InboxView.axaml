<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels"
             xmlns:local="using:SmartVoiceAgent.Ui.Views"
             x:Class="SmartVoiceAgent.Ui.Views.InboxView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- The task title links to the task: plain RowTitle text that underlines on hover -->
        <Style Selector="Button.TaskLink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.TaskLink /template/ ContentPresenter#PART_ContentPresenter, Button.TaskLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.TaskLink:pointerover TextBlock">
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <!-- "Show all" under clamped arguments -->
        <Style Selector="ToggleButton.ShowAll">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.ShowAll:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ShowAll:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ShowAll:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/>
        </Style>

        <!-- The panel border closes the last row -->
        <Style Selector="ItemsControl > ContentPresenter:nth-last-child(1) > Border.PaneRow">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <!-- Needs you: every tool call waiting for approval, across all tasks, answerable here -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage PageColumn List">

            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Inbox.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Inbox.Subtitle}" Classes="PageSubtitle"/>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel Classes="EmptyState">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!HasPendingApprovals"/>
                        <Binding Path="!HasPendingSkillConfirmations"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconCheck}"/></Viewbox>
                <TextBlock Text="{DynamicResource Lang.Inbox.Empty.Title}" Classes="EmptyTitle"/>
                <TextBlock Text="{DynamicResource Lang.Inbox.Empty.Body}" Classes="EmptyBody"/>
            </StackPanel>

            <!-- One panel per waiting tool call: the task, what the call does, then the answer -->
            <ItemsControl ItemsSource="{Binding PendingApprovals}" IsVisible="{Binding HasPendingApprovals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PendingApprovalItem">
                        <Border Classes="Pane">
                            <StackPanel>
                                <!-- Head: the task (opens it) and when the call came in -->
                                <Border Classes="PaneHead">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Button Classes="TaskLink"
                                                AutomationProperties.Name="{DynamicResource Lang.Inbox.OpenTask}"
                                                ToolTip.Tip="{DynamicResource Lang.Inbox.OpenTask}"
                                                Command="{Binding $parent[local:InboxView].DataContext.OpenTaskCommand}"
                                                CommandParameter="{Binding Session}">
                                            <TextBlock Text="{Binding Session.Title}" Classes="RowTitle" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Step.TimeText}" Classes="Caption" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="16,12" Spacing="8">
                                    <!-- The tool and what it may do -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Step.ToolName}" Classes="Mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Classes="Risk"
                                                Classes.Read="{Binding Step.IsReadRisk}"
                                                Classes.Write="{Binding Step.IsWriteRisk}"
                                                Classes.Shell="{Binding Step.IsShellRisk}"
                                                ToolTip.Tip="{Binding Step.RiskText}">
                                            <TextBlock Text="{Binding Step.RiskTag}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Step.ToolDisplayName}" Classes="Secondary" TextTrimming="CharacterEllipsis"/>

                                    <!-- Arguments: four lines for most tools; a hand-off to another agent shows its whole brief, scrolling -->
                                    <StackPanel Spacing="6" IsVisible="{Binding Step.HasArguments}">
                                        <Border Classes="Code">
                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <Panel>
                                                    <SelectableTextBlock Text="{Binding Step.ArgumentsPreview}"
                                                                         MaxLines="{Binding Step.ArgumentsMaxLines}"
                                                                         IsVisible="{Binding !#ShowAllArguments.IsChecked}"/>
                                                    <SelectableTextBlock Text="{Binding Step.ArgumentsPreview}"
                                                                         IsVisible="{Binding #ShowAllArguments.IsChecked}"/>
                                                </Panel>
                                            </ScrollViewer>
                                        </Border>
                                        <ToggleButton x:Name="ShowAllArguments"
                                                      Classes="ShowAll"
                                                      IsVisible="{Binding Step.HasMoreArguments}">
                                            <Panel>
                                                <TextBlock Text="{DynamicResource Lang.Inbox.ShowAll}" IsVisible="{Binding !#ShowAllArguments.IsChecked}"/>
                                                <TextBlock Text="{DynamicResource Lang.Inbox.ShowLess}" IsVisible="{Binding #ShowAllArguments.IsChecked}"/>
                                            </Panel>
                                        </ToggleButton>
                                    </StackPanel>

                                    <!-- The answer, right-aligned -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Classes="GhostAction Sm"
                                                Content="{DynamicResource Lang.Common.Deny}"
                                                Command="{Binding $parent[local:InboxView].DataContext.DenyToolCallCommand}"
                                                CommandParameter="{Binding Step}"/>
                                        <Button Classes="SecondaryAction Sm"
                                                Content="{DynamicResource Lang.Common.AlwaysAllow}"
                                                IsVisible="{Binding Step.CanAlwaysAllow}"
                                                ToolTip.Tip="{Binding Step.AlwaysAllowHint}"
                                                Command="{Binding $parent[local:InboxView].DataContext.AlwaysAllowToolCallCommand}"
                                                CommandParameter="{Binding Step}"/>
                                        <Button Classes="PrimaryAction Sm"
                                                Content="{DynamicResource Lang.Inbox.Allow}"
                                                Command="{Binding $parent[local:InboxView].DataContext.ApproveToolCallCommand}"
                                                CommandParameter="{Binding Step}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Command mode (AgentRuntime:Enabled=false): skill previews waiting for a yes -->
            <Border Classes="Pane" IsVisible="{Binding HasPendingSkillConfirmations}">
                <StackPanel>
                    <Border Classes="PaneHead">
                        <TextBlock Text="{DynamicResource Lang.Activity.ApprovalNeeded}" Classes="SectionTitle" VerticalAlignment="Center"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding PendingSkillConfirmations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PendingSkillConfirmationViewModel">
                                <Border Classes="PaneRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding SkillId}"
                                                   Classes="RowTitle Mono"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding UserCommand}"
                                                   Classes="Secondary"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Reason}"
                                                   Classes="Secondary"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <Border Grid.Row="3" Grid.ColumnSpan="2"
                                                Classes="Code"
                                                Margin="0,8,0,0"
                                                IsVisible="{Binding HasPreview}">
                                            <ScrollViewer MaxHeight="180"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding Preview}"
                                                           TextWrapping="NoWrap"/>
                                            </ScrollViewer>
                                        </Border>
                                        <StackPanel Grid.Column="1" Grid.RowSpan="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top"
                                                    Spacing="8">
                                            <Button Classes="GhostAction Sm"
                                                    Content="{DynamicResource Lang.Activity.Reject}"
                                                    Command="{Binding RejectCommand}"/>
                                            <Button Classes="PrimaryAction Sm"
                                                    Content="{DynamicResource Lang.Common.Approve}"
                                                    Command="{Binding ApproveCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
