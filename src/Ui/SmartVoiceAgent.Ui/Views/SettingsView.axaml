<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
             xmlns:services="clr-namespace:SmartVoiceAgent.Ui.Services"
             x:Class="SmartVoiceAgent.Ui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Settings Section Card -->
        <Style Selector="Border.SettingsCard">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Settings Item -->
        <Style Selector="Border.SettingsItem">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage" Margin="32,28,32,40" MaxWidth="760" HorizontalAlignment="Center">

            <!-- Title Section -->
            <StackPanel Spacing="6" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Lang.Settings.Title}"
                           Classes="PageTitle"/>
                <TextBlock Text="{DynamicResource Lang.Settings.Subtitle}"
                           Classes="PageSubtitle"/>
            </StackPanel>

            <!-- General Section -->
            <StackPanel Spacing="8" Margin="0,8,0,8">
                <TextBlock Text="{DynamicResource Lang.Settings.Appearance}"
                           Classes="Overline"
                           Margin="4,0,0,4"/>

                <!-- Startup Behavior -->
                <Border Classes="SettingsItem">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                            <Path Data="M16.56,5.44L15,7L16.8,8.8C14.14,10.65 12.54,13.42 12.54,16.64C12.54,19.86 14.14,22.63 16.8,24.48L15,26.28L16.56,27.84L20.44,23.96C21.5,22.9 22.28,21.56 22.7,20.04L25.22,17.5L22.22,14.5L24.72,12H22.22L20.44,13.8L16.56,9.92L20.44,6.04L16.56,2.16L15,3.72L18.28,7L16.56,5.44M8.5,12C9.33,12 10,12.67 10,13.5C10,14.33 9.33,15 8.5,15C7.67,15 7,14.33 7,13.5C7,12.67 7.67,12 8.5,12M8.5,17C9.33,17 10,17.67 10,18.5C10,19.33 9.33,20 8.5,20C7.67,20 7,19.33 7,18.5C7,17.67 7.67,17 8.5,17M3,12V20C3,21.11 3.89,22 5,22H11V20H5V12H3M19,2H5C3.89,2 3,2.89 3,4V8H5V4H19V8H21V4C21,2.89 20.11,2 19,2M21,12H19V20H21V12Z"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.Settings.Startup}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.StartupDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Toggle Switch -->
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding ShowOnStartup, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Auto Start with Windows -->
                <Border Classes="SettingsItem">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                            <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C13.4,7 14.8,8.1 14.8,9.5V11C15.4,11 16,11.6 16,12.3V15.8C16,16.4 15.4,17 14.7,17H9.2C8.6,17 8,16.4 8,15.7V12.2C8,11.6 8.6,11 9.2,11V9.5C9.2,8.1 10.6,7 12,7M12,8.2C11.2,8.2 10.5,8.7 10.5,9.5V11H13.5V9.5C13.5,8.7 12.8,8.2 12,8.2Z"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.Settings.AutoStart}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.AutoStartDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Start Minimized -->
                <Border Classes="SettingsItem">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                            <Path Data="M4,4H20V18H4V4M6,8V16H18V8H6M8,10H16V14H8V10M2,20H22V22H2V20"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.Settings.StartMinimized}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.StartMinimizedDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- AI Runtime Section -->
            <StackPanel Spacing="8" Margin="0,8,0,8">
                <TextBlock Text="{DynamicResource Lang.Settings.AiRuntime}"
                           Classes="Overline"
                           Margin="4,0,0,4"/>

                <Border Classes="SettingsItem">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M7,13H11V17H13V13H17V11H13V7H11V11H7V13Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.PlannerModel}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ActivePlannerProfileId}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Provider}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding AiProviders}"
                                          SelectedItem="{Binding AiProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Model}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Grid ColumnDefinitions="*, Auto"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding IsPlannerModelCatalogBacked}">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AiModelOptions}"
                                              SelectedItem="{Binding AiModelId, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshAiModelsCommand}"
                                            IsEnabled="{Binding !IsRefreshingAiModels}"
                                            Classes="SecondaryAction"
                                            Padding="12,8">
                                        <TextBlock Text="{DynamicResource Lang.Common.Refresh}" FontSize="12" FontWeight="Medium"/>
                                    </Button>
                                </Grid>
                                <TextBox Text="{Binding AiModelId, Mode=TwoWay}"
                                         IsVisible="{Binding !IsPlannerModelCatalogBacked}"
                                         PlaceholderText="custom/model-id"/>
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  ColumnDefinitions="*, Auto"
                                  RowDefinitions="Auto, Auto, Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="6">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{DynamicResource Lang.Settings.ApiKey}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="0"
                                         Text="{Binding AiApiKey, Mode=TwoWay}"
                                         PasswordChar="*"
                                         PlaceholderText="sk-..."/>
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Command="{Binding TestAiConnectionCommand}"
                                        IsEnabled="{Binding !IsTestingAiConnection}"
                                        Classes="SecondaryAction"
                                        MinWidth="180"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="16,9">
                                    <TextBlock Text="{Binding AiConnectionTestButtonText}" FontSize="12" FontWeight="Medium"/>
                                </Button>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding MaskedAiApiKey}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *" Margin="0,8,0,0">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M12,3C7.03,3 3,6.58 3,11C3,13.39 4.18,15.54 6.06,17L5,21L9.3,18.86C10.15,19.05 11.06,19 12,19C16.97,19 21,15.42 21,11C21,6.58 16.97,3 12,3Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.ChatModel}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ActiveChatProfileId}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Provider}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding AiProviders}"
                                          SelectedItem="{Binding ChatProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Model}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Grid ColumnDefinitions="*, Auto"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding IsChatModelCatalogBacked}">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ChatModelOptions}"
                                              SelectedItem="{Binding ChatModelId, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshChatModelsCommand}"
                                            IsEnabled="{Binding !IsRefreshingChatModels}"
                                            Classes="SecondaryAction"
                                            Padding="12,8">
                                        <TextBlock Text="{DynamicResource Lang.Common.Refresh}" FontSize="12" FontWeight="Medium"/>
                                    </Button>
                                </Grid>
                                <TextBox Text="{Binding ChatModelId, Mode=TwoWay}"
                                         IsVisible="{Binding !IsChatModelCatalogBacked}"
                                         PlaceholderText="custom/model-id"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.ApiKey}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Text="{Binding ChatApiKey, Mode=TwoWay}"
                                         PasswordChar="*"
                                         PlaceholderText="sk-..."/>
                                <TextBlock Text="{Binding MaskedChatApiKey}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding AiProfileStatus}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Voice Settings Section -->
            <StackPanel Spacing="8" Margin="0,8,0,8">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Lang.Settings.Voice.Section}"
                               Classes="Overline"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding RefreshDevicesCommand}"
                            Background="Transparent"
                            Padding="8"
                            ToolTip.Tip="{DynamicResource Lang.Settings.Voice.RefreshDevices}">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource TextMutedBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Audio Error Message -->
                <Border Background="{DynamicResource AccentErrorGlowBrush}"
                        CornerRadius="8"
                        Padding="12,10"
                        IsVisible="{Binding AudioErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z M13,17h-2v-2h2v2z M13,13h-2V7h2v6z"
                              Fill="{DynamicResource AccentErrorBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"/>
                        <TextBlock Text="{Binding AudioErrorMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentErrorBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Speech Recognition -->
                <Border Classes="SettingsItem">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M9,5A4,4 0 0,1 13,9A4,4 0 0,1 9,13A4,4 0 0,1 5,9A4,4 0 0,1 9,5M9,15C11.67,15 17,16.34 17,19V21H1V19C1,16.34 6.33,15 9,15M16.76,5.36C18.78,7.56 18.78,10.61 16.76,12.63L15.08,10.94C15.92,9.76 15.92,8.23 15.08,7.05L16.76,5.36M20.07,2C24,6.05 23.97,12.11 20.07,16L18.44,14.37C21.21,11.19 21.21,6.65 18.44,3.63L20.07,2Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.Recognition}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.RecognitionDesc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.SpokenLanguage}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding VoiceLanguageOptions}"
                                          SelectedItem="{Binding SelectedVoiceLanguage, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.Engine}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding SpeechEngineOptions}"
                                          SelectedItem="{Binding SelectedSpeechEngine, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Local Whisper model -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsLocalSpeechEngine}">
                            <TextBlock Text="{DynamicResource Lang.Settings.Model}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding LocalSpeechModelOptions}"
                                          SelectedItem="{Binding SelectedLocalSpeechModel, Mode=TwoWay}"
                                          IsEnabled="{Binding !IsDownloadingSpeechModel}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Hint}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Command="{Binding DownloadSpeechModelCommand}"
                                        IsEnabled="{Binding CanDownloadSpeechModel}"
                                        Classes="SecondaryAction"
                                        Padding="12,8">
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.Model.Download}" FontSize="12" FontWeight="Medium"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding SpeechModelStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*, Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding IsDownloadingSpeechModel}">
                                <ProgressBar Grid.Column="0"
                                             Value="{Binding SpeechModelDownloadProgress, Mode=OneWay}"
                                             Minimum="0"
                                             Maximum="1"
                                             Height="6"
                                             CornerRadius="3"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SpeechModelDownloadPercent}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           MinWidth="36"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding SpeechModelDownloadError}"
                                       IsVisible="{Binding HasSpeechModelDownloadError}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentErrorBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.Voice.Model.Note}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- OpenAI-compatible transcription API -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsApiSpeechEngine}">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.Api.Endpoint}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding SpeechApiEndpoint, Mode=TwoWay}"
                                             PlaceholderText="https://api.openai.com/v1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{DynamicResource Lang.Settings.Model}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding SpeechApiModel, Mode=TwoWay}"
                                             PlaceholderText="whisper-1"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.ApiKey}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Text="{Binding SpeechApiKey, Mode=TwoWay}"
                                         PasswordChar="*"
                                         PlaceholderText="sk-..."/>
                                <TextBlock Text="{Binding MaskedSpeechApiKey}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Lang.Settings.Voice.Api.Note}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Microphone -->
                <Border Classes="SettingsItem">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.Microphone}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicrophoneDesc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <ComboBox ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice}"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding HasInputDevices}"
                                  ToolTip.Tip="{DynamicResource Lang.Settings.Voice.MicrophoneTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Background="{DynamicResource CardBgHoverBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding !HasInputDevices}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.NoMicrophones}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Input volume, with the live level under the slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path Classes="Icon" Data="{StaticResource IconMic}" Stroke="{DynamicResource TextMutedBrush}"/>
                                </Viewbox>
                                <Slider Grid.Column="1"
                                        Value="{Binding InputVolume, Mode=TwoWay}"
                                        Minimum="0" Maximum="1"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{DynamicResource Lang.Settings.Voice.InputVolumeTip}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding InputVolume, StringFormat='{}{0:P0}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Width="35"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                            <ProgressBar Value="{Binding InputLevel, Mode=OneWay}"
                                         Maximum="1"
                                         Height="4"
                                         MinHeight="4"
                                         CornerRadius="2"
                                         Margin="22,0,43,0">
                                <ProgressBar.Styles>
                                    <Style Selector="ProgressBar">
                                        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                    </Style>
                                </ProgressBar.Styles>
                            </ProgressBar>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

                        <!-- Mic test -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicTest}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicTestDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding StartMicTestCommand}"
                                    IsEnabled="{Binding !IsRecordingTest}"
                                    Classes="PrimaryAction"
                                    Padding="16,8"
                                    ToolTip.Tip="{DynamicResource Lang.Settings.Voice.MicTest.StartTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="14" Height="14">
                                        <Path Classes="Icon" Data="{StaticResource IconMic}" Fill="Transparent" Stroke="{DynamicResource AccentOnBrush}"/>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicTest.Start}" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding StopMicTestCommand}"
                                    IsEnabled="{Binding IsRecordingTest}"
                                    Classes="SecondaryAction"
                                    Padding="16,8"
                                    ToolTip.Tip="{DynamicResource Lang.Settings.Voice.MicTest.StopTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="12" Height="12">
                                        <Path Classes="Icon" Data="{StaticResource IconStop}"/>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicTest.Stop}" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding PlayTestRecordingCommand}"
                                    IsEnabled="{Binding HasTestRecording}"
                                    Classes="SecondaryAction"
                                    Padding="16,8"
                                    IsVisible="{Binding HasTestRecording}"
                                    ToolTip.Tip="{DynamicResource Lang.Settings.Voice.MicTest.PlayTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"/>
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicTest.Play}" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Recording status -->
                        <Border Background="{DynamicResource AccentErrorGlowBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding IsRecordingTest}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8"
                                        Background="{DynamicResource AccentErrorBrush}"
                                        CornerRadius="4">
                                    <Border.Styles>
                                        <Style Selector="Border">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="50%">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Border.Styles>
                                </Border>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.MicTest.Recording}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentErrorBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Hands-free -->
                <Border Classes="SettingsItem">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M4.93,4.93C3.12,6.74 2,9.24 2,12C2,14.76 3.12,17.26 4.93,19.07L6.34,17.66C4.89,16.22 4,14.22 4,12C4,9.79 4.89,7.78 6.34,6.34L4.93,4.93M19.07,4.93L17.66,6.34C19.11,7.78 20,9.79 20,12C20,14.22 19.11,16.22 17.66,17.66L19.07,19.07C20.88,17.26 22,14.76 22,12C22,9.24 20.88,6.74 19.07,4.93M7.76,7.76C6.67,8.85 6,10.35 6,12C6,13.65 6.67,15.15 7.76,16.24L9.17,14.83C8.45,14.11 8,13.11 8,12C8,10.89 8.45,9.89 9.17,9.17L7.76,7.76M16.24,7.76L14.83,9.17C15.55,9.89 16,10.89 16,12C16,13.11 15.55,14.11 14.83,14.83L16.24,16.24C17.33,15.15 18,13.65 18,12C18,10.35 17.33,8.85 16.24,7.76M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.HandsFree}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.HandsFreeDesc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Wake phrase -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.WakeWord}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.WakeWordDesc}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding WakeWordEnabled, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                        <TextBox Text="{Binding WakeWord, Mode=TwoWay}"
                                 IsEnabled="{Binding WakeWordEnabled}"
                                 PlaceholderText="Hey Kam"/>
                        <TextBlock Text="{Binding WakeWordNote}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

                        <!-- Talk shortcut -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Lang.Settings.Voice.Shortcut}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding TalkShortcutOptions}"
                                      SelectedItem="{Binding SelectedTalkShortcut, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Lang.Settings.Voice.Shortcut.Note}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Spoken replies -->
                <Border Classes="SettingsItem">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.SpokenReplies}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.SpokenRepliesDesc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.SpokenReplies.Mode}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding SpokenRepliesOptions}"
                                          SelectedItem="{Binding SelectedSpokenReplies, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.Voice}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding SpeechVoiceOptions}"
                                          SelectedItem="{Binding SelectedSpeechVoice, Mode=TwoWay}"
                                          IsEnabled="{Binding CanUseSpeechOutput}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Speaking rate -->
                        <StackPanel Spacing="6" IsEnabled="{Binding CanUseSpeechOutput}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Lang.Settings.Voice.Rate}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SpeechRateText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Lang.Settings.Voice.Rate.Slower}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        Value="{Binding SpeechRate, Mode=TwoWay}"
                                        Minimum="-5"
                                        Maximum="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{DynamicResource Lang.Settings.Voice.Rate.Faster}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding PreviewSpeechCommand}"
                                    IsEnabled="{Binding CanPreviewSpeech}"
                                    Classes="SecondaryAction"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"/>
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.Preview}" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopSpeechPreviewCommand}"
                                    IsEnabled="{Binding IsPreviewingSpeech}"
                                    Classes="SecondaryAction"
                                    Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Data="M6,6H18V18H6V6Z"
                                          Fill="{DynamicResource TextSecondaryBrush}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"/>
                                    <TextBlock Text="{DynamicResource Lang.Settings.Voice.Preview.Stop}" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding SpeechOutputProblem}"
                                   IsVisible="{Binding HasSpeechOutputProblem}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

                        <!-- Output device -->
                        <TextBlock Text="{DynamicResource Lang.Settings.Voice.Output}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SelectedOutputDevice}"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding HasOutputDevices}"
                                  ToolTip.Tip="{DynamicResource Lang.Settings.Voice.OutputTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Background="{DynamicResource CardBgHoverBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding !HasOutputDevices}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.Voice.NoOutputs}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Path Grid.Column="0"
                                  Data="M3,9V15H7L12,20V4L7,9H3Z"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding OutputVolume, Mode=TwoWay}"
                                    Minimum="0" Maximum="1"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{DynamicResource Lang.Settings.Voice.OutputVolumeTip}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding OutputVolume, StringFormat='{}{0:P0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Width="35"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Interface Section -->
            <StackPanel Spacing="8" Margin="0,8,0,8">
                <TextBlock Text="{DynamicResource Lang.Settings.Interface}"
                           Classes="Overline"
                           Margin="4,0,0,4"/>

                <!-- Reduced Motion -->
                <Border Classes="SettingsItem">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                            <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.Settings.ReducedMotion}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.ReducedMotionDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=ReducedMotion, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Language Selector -->
                <Border Classes="SettingsItem">
                    <Grid RowDefinitions="Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                                <Path Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang.Settings.Language}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Settings.LanguageDesc}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- System Section -->
            <StackPanel Spacing="8" Margin="0,8,0,8">
                <TextBlock Text="{DynamicResource Lang.Settings.System}"
                           Classes="Overline"
                           Margin="4,0,0,4"/>

                <Border Classes="SettingsItem">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                            <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.Settings.RuntimeVersion}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.Settings.RuntimeVersionValue}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Lang.Settings.About}"
                           Classes="Overline"
                           Margin="4,0,0,4"/>

                <Border Classes="SettingsItem">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0" Classes="IconBadge" Margin="0,0,16,0">
                            <Path Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                  Width="16" Height="16"
                                  Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lang.App.Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Lang.App.Description}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
