<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             xmlns:converters="clr-namespace:SmartVoiceAgent.Ui.Converters"
             x:Class="SmartVoiceAgent.Ui.Views.PluginsView"
             x:DataType="vm:PluginsViewModel">

    <UserControl.Resources>
        <converters:IconResourceConverter x:Key="IconResource"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Rows and groups the search hides take no space, including the list spacing around them -->
        <Style Selector="ItemsControl.SkillRows > ContentPresenter" x:DataType="vm:PluginItem">
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
        </Style>
        <Style Selector="ItemsControl.SkillGroups > ContentPresenter" x:DataType="vm:SkillGroupViewModel">
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
        </Style>

        <!-- Narrow pages (the code-behind sets "narrow"): search under the filters -->
        <Style Selector="TextBox.SkillSearch">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.narrow TextBox.SkillSearch">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <!-- Narrow pages: eval actions under the status, the import source on its own line, status shown by its dot -->
        <Style Selector="StackPanel.EvalActions">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.narrow StackPanel.EvalActions">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="-10,6,0,0"/>
        </Style>
        <Style Selector="ComboBox.ImportSource">
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style Selector="StackPanel.narrow ComboBox.ImportSource">
            <Setter Property="Grid.ColumnSpan" Value="4"/>
            <Setter Property="Width" Value="NaN"/>
        </Style>
        <Style Selector="TextBox.ImportPath">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="StackPanel.narrow TextBox.ImportPath">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.narrow Button.ImportAction">
            <Setter Property="Grid.Row" Value="1"/>
        </Style>
        <Style Selector="StackPanel.narrow TextBlock.StatusText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- The row's icon, name and status open its details -->
        <Style Selector="Button.RowHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.RowHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.RowHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.ListRow.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
        </Style>
        <Style Selector="Border.ListRow.Selected TextBlock.RowText">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Viewbox.Chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ListRow.Selected Viewbox.Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>

        <!-- Skills that are off keep a quiet icon -->
        <Style Selector="Border.KindIcon.Off">
            <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
        </Style>
        <Style Selector="Border.KindIcon.Off Path.Icon">
            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="TextBlock.SkillId">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.StatusText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.DetailLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.DetailText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.DetailMono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.DetailDivider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style Selector="Button.QuickFix">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Classes="WorkbenchPage" Margin="32,28,32,40" MaxWidth="900" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Lang.Skills.Title}" Classes="PageTitle"/>
                <TextBlock Text="{DynamicResource Lang.Skills.Subtitle}" Classes="PageSubtitle"/>
            </StackPanel>

            <!-- Evals and the result of the last action -->
            <Border Classes="Surface" Padding="14,10">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Border Classes="StatusDot"
                                Classes.Success="{Binding IsSkillEvalHealthy}"
                                Classes.Warning="{Binding !IsSkillEvalHealthy}"
                                VerticalAlignment="Top"
                                Margin="0,6,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SkillEvalStatus}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SkillEvalDetail}"
                                       Classes="Caption"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Classes="EvalActions" Orientation="Horizontal" Spacing="2">
                            <Button Classes="GhostAction"
                                    IsVisible="{Binding HasSkillEvalResults}"
                                    Command="{Binding ToggleEvalResultsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{DynamicResource Lang.Skills.Eval.ShowResults}" FontSize="12" IsVisible="{Binding !ShowEvalResults}"/>
                                    <TextBlock Text="{DynamicResource Lang.Skills.Eval.HideResults}" FontSize="12" IsVisible="{Binding ShowEvalResults}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="GhostAction"
                                    ToolTip.Tip="{DynamicResource Lang.Skills.Eval.RunTip}"
                                    Command="{Binding RunSkillEvalCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="13" Height="13"><Path Classes="Icon" Data="{StaticResource IconPlay}"/></Viewbox>
                                    <TextBlock Text="{DynamicResource Lang.Skills.Eval.Run}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SkillEvalResults}"
                                  IsVisible="{Binding ShowEvalResults}"
                                  Margin="17,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillEvalResultItem">
                                <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                                    <TextBlock Text="{Binding StatusText}"
                                               Classes="DetailMono"
                                               Foreground="{Binding StatusColor}"
                                               TextWrapping="NoWrap"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SkillId}" Classes="SkillId"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExpectedActualText}" Classes="DetailMono"/>
                                        <TextBlock Text="{Binding DetailText}" Classes="DetailMono" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Filters and search -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                    <Button Classes="Chip" Classes.Selected="{Binding IsFilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="All">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{DynamicResource Lang.Skills.Filter.All}"/>
                            <TextBlock Text="{Binding SkillCount}" Classes="ChipCount"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="Chip" Classes.Selected="{Binding IsFilterOn}" Command="{Binding SetFilterCommand}" CommandParameter="On">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{DynamicResource Lang.Skills.Filter.On}"/>
                            <TextBlock Text="{Binding OnCount}" Classes="ChipCount"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="Chip" Classes.Selected="{Binding IsFilterAttention}" Command="{Binding SetFilterCommand}" CommandParameter="Attention" IsVisible="{Binding HasAttention}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="StatusDot Warning"/>
                            <TextBlock Text="{DynamicResource Lang.Skills.Filter.Attention}"/>
                            <TextBlock Text="{Binding AttentionCount}" Classes="ChipCount"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="Chip" Classes.Selected="{Binding IsFilterOff}" Command="{Binding SetFilterCommand}" CommandParameter="Off">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{DynamicResource Lang.Skills.Filter.Off}"/>
                            <TextBlock Text="{Binding OffCount}" Classes="ChipCount"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBox Classes="SkillSearch"
                         Text="{Binding SearchText}"
                         PlaceholderText="{DynamicResource Lang.Skills.Search.Placeholder}">
                    <TextBox.InnerLeftContent>
                        <Viewbox Width="14" Height="14" Margin="10,0,0,0">
                            <Path Classes="Icon Muted" Data="{StaticResource IconSearch}"/>
                        </Viewbox>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>

            <!-- Nothing matches -->
            <Border Classes="WorkbenchSection" Padding="32,28" IsVisible="{Binding HasNoMatches}">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="380">
                    <Border Classes="IconBadge" HorizontalAlignment="Center">
                        <Viewbox><Path Classes="Icon" Data="{StaticResource IconSearch}"/></Viewbox>
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Lang.Skills.NoMatches.Title}" Classes="SectionTitle" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NoMatchesText}" Classes="Caption" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Skills by group -->
            <ItemsControl Classes="SkillGroups" ItemsSource="{Binding Groups}" IsVisible="{Binding !HasNoMatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="22"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillGroupViewModel">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" Classes="GroupTitle"/>
                                <TextBlock Text="{Binding VisibleCount}" Classes="GroupCount"/>
                            </StackPanel>

                            <ItemsControl Classes="SkillRows" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginItem">
                                        <Border Classes="ListRow" Classes.Selected="{Binding IsSelected}">
                                            <StackPanel>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <Button Classes="RowHeader"
                                                            Command="{Binding SelectCommand}"
                                                            ToolTip.Tip="{DynamicResource Lang.Skills.Card.Details}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Classes="KindIcon" Classes.Off="{Binding IsOff}" VerticalAlignment="Center">
                                                                <Viewbox><Path Classes="Icon" Data="{Binding IconKey, Converter={StaticResource IconResource}}"/></Viewbox>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding Name}" Classes="RowTitle" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SkillId}" Classes="SkillId"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Summary}" Classes="RowText"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Classes="StatusDot"
                                                                        Classes.Success="{Binding IsActive}"
                                                                        Classes.Warning="{Binding NeedsAttention}"
                                                                        ToolTip.Tip="{Binding Status}"/>
                                                                <TextBlock Text="{Binding Status}" Classes="StatusText"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasQuickFix}">
                                                        <Button Classes="SecondaryAction QuickFix"
                                                                IsVisible="{Binding CanApproveReview}"
                                                                Command="{Binding ApproveReviewCommand}"
                                                                Content="{DynamicResource Lang.Skills.Card.Approve}"
                                                                ToolTip.Tip="{DynamicResource Lang.Skills.Card.ApproveReview}"/>
                                                        <Button Classes="SecondaryAction QuickFix"
                                                                IsVisible="{Binding CanGrantPermissions}"
                                                                Command="{Binding GrantPermissionsCommand}"
                                                                Content="{DynamicResource Lang.Skills.Card.Grant}"
                                                                ToolTip.Tip="{DynamicResource Lang.Skills.Card.GrantPermissions}"/>
                                                    </StackPanel>

                                                    <ToggleSwitch Grid.Column="2"
                                                                  Classes="RowToggle"
                                                                  IsChecked="{Binding IsOn}"
                                                                  IsVisible="{Binding CanToggle}"
                                                                  ToolTip.Tip="{DynamicResource Lang.Skills.Card.Toggle}"/>

                                                    <Button Grid.Column="3"
                                                            Classes="IconButton"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding SelectCommand}"
                                                            ToolTip.Tip="{DynamicResource Lang.Skills.Card.Details}">
                                                        <Viewbox Classes="Chevron" Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconChevronDown}"/></Viewbox>
                                                    </Button>
                                                </Grid>

                                                <!-- Details -->
                                                <StackPanel IsVisible="{Binding IsSelected}" Margin="44,12,0,2" Spacing="10">
                                                    <TextBlock Text="{Binding Description}" Classes="DetailText" IsVisible="{Binding ShowsDescriptionInDetails}"/>
                                                    <TextBlock Text="{Binding MissingPermissionsText}" Classes="ErrorText" IsVisible="{Binding HasMissingPermissions}"/>

                                                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                        <Border Classes="Pill"><TextBlock Text="{Binding SourceText}"/></Border>
                                                        <Border Classes="Pill"><TextBlock Text="{Binding ExecutorText}"/></Border>
                                                        <Border Classes="Pill"><TextBlock Text="{Binding RiskLevelText}"/></Border>
                                                        <Border Classes="Pill"><TextBlock Text="{Binding RequiredPermissionsText}"/></Border>
                                                        <Border Classes="Pill"><TextBlock Text="{Binding GrantedPermissionsText}"/></Border>
                                                        <Border Classes="Pill Accent" IsVisible="{Binding HasEvalResult}"><TextBlock Text="{Binding LastEvalStatus}"/></Border>
                                                    </WrapPanel>

                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding LastRunStatus}"
                                                                   Classes="DetailMono"
                                                                   Foreground="{Binding LastRunColor}"
                                                                   IsVisible="{Binding HasLastRun}"/>
                                                        <TextBlock Text="{Binding LastRunDetail}" Classes="DetailMono" IsVisible="{Binding HasLastRun}"/>
                                                        <TextBlock Text="{DynamicResource Lang.Skills.Detail.LastRunNone}" Classes="DetailMono" IsVisible="{Binding !HasLastRun}"/>
                                                        <TextBlock Text="{Binding HealthMetricsText}" Classes="DetailMono" IsVisible="{Binding HasHealthMetrics}"/>
                                                        <TextBlock Text="{Binding FailureMetricsText}" Classes="ErrorText" FontSize="11" IsVisible="{Binding HasFailureMetrics}"/>
                                                        <TextBlock Text="{Binding LastEvalDetail}" Classes="DetailMono" IsVisible="{Binding HasEvalResult}"/>
                                                        <TextBlock Text="{Binding ChecksumText}" Classes="DetailMono"/>
                                                        <TextBlock Text="{Binding PolicyGuardrailText}" Classes="DetailMono"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4" IsVisible="{Binding HasExecutionHistory}">
                                                        <TextBlock Text="{DynamicResource Lang.Skills.Detail.ExecutionHistory}" Classes="DetailLabel"/>
                                                        <ItemsControl ItemsSource="{Binding ExecutionHistory}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SkillExecutionHistoryItem">
                                                                    <Grid ColumnDefinitions="136,128,*" ColumnSpacing="8" Margin="0,1">
                                                                        <TextBlock Text="{Binding TimestampText}" Classes="DetailMono" TextWrapping="NoWrap"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding StatusText}"
                                                                                   Classes="DetailMono"
                                                                                   Foreground="{Binding StatusColor}"
                                                                                   TextWrapping="NoWrap"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding DetailText}" Classes="DetailMono" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="170,*,Auto"
                                                          ColumnSpacing="8"
                                                          IsVisible="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).CanEditSelectedSkillPolicy}">
                                                        <TextBox Text="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).PolicyOptionKeyInput}"
                                                                 PlaceholderText="{DynamicResource Lang.Skills.Policy.KeyPlaceholder}"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).PolicyOptionValueInput}"
                                                                 PlaceholderText="{DynamicResource Lang.Skills.Policy.ValuePlaceholder}"/>
                                                        <Button Grid.Column="2"
                                                                Classes="IconAction"
                                                                Command="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).SaveRuntimePolicyOptionCommand}"
                                                                ToolTip.Tip="{DynamicResource Lang.Skills.Policy.SaveTip}">
                                                            <Viewbox Width="14" Height="14"><Path Classes="Icon Accent" Data="{StaticResource IconCheck}"/></Viewbox>
                                                        </Button>
                                                    </Grid>

                                                    <Border Classes="DetailDivider" IsVisible="{Binding HasDetailActions}"/>
                                                    <WrapPanel ItemSpacing="4" LineSpacing="4" IsVisible="{Binding HasDetailActions}">
                                                        <Button Classes="GhostAction" IsVisible="{Binding CanTestSkill}" Command="{Binding TestSkillCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Viewbox Width="13" Height="13"><Path Classes="Icon" Data="{StaticResource IconPlay}"/></Viewbox>
                                                                <TextBlock Text="{DynamicResource Lang.Skills.Test.Tip}" FontSize="12"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Classes="GhostAction" IsVisible="{Binding CanRevokePermissions}" Command="{Binding RevokePermissionsCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Viewbox Width="13" Height="13"><Path Classes="Icon" Data="{StaticResource IconShieldOff}"/></Viewbox>
                                                                <TextBlock Text="{DynamicResource Lang.Skills.Card.RevokePermissions}" FontSize="12"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Import -->
            <Border Classes="WorkbenchSection">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Lang.Skills.Import.Title}" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding ImportStatus}" Classes="Caption"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <ComboBox Classes="ImportSource"
                                  ItemsSource="{Binding ImportSources}"
                                  SelectedIndex="{Binding SelectedImportSourceIndex}"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="36"/>
                        <TextBox Classes="ImportPath"
                                 Text="{Binding ImportLocation}"
                                 PlaceholderText="{DynamicResource Lang.Skills.Import.Placeholder}"
                                 MinHeight="36"/>
                        <Button Grid.Column="2"
                                Classes="SecondaryAction ImportAction"
                                Content="{DynamicResource Lang.Common.Browse}"
                                Command="{Binding BrowseImportFolderCommand}"/>
                        <Button Grid.Column="3"
                                Classes="PrimaryAction ImportAction"
                                Content="{DynamicResource Lang.Skills.Import.Button}"
                                Command="{Binding ImportSkillCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
