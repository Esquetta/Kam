<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             xmlns:services="clr-namespace:SmartVoiceAgent.Ui.Services"
             xmlns:converters="clr-namespace:SmartVoiceAgent.Ui.Converters"
             x:Class="SmartVoiceAgent.Ui.Views.PluginsView"
             x:DataType="vm:PluginsViewModel">

    <UserControl.Resources>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Plugin Card Style -->
        <Style Selector="Border.PluginCard">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="300"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.PluginCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
        </Style>

        <!-- Inactive Plugin Card -->
        <Style Selector="Border.PluginCardInactive">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="300"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.PluginCardInactive:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
        </Style>

        <!-- Add Plugin Card -->
        <Style Selector="Border.AddPluginCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.AddPluginCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
        </Style>

        <!-- Status Badge Active -->
        <Style Selector="Border.StatusActive">
            <Setter Property="Background" Value="{DynamicResource AccentGreenGlowBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <!-- Status Badge Inactive -->
        <Style Selector="Border.StatusInactive">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <Style Selector="Border.EvalSummary">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style Selector="Border.EvalHealthy">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style Selector="Border.EvalUnhealthy">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentOrangeGlowBrush}"/>
        </Style>

        <Style Selector="Border.ImportPanel">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Classes="WorkbenchPage" RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="32,28,32,40">

            <!-- Title Section -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="8,0,8,24">
                <TextBlock Text="{DynamicResource Lang.Skills.Title}"
                           Classes="PageTitle"/>
                <TextBlock Text="{DynamicResource Lang.Skills.Subtitle}"
                           Classes="PageSubtitle"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Classes="EvalSummary"
                    Classes.EvalHealthy="{Binding IsSkillEvalHealthy}"
                    Classes.EvalUnhealthy="{Binding !IsSkillEvalHealthy}"
                    Margin="8,0,8,20"
                    HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Ellipse Grid.Column="0"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Top"
                             Margin="0,4,0,0"
                             IsVisible="{Binding IsSkillEvalHealthy}"/>
                    <Ellipse Grid.Column="0"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource AccentOrangeBrush}"
                             VerticalAlignment="Top"
                             Margin="0,4,0,0"
                             IsVisible="{Binding !IsSkillEvalHealthy}"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding SkillEvalStatus}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SkillEvalDetail}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <ScrollViewer IsVisible="{Binding HasSkillEvalResults}"
                                      MaxHeight="132"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding SkillEvalResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="54,*,108"
                                              ColumnSpacing="8"
                                              Margin="0,2">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{Binding StatusColor}"
                                                       TextWrapping="NoWrap"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="10"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ExpectedActualText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DetailText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SkillId}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding RunSkillEvalCommand}"
                            Classes="IconButton"
                            ToolTip.Tip="{DynamicResource Lang.Skills.Eval.RunTip}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16"><Path Classes="Icon Accent" Data="{StaticResource IconPlay}"/></Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Classes="ImportPanel"
                    Margin="8,0,8,20"
                    HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="150,*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding ImportSources}"
                                  SelectedIndex="{Binding SelectedImportSourceIndex}"
                                  MinHeight="34"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ImportLocation}"
                                 PlaceholderText="{DynamicResource Lang.Skills.Import.Placeholder}"
                                 MinHeight="34"/>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Lang.Skills.Import.Button}"
                                Command="{Binding ImportSkillCommand}"
                                Classes="PrimaryAction"
                                MinHeight="34"
                                Padding="18,0"/>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding ImportStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Classes="ImportPanel"
                    IsVisible="{Binding HasSelectedPlugin}"
                    Margin="8,0,8,20"
                    HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{Binding SelectedSkillTitle}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedSkillId}"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedSkillSource}"
                                   FontSize="10"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding SelectedSkillExecutor}"
                                       FontSize="10"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding SelectedSkillRisk}"
                                       FontSize="10"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding SelectedSkillChecksum}"
                                       FontSize="10"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding SelectedSkillPermissions}"
                                   FontSize="10"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedSkillLastRun}"
                                   FontSize="10"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedSkillHealthMetrics}"
                                   FontSize="10"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel IsVisible="{Binding HasSelectedSkillExecutionHistory}"
                                    Spacing="3"
                                    Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Lang.Skills.Detail.ExecutionHistory}"
                                       FontSize="10"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding SelectedSkillExecutionHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,120,*"
                                              ColumnSpacing="8"
                                              Margin="0,1">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimestampText}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{Binding StatusColor}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DetailText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedSkillPolicyGuardrail}"
                                   FontSize="10"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="170,*,Auto"
                              ColumnSpacing="8"
                              IsVisible="{Binding CanEditSelectedSkillPolicy}">
                            <TextBox Grid.Column="0"
                                     Text="{Binding PolicyOptionKeyInput, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource Lang.Skills.Policy.KeyPlaceholder}"
                                     MinHeight="32"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PolicyOptionValueInput, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource Lang.Skills.Policy.ValuePlaceholder}"
                                     MinHeight="32"/>
                            <Button Grid.Column="2"
                                    Classes="IconAction"
                                    Command="{Binding SaveRuntimePolicyOptionCommand}"
                                    ToolTip.Tip="{DynamicResource Lang.Skills.Policy.SaveTip}">
                                <Viewbox Width="16" Height="16"><Path Classes="Icon Accent" Data="{StaticResource IconCheck}"/></Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding SelectedPlugin.TestSkillCommand}"
                            Classes="IconButton"
                            IsVisible="{Binding SelectedPlugin.CanTestSkill}"
                            ToolTip.Tip="{DynamicResource Lang.Skills.Test.Tip}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Top">
                        <Viewbox Width="16" Height="16"><Path Classes="Icon Accent" Data="{StaticResource IconPlay}"/></Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Plugins Grid - Responsive Columns -->
            <ItemsControl Grid.Row="4" ItemsSource="{Binding Plugins}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=GridColumns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes.PluginCard="{Binding IsActive}"
                                Classes.PluginCardInactive="{Binding !IsActive}"
                                Margin="8">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <!-- Icon with Glow -->
                                <Grid Grid.Row="0"
                                      Classes="PluginIconBadge"
                                      Width="40" Height="40"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,16">
                                    <Border Classes="IconBadge"
                                            Background="{Binding GlowColor}"/>
                                    <Path Data="{Binding IconPath}"
                                          Fill="{Binding IconColor}"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding IsActive}"/>
                                    <Path Data="{Binding IconPath}"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Width="18" Height="18"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding !IsActive}"/>
                                </Grid>

                                <!-- Content -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TextColor}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"/>
                                        <Border Classes.StatusActive="{Binding IsActive}"
                                                Classes.StatusInactive="{Binding !IsActive}"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                MaxWidth="82"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{Binding StatusColor}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding SkillId}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Source}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding RequiredPermissionsText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding GrantedPermissionsText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding MissingPermissionsText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentErrorBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding HasMissingPermissions}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               MaxLines="2"/>
                                    <TextBlock Text="{Binding HealthDetail}"
                                               FontSize="10"
                                               Foreground="{Binding StatusColor}"
                                               TextWrapping="Wrap"
                                               LineHeight="16"
                                               MaxLines="2"
                                               Margin="0,8,0,0"/>
                                    <StackPanel IsVisible="{Binding HasLastRun}"
                                                Spacing="3"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="{Binding LastRunStatus}"
                                                   FontSize="10"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{Binding LastRunColor}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastRunDetail}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"/>
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding HasHealthMetrics}"
                                                Spacing="3"
                                                Margin="0,8,0,0">
                                        <TextBlock Text="{Binding HealthMetricsText}"
                                                   FontSize="10"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"/>
                                        <TextBlock Text="{Binding FailureMetricsText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AccentErrorBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   IsVisible="{Binding HasFailureMetrics}"/>
                                    </StackPanel>
                                    <Border IsVisible="{Binding HasEvalResult}"
                                            Background="{DynamicResource SurfaceBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,8,0,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding LastEvalStatus}"
                                                       FontSize="10"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastEvalDetail}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Classes="PluginActionBar"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="0,14,0,0">
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Skills.Card.Details}"
                                            Command="{Binding SelectCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon Accent" Data="{StaticResource IconInfo}"/></Viewbox>
                                    </Button>
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Skills.Test.Tip}"
                                            IsVisible="{Binding CanTestSkill}"
                                            Command="{Binding TestSkillCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon Accent" Data="{StaticResource IconPlay}"/></Viewbox>
                                    </Button>
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Skills.Card.ApproveReview}"
                                            IsVisible="{Binding CanApproveReview}"
                                            Command="{Binding ApproveReviewCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon Accent" Data="{StaticResource IconCheck}"/></Viewbox>
                                    </Button>
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Common.Enable}"
                                            IsVisible="{Binding CanEnable}"
                                            Command="{Binding EnableCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon Success" Data="{StaticResource IconPower}"/></Viewbox>
                                    </Button>
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Skills.Card.GrantPermissions}"
                                            IsVisible="{Binding CanGrantPermissions}"
                                            Command="{Binding GrantPermissionsCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon Accent" Data="{StaticResource IconLockOpen}"/></Viewbox>
                                    </Button>
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Common.Disable}"
                                            IsVisible="{Binding CanDisable}"
                                            Command="{Binding DisableCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconPower}"/></Viewbox>
                                    </Button>
                                    <Button Classes="IconButton CompactIconButton"
                                            Padding="0"
                                            Cursor="Hand"
                                            ToolTip.Tip="{DynamicResource Lang.Skills.Card.RevokePermissions}"
                                            IsVisible="{Binding CanRevokePermissions}"
                                            Command="{Binding RevokePermissionsCommand}">
                                        <Viewbox Width="14" Height="14"><Path Classes="Icon Danger" Data="{StaticResource IconShieldOff}"/></Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
