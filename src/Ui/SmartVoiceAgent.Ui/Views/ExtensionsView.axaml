<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.ExtensionsView"
             x:DataType="vm:ExtensionsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.ExtensionRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="TextBlock.RowTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.ErrorText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentErrorBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.EmptyText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage" Margin="32,28,32,40" MaxWidth="860">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource Lang.Extensions.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Extensions.Subtitle}"
                               Classes="PageSubtitle"/>
                    <TextBlock Text="{Binding SummaryText}" Classes="Caption"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="SecondaryAction"
                        VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconRefresh}"/></Viewbox>
                        <TextBlock Text="{DynamicResource Lang.Common.Refresh}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Classes="Surface"
                    Padding="14,10"
                    IsVisible="{Binding HasMessage}">
                <TextBlock Text="{Binding Message}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>

            <!-- MCP servers -->
            <Border Classes="WorkbenchSection">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="IconBadge">
                            <Viewbox><Path Classes="Icon" Data="{StaticResource IconPlug}" Stroke="{DynamicResource AccentBrush}" Fill="Transparent"/></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Lang.Extensions.Mcp.Title}" Classes="SectionTitle"/>
                            <TextBlock Text="{DynamicResource Lang.Extensions.Mcp.Caption}"
                                       Classes="Caption"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="SecondaryAction" Command="{Binding OpenMcpConfigCommand}" Content="{DynamicResource Lang.Extensions.Mcp.OpenConfig}"/>
                            <Button Classes="SecondaryAction" Command="{Binding ReloadServersCommand}" Content="{DynamicResource Lang.Extensions.Mcp.Reload}"/>
                            <Button Classes="PrimaryAction" Command="{Binding ConnectServersCommand}" Content="{DynamicResource Lang.Extensions.Mcp.Connect}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="EmptyText"
                               IsVisible="{Binding HasNoMcpServers}"
                               Text="{DynamicResource Lang.Extensions.Mcp.Empty}"/>

                    <ItemsControl ItemsSource="{Binding McpServers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:McpServerItemViewModel">
                                <Border Classes="ExtensionRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" Classes="RowTitle"/>
                                                <TextBlock Text="{Binding SourceText}" Classes="Caption" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Classes="Caption Mono" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Classes="Pill"
                                                Classes.Success="{Binding IsReady}"
                                                Classes.Danger="{Binding IsFailed}"
                                                Classes.Accent="{Binding IsStarting}"
                                                Margin="12,0">
                                            <TextBlock Text="{Binding StatusText}"/>
                                        </Border>
                                        <Button Grid.Column="2"
                                                Classes="IconAction"
                                                ToolTip.Tip="{DynamicResource Lang.Extensions.Mcp.Restart}"
                                                Command="{Binding RestartCommand}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconRefresh}"/></Viewbox>
                                        </Button>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="3"
                                                   Classes="ErrorText"
                                                   Margin="0,8,0,0"
                                                   IsVisible="{Binding HasError}"
                                                   Text="{Binding Error}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Plugins -->
            <Border Classes="WorkbenchSection">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="IconBadge">
                            <Viewbox><Path Classes="Icon" Data="{StaticResource IconPuzzle}" Stroke="{DynamicResource AccentBrush}" Fill="Transparent"/></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Lang.Extensions.Plugins.Title}" Classes="SectionTitle"/>
                            <TextBlock Text="{DynamicResource Lang.Extensions.Plugins.Caption}"
                                       Classes="Caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="SecondaryAction" VerticalAlignment="Center"
                                Command="{Binding OpenPluginsFolderCommand}" Content="{DynamicResource Lang.Extensions.OpenFolder}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding PluginSource}"
                                 PlaceholderText="{DynamicResource Lang.Extensions.Plugins.SourcePlaceholder}"/>
                        <Button Grid.Column="1" Classes="PrimaryAction" Command="{Binding InstallPluginCommand}"
                                IsEnabled="{Binding !IsBusy}" Content="{DynamicResource Lang.Common.Install}"/>
                    </Grid>

                    <TextBlock Classes="EmptyText" IsVisible="{Binding HasNoPlugins}" Text="{DynamicResource Lang.Extensions.Plugins.Empty}"/>

                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ExtensionPluginItemViewModel">
                                <Border Classes="ExtensionRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" Classes="RowTitle"/>
                                                <TextBlock Text="{Binding VersionText}" Classes="Caption" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ComponentsText}" Classes="Caption"/>
                                            <TextBlock Text="{Binding Error}" Classes="ErrorText" IsVisible="{Binding HasError}"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding IsEnabled}"
                                                      OnContent="{DynamicResource Lang.Common.On}"
                                                      OffContent="{DynamicResource Lang.Common.Off}"
                                                      VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="IconAction" ToolTip.Tip="{DynamicResource Lang.Extensions.OpenFolder}"
                                                VerticalAlignment="Center" Command="{Binding OpenFolderCommand}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconFolder}"/></Viewbox>
                                        </Button>
                                        <Button Grid.Column="3" Classes="IconAction" ToolTip.Tip="{DynamicResource Lang.Extensions.Plugins.Remove}"
                                                VerticalAlignment="Center" Command="{Binding UninstallCommand}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconTrash}"/></Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Skills -->
            <Border Classes="WorkbenchSection">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="IconBadge">
                            <Viewbox><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="{DynamicResource AccentBrush}" Fill="Transparent"/></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Lang.Extensions.Skills.Title}" Classes="SectionTitle"/>
                            <TextBlock Text="{DynamicResource Lang.Extensions.Skills.Caption}"
                                       Classes="Caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="SecondaryAction" VerticalAlignment="Center"
                                Command="{Binding OpenSkillsFolderCommand}" Content="{DynamicResource Lang.Extensions.OpenFolder}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding SkillSource}" PlaceholderText="{DynamicResource Lang.Extensions.Skills.SourcePlaceholder}"/>
                        <Button Grid.Column="1" Classes="PrimaryAction" Command="{Binding InstallSkillCommand}" Content="{DynamicResource Lang.Common.Install}"/>
                    </Grid>

                    <TextBlock Classes="EmptyText" IsVisible="{Binding HasNoSkills}"
                               Text="{DynamicResource Lang.Extensions.Skills.Empty}"/>

                    <ItemsControl ItemsSource="{Binding Skills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:AgentSkillItemViewModel">
                                <Border Classes="ExtensionRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" Classes="RowTitle Mono"/>
                                            <TextBlock Text="{Binding Description}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="Pill" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceText}"/>
                                        </Border>
                                        <Button Grid.Column="2" Classes="IconAction" ToolTip.Tip="{DynamicResource Lang.Extensions.Skills.Remove}"
                                                VerticalAlignment="Center" IsVisible="{Binding CanUninstall}"
                                                Command="{Binding UninstallCommand}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconTrash}"/></Viewbox>
                                        </Button>
                                        <Button Grid.Column="3" Classes="IconAction" ToolTip.Tip="{DynamicResource Lang.Extensions.OpenFolder}"
                                                VerticalAlignment="Center" Command="{Binding OpenFolderCommand}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconFolder}"/></Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Commands -->
            <Border Classes="WorkbenchSection">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="IconBadge">
                            <Viewbox><Path Classes="Icon" Data="{StaticResource IconWrench}" Stroke="{DynamicResource AccentBrush}" Fill="Transparent"/></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Lang.Extensions.Commands.Title}" Classes="SectionTitle"/>
                            <TextBlock Text="{DynamicResource Lang.Extensions.Commands.Caption}"
                                       Classes="Caption"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="SecondaryAction" VerticalAlignment="Center"
                                Command="{Binding OpenCommandsFolderCommand}" Content="{DynamicResource Lang.Extensions.OpenFolder}"/>
                    </Grid>

                    <TextBlock Classes="EmptyText" IsVisible="{Binding HasNoCommands}"
                               Text="{DynamicResource Lang.Extensions.Commands.Empty}"/>

                    <ItemsControl ItemsSource="{Binding Commands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:AgentCommandItemViewModel">
                                <Border Classes="ExtensionRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Usage}" Classes="RowTitle Mono"/>
                                            <TextBlock Text="{Binding Description}" Classes="Caption" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="Pill" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceText}"/>
                                        </Border>
                                        <Button Grid.Column="2" Classes="IconAction" ToolTip.Tip="{DynamicResource Lang.Extensions.Commands.OpenFile}"
                                                VerticalAlignment="Center" Command="{Binding OpenFileCommand}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconFile}"/></Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
