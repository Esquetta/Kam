<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.CoordinatorView"
             x:DataType="vm:CoordinatorViewModel">

    <Grid RowDefinitions="Auto, *, Auto"
          RowSpacing="22"
          Margin="0"
          ClipToBounds="True">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="24">
            <StackPanel Grid.Column="0"
                        Spacing="10"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <Border Background="{DynamicResource AccentCyanGlowBrush}"
                            BorderBrush="{DynamicResource AccentCyanDimBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <TextBlock Text="AGENT v1.0"
                                   FontSize="11"
                                   FontFamily="Consolas, Cascadia Code, monospace"
                                   Foreground="{DynamicResource AccentCyanBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                   FontSize="11"
                                   FontFamily="Consolas, Cascadia Code, monospace"
                                   Foreground="{Binding StatusColor, Mode=OneWay}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Command Deck"
                           FontSize="38"
                           FontWeight="SemiBold"
                           Foreground="{Binding LabelColor, Mode=OneWay}"/>
                <TextBlock Text="Primary command surface for agents, tools, model state, and workspace readiness."
                           FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="720"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    MinWidth="220"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="Auto, *"
                      RowSpacing="8"
                      ColumnSpacing="10">
                    <Ellipse Grid.Row="0"
                             Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="{Binding StatusColor, Mode=OneWay}"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="Runtime"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="Model and agents follow Settings"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="1.25*, 0.75*"
              ColumnSpacing="18">
            <Border Grid.Column="0"
                    Classes="InfoCard"
                    Padding="22">
                <Grid RowDefinitions="Auto, *, Auto"
                      RowSpacing="18">
                    <StackPanel Grid.Row="0"
                                Spacing="6">
                        <TextBlock Text="Readiness"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Run the first checks before starting work."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1"
                                 Columns="2"
                                 Rows="2">
                        <Border Background="{DynamicResource SurfaceBgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,10,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Model"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Selected provider powers chat, skills, and runtime agents."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Workspace"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Repo, diff, and worktree context stay scoped to coding mode."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,10,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Tools"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Skills, MCP, GitHub, and smoke tests are managed from slash commands."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Run Queue"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Agent runs appear in Activity with status, observations, and retry controls."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Border Background="{DynamicResource AccentCyanGlowBrush}"
                                BorderBrush="{DynamicResource AccentCyanDimBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6">
                            <TextBlock Text="Open /readiness"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentCyanBrush}"
                                       FontFamily="Consolas, Cascadia Code, monospace"/>
                        </Border>
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6">
                            <TextBlock Text="Use /agent for focused task agents"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="InfoCard"
                    Padding="22">
                <Grid RowDefinitions="Auto, *, Auto"
                      RowSpacing="18">
                    <StackPanel Grid.Row="0"
                                Spacing="6">
                        <TextBlock Text="Operating modes"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Quick view of the main agent surfaces."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Spacing="10">
                        <Border Background="{DynamicResource AccentPurpleGlowBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="10">
                                <Ellipse Grid.Column="0"
                                         Width="8"
                                         Height="8"
                                         Fill="{Binding ResearchStatusColor, Mode=OneWay}"
                                         VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Spacing="3">
                                    <TextBlock Text="{DynamicResource Lang.Coordinator.Research}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Workspace planning and implementation"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource AccentCyanGlowBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="10">
                                <Ellipse Grid.Column="0"
                                         Width="8"
                                         Height="8"
                                         Fill="{Binding AnalyzerStatusColor, Mode=OneWay}"
                                         VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Spacing="3">
                                    <TextBlock Text="{DynamicResource Lang.Coordinator.Analyzer}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Screen, file, and runtime inspection"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource AccentOrangeGlowBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="10">
                                <Ellipse Grid.Column="0"
                                         Width="8"
                                         Height="8"
                                         Fill="{Binding TasksStatusColor, Mode=OneWay}"
                                         VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"
                                            Spacing="3">
                                    <TextBlock Text="{DynamicResource Lang.Coordinator.Tasks}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Follow-ups, approvals, and queued runs"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="{Binding IsOnline, Mode=OneWay, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Ready for commands|Runtime paused'}"
                               Foreground="{Binding StatusColor, Mode=OneWay}"
                               FontSize="12"
                               FontFamily="Consolas, Cascadia Code, monospace"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*, *, *"
              ColumnSpacing="12">
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <TextBlock Text="Type /model health to inspect the active runtime model."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <TextBlock Text="Type /workspace for local repository context."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <TextBlock Text="Type /skills to review tools and smoke tests."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
