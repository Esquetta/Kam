<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels"
			 xmlns:controls="using:SmartVoiceAgent.Ui.Controls"
			 xmlns:local="using:SmartVoiceAgent.Ui.Views"
			 xmlns:services="using:SmartVoiceAgent.Ui.Services"
			 x:Class="SmartVoiceAgent.Ui.Views.TasksView"
			 x:DataType="vm:MainWindowViewModel">
	<UserControl.Resources>
		<!-- A tool step's state as a 14 px glyph: a pulsing dot while it runs, a check when done,
		     an x when it failed or was declined, a shield while it waits for approval -->
		<DataTemplate x:Key="ToolStatusGlyphTemplate" DataType="vm:AgentChatMessageViewModel">
			<Panel Classes="ToolStatusGlyph" ToolTip.Tip="{Binding ToolStatusText}">
				<Ellipse Classes="WorkingDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding IsToolRunning}"/>
				<Viewbox Width="13" Height="13" IsVisible="{Binding IsToolSucceeded}"><Path Classes="Icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
				<Viewbox Width="12" Height="12" IsVisible="{Binding IsToolFailed}"><Path Classes="Icon" Data="{StaticResource IconX}" Stroke="{DynamicResource AccentErrorBrush}"/></Viewbox>
				<Viewbox Width="13" Height="13" IsVisible="{Binding IsAwaitingApproval}"><Path Classes="Icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentOrangeBrush}"/></Viewbox>
			</Panel>
		</DataTemplate>

		<!-- One tool step as a quiet line: glyph, tool, target, a risk tag when it matters, duration.
		     A click shows its arguments and result; waiting for approval turns it into a bordered row. -->
		<DataTemplate x:Key="ToolStepLineTemplate" DataType="vm:AgentChatMessageViewModel">
			<Border Classes="ToolLine" Classes.Approval="{Binding IsAwaitingApproval}">
				<StackPanel Spacing="4">
					<ToggleButton Classes="ToolLineHeader"
								  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
								  ToolTip.Tip="{Binding ToolName}"
								  AutomationProperties.Name="{Binding ToolDisplayName}">
						<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
							<ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource ToolStatusGlyphTemplate}"/>
							<TextBlock Grid.Column="1" Classes="ToolLineName" Text="{Binding ToolDisplayName}"/>
							<TextBlock Grid.Column="2" Classes="ToolLineTarget" Text="{Binding ToolTarget}"/>
							<TextBlock Grid.Column="3"
									   Classes="RiskTag"
									   Classes.Write="{Binding IsWriteRisk}"
									   Classes.Shell="{Binding IsShellRisk}"
									   Text="{Binding RiskTag}"
									   ToolTip.Tip="{Binding RiskText}"
									   IsVisible="{Binding ShowsRiskTag}"/>
							<TextBlock Grid.Column="4" Classes="ToolLineMeta" Text="{Binding ToolDurationText}"/>
						</Grid>
					</ToggleButton>

					<TextBlock Classes="ToolLineError" Margin="22,0,0,0" Text="{Binding ToolSummary}" IsVisible="{Binding ShowsToolError}"/>

					<StackPanel Spacing="6" Margin="22,2,0,2" IsVisible="{Binding ShowsToolDetails}">
						<Border Classes="ToolArguments" IsVisible="{Binding HasArguments}">
							<!-- A long brief (a hand-off to another agent shows it whole) scrolls inside the step -->
							<ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
								<SelectableTextBlock Text="{Binding ArgumentsPreview}"
													 FontSize="12"
													 FontFamily="{StaticResource MonoFontFamily}"
													 Foreground="{DynamicResource TextSecondaryBrush}"
													 TextWrapping="Wrap"/>
							</ScrollViewer>
						</Border>
						<SelectableTextBlock Classes="ToolResult"
											 Text="{Binding ToolSummary}"
											 IsVisible="{Binding ShowsToolResult}"/>
					</StackPanel>

					<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
						  ColumnSpacing="6"
						  IsVisible="{Binding IsAwaitingApproval}">
						<Viewbox Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentOrangeBrush}"/></Viewbox>
						<TextBlock Grid.Column="1"
								   Text="{DynamicResource Lang.Chat.Tool.RunPrompt}"
								   FontSize="12"
								   FontWeight="Medium"
								   Foreground="{DynamicResource TextPrimaryBrush}"
								   VerticalAlignment="Center"/>
						<Button Grid.Column="2"
								Classes="GhostAction Sm"
								Content="{DynamicResource Lang.Common.Deny}"
								Command="{Binding $parent[local:TasksView].DataContext.DenyToolCallCommand}"
								CommandParameter="{Binding}"/>
						<Button Grid.Column="3"
								Classes="SecondaryAction Sm"
								Content="{DynamicResource Lang.Common.AlwaysAllow}"
								ToolTip.Tip="{Binding AlwaysAllowHint}"
								IsVisible="{Binding CanAlwaysAllow}"
								Command="{Binding $parent[local:TasksView].DataContext.AlwaysAllowToolCallCommand}"
								CommandParameter="{Binding}"/>
						<Button Grid.Column="4"
								Classes="PrimaryAction Sm"
								Content="{DynamicResource Lang.Common.Approve}"
								Command="{Binding $parent[local:TasksView].DataContext.ApproveToolCallCommand}"
								CommandParameter="{Binding}"/>
					</Grid>
				</StackPanel>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<!-- Tasks: the selected task's conversation and the composer, in one centered 760 px column. The task list
	     lives in the window's rail and the thread title, model and menu in its top bar. Styles for these parts
	     live in MainWindow's styles and apply here through the window. -->
	<Grid Classes="ThreadPane" RowDefinitions="*,Auto">
		<ScrollViewer Grid.Row="0"
					  x:Name="ChatScrollViewer"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled">
			<Grid MaxWidth="760" Margin="16,16,16,8">
				<!-- Empty state -->
				<StackPanel Spacing="22"
							VerticalAlignment="Center"
							Margin="0,48,0,0"
							IsVisible="{Binding !HasAgentChatMessages}">
					<Border Width="48" Height="48"
							CornerRadius="14"
							HorizontalAlignment="Center"
							Background="{DynamicResource BrandGradientBrush}">
						<Viewbox Width="24" Height="24"><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="White"/></Viewbox>
					</Border>
					<!-- Ready: what Kam can do -->
					<StackPanel Spacing="22" IsVisible="{Binding !NeedsModelSetup}">
						<StackPanel Spacing="6" HorizontalAlignment="Center">
							<TextBlock Text="{DynamicResource Lang.Chat.Empty.Title}"
									   FontSize="20"
									   FontWeight="SemiBold"
									   LetterSpacing="-0.3"
									   HorizontalAlignment="Center"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource Lang.Chat.Empty.Body}"
									   Classes="Caption"
									   FontSize="13"
									   TextAlignment="Center"
									   HorizontalAlignment="Center"/>
						</StackPanel>
						<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
							<Button Grid.Column="0"
									Classes="SuggestionCard"
									Command="{Binding UseComposerSuggestionCommand}"
									CommandParameter="{DynamicResource Lang.Chat.Suggestion.Review.Prompt}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Review.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Review.Caption}" Classes="Caption"/>
								</StackPanel>
							</Button>
							<Button Grid.Column="1"
									Classes="SuggestionCard"
									Command="{Binding UseComposerSuggestionCommand}"
									CommandParameter="{DynamicResource Lang.Chat.Suggestion.Tests.Prompt}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Tests.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Tests.Caption}" Classes="Caption"/>
								</StackPanel>
							</Button>
							<Button Grid.Column="2"
									Classes="SuggestionCard"
									Command="{Binding UseComposerSuggestionCommand}"
									CommandParameter="{DynamicResource Lang.Chat.Suggestion.Plan.Prompt}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Plan.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Suggestion.Plan.Caption}" Classes="Caption"/>
								</StackPanel>
							</Button>
						</Grid>
					</StackPanel>

					<!-- First run: no model yet, so the one thing to do is connect one -->
					<StackPanel Spacing="22" IsVisible="{Binding NeedsModelSetup}">
						<StackPanel Spacing="6" HorizontalAlignment="Center">
							<TextBlock Text="{DynamicResource Lang.Chat.Setup.Title}"
									   FontSize="20"
									   FontWeight="SemiBold"
									   LetterSpacing="-0.3"
									   HorizontalAlignment="Center"
									   Foreground="{DynamicResource TextPrimaryBrush}"/>
							<TextBlock Text="{DynamicResource Lang.Chat.Setup.Body}"
									   Classes="Caption"
									   FontSize="13"
									   MaxWidth="460"
									   TextWrapping="Wrap"
									   TextAlignment="Center"
									   HorizontalAlignment="Center"/>
						</StackPanel>
						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" MaxWidth="560">
							<Button Grid.Column="0" Grid.Row="0"
									Classes="SuggestionCard"
									Command="{Binding SetUpModelCommand}"
									CommandParameter="OpenRouter"
									AutomationProperties.Name="{DynamicResource Lang.Chat.Setup.OpenRouter.Title}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconNetwork}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.OpenRouter.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.OpenRouter.Caption}" Classes="Caption" TextWrapping="Wrap"/>
								</StackPanel>
							</Button>
							<Button Grid.Column="1" Grid.Row="0"
									Classes="SuggestionCard"
									Command="{Binding SetUpModelCommand}"
									CommandParameter="Ollama"
									AutomationProperties.Name="{DynamicResource Lang.Chat.Setup.Ollama.Title}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconCpu}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.Ollama.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.Ollama.Caption}" Classes="Caption" TextWrapping="Wrap"/>
								</StackPanel>
							</Button>
							<Button Grid.Column="0" Grid.Row="1"
									Classes="SuggestionCard"
									Command="{Binding SetUpModelCommand}"
									CommandParameter="OpenAI"
									AutomationProperties.Name="{DynamicResource Lang.Chat.Setup.OpenAI.Title}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconSparkles}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.OpenAI.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.OpenAI.Caption}" Classes="Caption" TextWrapping="Wrap"/>
								</StackPanel>
							</Button>
							<Button Grid.Column="1" Grid.Row="1"
									Classes="SuggestionCard"
									Command="{Binding SetUpModelCommand}"
									CommandParameter="Anthropic"
									AutomationProperties.Name="{DynamicResource Lang.Chat.Setup.Anthropic.Title}">
								<StackPanel Spacing="6">
									<Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Classes="Icon" Data="{StaticResource IconBot}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.Anthropic.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
									<TextBlock Text="{DynamicResource Lang.Chat.Setup.Anthropic.Caption}" Classes="Caption" TextWrapping="Wrap"/>
								</StackPanel>
							</Button>
						</Grid>
						<TextBlock Text="{DynamicResource Lang.Chat.Setup.KeyNote}"
								   Classes="Caption"
								   TextAlignment="Center"
								   HorizontalAlignment="Center"/>
					</StackPanel>
				</StackPanel>

				<!-- Messages; virtualized, so a long thread only builds the rows on screen -->
				<StackPanel IsVisible="{Binding HasAgentChatMessages}">
				<ItemsControl x:Name="ChatMessageList" ItemsSource="{Binding SelectedAgentChatSession.Messages}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<VirtualizingStackPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="vm:AgentChatMessageViewModel">
							<Border Classes="ChatMessage" Classes.Tool="{Binding IsToolItem}">
								<Panel>
									<!-- Outgoing (user) -->
									<StackPanel Spacing="4"
												HorizontalAlignment="Right"
												IsVisible="{Binding IsUser}">
										<Border Classes="UserBubble">
											<SelectableTextBlock Text="{Binding Content}"
																 FontSize="13"
																 LineHeight="19"
																 Foreground="{DynamicResource AccentOnBrush}"
																 SelectionBrush="#55FFFFFF"
																 TextWrapping="Wrap"/>
										</Border>
										<StackPanel Orientation="Horizontal"
													Spacing="4"
													HorizontalAlignment="Right">
											<Button Classes="IconButton CompactIconButton MessageAction"
													Background="Transparent"
													BorderThickness="0"
													AutomationProperties.Name="{DynamicResource Lang.Chat.Message.Copy}"
													ToolTip.Tip="{DynamicResource Lang.Chat.Message.Copy}"
													Command="{Binding $parent[local:TasksView].DataContext.CopyAgentMessageCommand}"
													CommandParameter="{Binding}">
												<Panel>
													<Viewbox Width="14" Height="14" IsVisible="{Binding !IsCopied}"><Path Classes="Icon" Data="{StaticResource IconCopy}"/></Viewbox>
													<Viewbox Width="14" Height="14" IsVisible="{Binding IsCopied}"><Path Classes="Icon Accent" Data="{StaticResource IconCheck}"/></Viewbox>
												</Panel>
											</Button>
											<TextBlock Text="{Binding TimeText}"
													   FontSize="11"
													   Foreground="{DynamicResource TextMutedBrush}"
													   VerticalAlignment="Center"/>
										</StackPanel>
									</StackPanel>

									<!-- Incoming (agent / system), .msg.bot: plain text on the page, no bubble -->
									<StackPanel Spacing="2"
												IsVisible="{Binding IsAgent}"
												ToolTip.Tip="{Binding TimeText}">
											<!-- Kam's own notices (errors, compaction) carry a System label and a quiet note background -->
											<TextBlock Text="{Binding Role}" Classes="Overline" IsVisible="{Binding IsSystem}" Margin="0,0,0,2"/>
											<Border Classes.Note="{Binding IsSystem}">
												<controls:MarkdownView Markdown="{Binding Content}"/>
											</Border>
											<StackPanel Orientation="Horizontal"
														Spacing="2"
														Margin="-4,0,0,-8"
														IsVisible="{Binding !IsStreaming}">
												<Button Classes="IconButton CompactIconButton MessageAction"
														Background="Transparent"
														BorderThickness="0"
														AutomationProperties.Name="{DynamicResource Lang.Chat.Message.Copy}"
														ToolTip.Tip="{DynamicResource Lang.Chat.Message.Copy}"
														Command="{Binding $parent[local:TasksView].DataContext.CopyAgentMessageCommand}"
														CommandParameter="{Binding}">
													<Panel>
														<Viewbox Width="14" Height="14" IsVisible="{Binding !IsCopied}"><Path Classes="Icon" Data="{StaticResource IconCopy}"/></Viewbox>
														<Viewbox Width="14" Height="14" IsVisible="{Binding IsCopied}"><Path Classes="Icon Accent" Data="{StaticResource IconCheck}"/></Viewbox>
													</Panel>
												</Button>
												<TextBlock Text="{Binding TimeText}"
														   FontSize="11"
														   Foreground="{DynamicResource TextMutedBrush}"
														   VerticalAlignment="Center"/>
											</StackPanel>
										</StackPanel>

									<!-- Tool step: one quiet line; a subagent's step is a card that holds the subagent's own steps -->
									<Panel IsVisible="{Binding IsToolStep}">
										<ContentControl IsVisible="{Binding !IsSubagentTask}"
														Content="{Binding}"
														ContentTemplate="{StaticResource ToolStepLineTemplate}"/>

										<Border Classes="SubagentCard" IsVisible="{Binding IsSubagentTask}">
											<StackPanel Spacing="6">
												<ToggleButton Classes="ToolLineHeader"
															  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
															  ToolTip.Tip="{Binding ArgumentsPreview}"
															  AutomationProperties.Name="{Binding ToolDisplayName}">
													<StackPanel Spacing="3">
														<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
															<ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource ToolStatusGlyphTemplate}"/>
															<TextBlock Grid.Column="1" Classes="ToolLineName" Text="{Binding ToolDisplayName}"/>
															<TextBlock Grid.Column="2" Classes="ToolLineMeta" Text="{Binding ToolDurationText}"/>
															<Viewbox Grid.Column="3" Classes="ToolLineChevron" Classes.open="{Binding IsExpanded}" IsVisible="{Binding HasChildren}" Width="12" Height="12" VerticalAlignment="Center">
																<Path Classes="Icon" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}"/>
															</Viewbox>
														</Grid>
														<!-- The job the subagent was given -->
														<TextBlock Classes="SubagentJob" Text="{Binding ToolTarget}"/>
													</StackPanel>
												</ToggleButton>

												<!-- What it does now, and a link to its graph -->
												<StackPanel Orientation="Horizontal" Spacing="10" Margin="22,0,0,0">
													<TextBlock Classes="ToolLineMeta"
															   Text="{Binding SubagentProgressText}"
															   IsVisible="{Binding HasSubagentProgress}"/>
													<Button Classes="LinkAction"
															IsVisible="{Binding SubagentRunId, Converter={x:Static ObjectConverters.IsNotNull}}"
															Content="{DynamicResource Lang.Workbench.Subagent.ViewGraph}"
															Command="{Binding $parent[local:TasksView].DataContext.OpenSubagentGraphCommand}"
															CommandParameter="{Binding}"/>
												</StackPanel>
												<TextBlock Classes="ToolLineError" Margin="22,0,0,0" Text="{Binding ToolSummary}" IsVisible="{Binding ShowsToolError}"/>

												<!-- Its steps, as compact lines; a step that asks for approval opens the card -->
												<Border Classes="ToolChildren" IsVisible="{Binding IsExpanded}">
													<StackPanel Spacing="2">
														<ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ToolStepLineTemplate}"/>
														<SelectableTextBlock Classes="ToolResult"
																			 Text="{Binding ToolSummary}"
																			 IsVisible="{Binding ShowsToolResult}"/>
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Panel>

									<!-- Read group: consecutive read-only steps as one summary line; open it for the steps -->
									<StackPanel Spacing="2" IsVisible="{Binding IsToolGroup}">
										<ToggleButton Classes="ToolLineHeader"
													  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
													  AutomationProperties.Name="{Binding GroupTitle}">
											<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
												<ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource ToolStatusGlyphTemplate}"/>
												<TextBlock Grid.Column="1" Classes="ToolLineName" Text="{Binding GroupTitle}"/>
												<TextBlock Grid.Column="2" Classes="ToolLineTarget" Text="{Binding GroupTarget}"/>
												<TextBlock Grid.Column="3" Classes="ToolLineError" Text="{Binding GroupFailedText}" IsVisible="{Binding HasGroupFailures}"/>
												<Viewbox Grid.Column="4" Classes="ToolLineChevron" Classes.open="{Binding IsExpanded}" Width="12" Height="12" VerticalAlignment="Center">
													<Path Classes="Icon" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}"/>
												</Viewbox>
											</Grid>
										</ToggleButton>
										<Border Classes="ToolChildren" IsVisible="{Binding IsExpanded}">
											<ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ToolStepLineTemplate}"/>
										</Border>
									</StackPanel>
								</Panel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Working indicator -->
				<StackPanel Orientation="Horizontal"
							Spacing="8"
							Margin="0,0,0,12"
							IsVisible="{Binding IsAgentTurnRunning}">
					<Ellipse Classes="WorkingDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
					<TextBlock Text="{DynamicResource Lang.Chat.Working}"
							   FontSize="12"
							   Foreground="{DynamicResource TextMutedBrush}"
							   VerticalAlignment="Center"/>
				</StackPanel>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<!-- Composer: slash commands and strips stack above it in the same column -->
		<StackPanel Grid.Row="1"
					MaxWidth="760"
					Margin="16,8,16,16"
					Spacing="6">

			<!-- Slash command palette -->
			<Border Background="{DynamicResource SurfaceBgElevatedBrush}"
					BorderBrush="{DynamicResource BorderMutedBrush}"
					BorderThickness="1"
					CornerRadius="10"
					Padding="4"
					ClipToBounds="True"
					BoxShadow="0 8 24 0 #1F000000"
					IsVisible="{Binding IsSlashCommandPaletteVisible}">
				<ItemsControl ItemsSource="{Binding SlashCommandSuggestions}"
							  HorizontalAlignment="Stretch">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="vm:SlashCommandSuggestionViewModel">
							<Button Command="{Binding $parent[local:TasksView].DataContext.SelectSlashCommandCommand}"
									CommandParameter="{Binding}"
									Classes="SlashCommandItem"
									HorizontalAlignment="Stretch">
								<Border Background="{Binding IsSelected, Converter={StaticResource BoolToStatusBrushConverter}, ConverterParameter='CardBgHoverBrush|TransparentBrush'}"
										BorderBrush="Transparent"
										BorderThickness="0"
										CornerRadius="6"
										Padding="8,7"
										HorizontalAlignment="Stretch">
									<Grid ColumnDefinitions="Auto, *, Auto"
										  RowDefinitions="Auto, Auto"
										  RowSpacing="2">
										<Border Grid.Column="0"
												Grid.Row="0"
												Grid.RowSpan="2"
												Width="2"
												Height="24"
												Background="{DynamicResource AccentBrush}"
												CornerRadius="2"
												Opacity="{Binding IsSelected, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter='1|0'}"
												VerticalAlignment="Center"
												Margin="0,0,8,0"/>
										<TextBlock Grid.Column="1"
												   Grid.Row="0"
												   Text="{Binding Name}"
												   FontSize="12"
												   FontFamily="{StaticResource MonoFontFamily}"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource AccentBrush}"/>
										<TextBlock Grid.Column="2"
												   Grid.Row="0"
												   Text="{Binding Category}"
												   FontSize="11"
												   Foreground="{DynamicResource TextMutedBrush}"
												   VerticalAlignment="Center"
												   Margin="12,0,0,0"/>
										<TextBlock Grid.Column="1"
												   Grid.ColumnSpan="2"
												   Grid.Row="1"
												   Text="{Binding Summary}"
												   FontSize="12"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextTrimming="CharacterEllipsis"/>
									</Grid>
								</Border>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>

			<!-- Strips above the composer -->
			<!-- No model yet, in a chat that already has messages (an empty chat shows the setup card) -->
			<Border Classes="VoiceStatusStrip">
				<Border.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="NeedsModelSetup"/>
						<Binding Path="HasAgentChatMessages"/>
					</MultiBinding>
				</Border.IsVisible>
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
					<Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AccentOrangeBrush}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1"
							   Text="{DynamicResource Lang.Chat.Setup.Strip}"
							   FontSize="12"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   VerticalAlignment="Center"
							   TextTrimming="CharacterEllipsis"/>
					<Button Grid.Column="2"
							Classes="CompactAction"
							Command="{Binding SetUpModelCommand}">
						<TextBlock Text="{DynamicResource Lang.Chat.Setup.StripAction}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
					</Button>
				</Grid>
			</Border>

			<!-- Voice: listening, transcribing, model download and problems -->
			<Border x:Name="VoiceStatusPanel"
					Classes="VoiceStatusStrip"
					IsVisible="{Binding IsVoiceStatusVisible}">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
					<Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding VoiceStatusColor}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1"
							   Text="{Binding VoiceStatusText}"
							   FontSize="12"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   VerticalAlignment="Center"
							   TextTrimming="CharacterEllipsis"/>
					<ProgressBar Grid.Column="2"
								 Classes="VoiceMeter"
								 Minimum="0"
								 Maximum="1"
								 Value="{Binding VoiceMeterValue}"
								 Foreground="{Binding VoiceStatusColor}"
								 IsVisible="{Binding IsVoiceMeterVisible}"/>
					<Button Grid.Column="3"
							Classes="CompactAction"
							ToolTip.Tip="{DynamicResource Lang.Voice.Cancel}"
							IsVisible="{Binding IsVoiceCancelVisible}"
							Command="{Binding CancelVoiceCommand}">
						<TextBlock Text="{DynamicResource Lang.Common.Cancel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
					</Button>
				</Grid>
			</Border>

			<!-- Messages sent while a turn runs -->
			<Border Classes="QueuedMessageStrip"
					IsVisible="{Binding HasQueuedAgentMessages}">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
					<Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconClock}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
					<TextBlock Grid.Column="1"
							   Text="{Binding QueuedAgentMessagesText}"
							   FontSize="12"
							   Foreground="{DynamicResource TextSecondaryBrush}"
							   VerticalAlignment="Center"
							   TextTrimming="CharacterEllipsis"/>
					<Button Grid.Column="2"
							Classes="CompactAction"
							ToolTip.Tip="{DynamicResource Lang.Chat.Composer.ClearQueuedTip}"
							Command="{Binding ClearQueuedAgentMessagesCommand}">
						<TextBlock Text="{DynamicResource Lang.Common.Cancel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
					</Button>
				</Grid>
			</Border>

			<Border Classes="ComposerSurface">
				<Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">

					<!-- Context files -->
					<Grid Grid.Row="0"
						  RowDefinitions="Auto,Auto"
						  RowSpacing="6"
						  IsVisible="{Binding HasComposerAttachments}">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="{DynamicResource Lang.Chat.Composer.ContextFiles}" Classes="Caption"/>
							<Button Grid.Column="1"
									Classes="CompactAction"
									ToolTip.Tip="{DynamicResource Lang.Chat.Composer.ClearContextTip}"
									Command="{Binding ClearComposerAttachmentsCommand}">
								<TextBlock Text="{DynamicResource Lang.Chat.Composer.ClearContext}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
							</Button>
						</Grid>
						<ItemsControl Grid.Row="1" ItemsSource="{Binding ComposerAttachments}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="vm:ComposerAttachmentViewModel">
									<Border Classes="AttachmentChip">
										<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
											<Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconFile}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
											<StackPanel Grid.Column="1" Spacing="1" MinWidth="0">
												<TextBlock Text="{Binding FileName}"
														   FontSize="12"
														   FontWeight="SemiBold"
														   Foreground="{DynamicResource TextPrimaryBrush}"
														   TextTrimming="CharacterEllipsis"/>
												<TextBlock Text="{Binding DisplayPath}"
														   FontSize="11"
														   Foreground="{DynamicResource TextMutedBrush}"
														   TextTrimming="CharacterEllipsis"/>
											</StackPanel>
											<Button Grid.Column="2"
													Classes="IconButton CompactIconButton"
													Background="Transparent"
													BorderThickness="0"
													AutomationProperties.Name="{DynamicResource Lang.Chat.Composer.RemoveFile}"
													ToolTip.Tip="{DynamicResource Lang.Chat.Composer.RemoveFile}"
													Command="{Binding $parent[local:TasksView].DataContext.RemoveComposerAttachmentCommand}"
													CommandParameter="{Binding}">
												<Viewbox Width="12" Height="12"><Path Classes="Icon" Data="{StaticResource IconX}"/></Viewbox>
											</Button>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>

					<!-- Prompt -->
					<!-- Enter sends and Shift+Enter adds a line; TasksView handles keys before the TextBox does -->
					<TextBox Grid.Row="1"
							 x:Name="WorkbenchPromptInput"
							 Classes="BareInput"
							 PlaceholderText="{DynamicResource Lang.Chat.Composer.Placeholder}"
							 FontSize="14"
							 MinHeight="40"
							 Foreground="{DynamicResource TextPrimaryBrush}"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 MaxHeight="160"
							 Text="{Binding CommandInputText, Mode=TwoWay}"/>

					<!-- Bar: attach, permission mode and the context meter on the left; spoken replies, mic and send on the right -->
					<Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
						<Button Grid.Column="0"
								Classes="IconButton"
								AutomationProperties.Name="{DynamicResource Lang.Chat.Composer.Attach}"
								ToolTip.Tip="{DynamicResource Lang.Chat.Composer.Attach}"
								Click="OnAttachFilesClick">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconPaperclip}"/></Viewbox>
						</Button>
						<ComboBox Grid.Column="1"
								  Classes="ApprovalModePicker"
								  ItemsSource="{x:Static vm:MainWindowViewModel.ApprovalModes}"
								  SelectedItem="{Binding SelectedApprovalMode}"
								  IsVisible="{Binding IsAgentRuntimeEnabled}"
								  ToolTip.Tip="{Binding SelectedApprovalMode.Description}">
							<ComboBox.ItemTemplate>
								<DataTemplate DataType="vm:ApprovalModeOption">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconShield}" Stroke="{DynamicResource TextMutedBrush}"/></Viewbox>
										<TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
									</StackPanel>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<!-- Context meter: shows once the task's context passes half the budget; a click offers to compact it -->
						<Button Grid.Column="2"
								Classes="ComposerPill"
								HorizontalAlignment="Left"
								IsVisible="{Binding ShowsContextMeter}"
								AutomationProperties.Name="{Binding SelectedContextText}">
							<ToolTip.Tip>
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding SelectedContextText}"/>
									<TextBlock Text="{Binding SelectedCompactionText}"/>
								</StackPanel>
							</ToolTip.Tip>
							<Button.Flyout>
								<Flyout Placement="TopEdgeAlignedLeft">
									<StackPanel Spacing="8" MinWidth="220">
										<TextBlock Text="{DynamicResource Lang.Activity.Task.Context}" FontSize="12" FontWeight="SemiBold"/>
										<TextBlock Text="{Binding SelectedContextText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
										<TextBlock Text="{Binding SelectedCompactionText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
										<Button Classes="SecondaryAction Sm"
												HorizontalAlignment="Left"
												Content="{DynamicResource Lang.Activity.Task.CompactNow}"
												ToolTip.Tip="{DynamicResource Lang.Activity.Task.CompactNowTip}"
												IsEnabled="{Binding CanCompactSelectedTask}"
												Command="{Binding CompactAgentChatCommand}"/>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<ProgressBar Classes="ContextMeter"
											 Classes.Warning="{Binding IsSelectedContextNearBudget}"
											 Width="28" MinWidth="0"
											 Height="4" MinHeight="4"
											 VerticalAlignment="Center"
											 Minimum="0"
											 Maximum="100"
											 Value="{Binding SelectedContextPercent}"/>
								<TextBlock Text="{Binding SelectedContextPercentText}" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button Grid.Column="4"
								x:Name="SpokenRepliesButton"
								Classes="IconButton SpokenRepliesButton"
								AutomationProperties.Name="{Binding SpokenRepliesToolTip}"
								ToolTip.Tip="{Binding SpokenRepliesToolTip}"
								Command="{Binding ToggleSpokenRepliesCommand}">
							<Panel>
								<Viewbox Width="16" Height="16" IsVisible="{Binding IsSpokenRepliesOn}"><Path Classes="Icon" Data="{StaticResource IconVolume}"/></Viewbox>
								<Viewbox Width="16" Height="16" IsVisible="{Binding !IsSpokenRepliesOn}"><Path Classes="Icon" Data="{StaticResource IconVolumeOff}"/></Viewbox>
							</Panel>
						</Button>
						<Button Grid.Column="5"
								x:Name="TalkButton"
								Classes="IconButton TalkButton"
								Classes.listening="{Binding IsVoiceListening}"
								AutomationProperties.Name="{Binding TalkToolTip}"
								ToolTip.Tip="{Binding TalkToolTip}"
								IsEnabled="{Binding IsVoiceAvailable}"
								Command="{Binding TalkCommand}">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconMic}"/></Viewbox>
						</Button>
						<!-- Send: muted while the composer is empty; a stop square takes its place while a turn runs -->
						<Button Grid.Column="6"
								Classes="SendButton"
								Classes.Empty="{Binding !HasComposerText}"
								AutomationProperties.Name="{DynamicResource Lang.Chat.Composer.SendLabel}"
								ToolTip.Tip="{DynamicResource Lang.Chat.Composer.Send}"
								IsVisible="{Binding IsSendVisible}"
								Command="{Binding SubmitCommand}">
							<Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconArrowUp}"/></Viewbox>
						</Button>
						<Button Grid.Column="6"
								Classes="SendButton"
								AutomationProperties.Name="{DynamicResource Lang.Chat.Composer.StopLabel}"
								ToolTip.Tip="{DynamicResource Lang.Chat.Composer.Stop}"
								IsVisible="{Binding IsAgentTurnRunning}"
								Command="{Binding StopAgentTurnCommand}">
							<Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource AccentOnBrush}"/>
						</Button>
					</Grid>
				</Grid>
			</Border>
		</StackPanel>
	</Grid>
</UserControl>
