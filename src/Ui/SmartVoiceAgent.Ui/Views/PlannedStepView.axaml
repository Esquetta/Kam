<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagevm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.PlannedStepView"
             x:DataType="pagevm:PlannedStepViewModel">
    <UserControl.Styles>
        <!-- The panel border closes the last row -->
        <Style Selector="ItemsControl > ContentPresenter:nth-last-child(1) > Border.PaneRow">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Panel.PlannedBadge Rectangle">
            <Setter Property="RadiusX" Value="8"/>
            <Setter Property="RadiusY" Value="8"/>
            <Setter Property="Stroke" Value="{DynamicResource BorderMutedBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeDashArray" Value="3,2"/>
        </Style>
        <Style Selector="Panel.PlannedBadge TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="7,1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- A Build step Kam has no runtime for yet: what it is for, what works toward it today, what is missing -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,16,18,24" Spacing="14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Overline}" Classes="Overline" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageTitle}" Classes="PageTitle" VerticalAlignment="Center"/>
                    <Panel Classes="PlannedBadge" VerticalAlignment="Center">
                        <Rectangle/>
                        <TextBlock Text="{DynamicResource Lang.Shell.Ladder.Planned}"/>
                    </Panel>
                </StackPanel>
                <Border Classes="Explain">
                    <TextBlock Text="{Binding Explanation}" Classes="PageSubtitle"/>
                </Border>
            </StackPanel>

            <Border Classes="Pane">
                <StackPanel>
                    <Border Classes="PaneHead">
                        <TextBlock Text="{DynamicResource Lang.Build.TodayTitle}" Classes="SectionTitle"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Today}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="pagevm:PlannedStepLink">
                                <Border Classes="PaneRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                            <Path Classes="Icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource AccentGreenBrush}"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Classes="SecondaryAction Sm"
                                                Content="{Binding LinkText}"
                                                Command="{Binding Open}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="Pane">
                <StackPanel>
                    <Border Classes="PaneHead">
                        <TextBlock Text="{DynamicResource Lang.Build.ComingTitle}" Classes="SectionTitle"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Coming}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="PaneRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Panel Grid.Column="1" Classes="PlannedBadge" VerticalAlignment="Center">
                                            <Rectangle/>
                                            <TextBlock Text="{DynamicResource Lang.Shell.Ladder.Planned}"/>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
