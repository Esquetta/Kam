<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.RuntimeDiagnosticsView"
             x:DataType="vm:RuntimeDiagnosticsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.DiagnosticPanel">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="Border.DiagnosticRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Ellipse.ReadyDot">
            <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>

        <Style Selector="Ellipse.WarningDot">
            <Setter Property="Fill" Value="{DynamicResource AccentOrangeBrush}"/>
        </Style>

        <Style Selector="Ellipse.BlockedDot">
            <Setter Property="Fill" Value="{DynamicResource AccentErrorBrush}"/>
        </Style>

        <Style Selector="ToggleButton.AdvancedToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.AdvancedToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.AdvancedToggle:checked /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.AdvancedToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage PageColumn List">

            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Diagnostics.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Diagnostics.Subtitle}" Classes="PageSubtitle"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Classes="PageHeaderActions">
                    <Button Command="{Binding RefreshCommand}" Classes="SecondaryAction">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Classes="Icon" Data="{StaticResource IconRefresh}"/></Viewbox>
                            <TextBlock Text="{DynamicResource Lang.Common.Refresh}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding StatusCards}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                        <Border Classes="Card" Padding="16,14" Margin="0,0,12,0">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="StatusDot"
                                            Classes.Success="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}"
                                            Classes.Danger="{Binding IsBlocked}"/>
                                    <TextBlock Text="{Binding Name}" Classes="GroupTitle"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Value}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}"
                                           Classes="Caption"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Button Content="{Binding ActionText}"
                                        Tag="{Binding ActionTarget}"
                                        Classes="LinkAction"
                                        HorizontalAlignment="Left"
                                        Click="OnCardActionClick"
                                        IsVisible="{Binding HasAction}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="14">
                <ToggleButton x:Name="DetailsToggle"
                              Classes="AdvancedToggle"
                              HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource Lang.Diagnostics.Details.Title}" FontSize="12" FontWeight="Medium"/>
                        <Viewbox Width="12" Height="12"><Path Classes="Icon" Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource AccentBrush}"/></Viewbox>
                    </StackPanel>
                </ToggleButton>

                <StackPanel Spacing="16" IsVisible="{Binding #DetailsToggle.IsChecked}">
                    <TextBlock Text="{DynamicResource Lang.Diagnostics.Details.Hint}"
                               Classes="Caption"
                               TextWrapping="Wrap"/>
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="16">
                <Border Grid.Row="0" Classes="DiagnosticPanel">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="14">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.LiveTest.Title}"
                                           Classes="SectionTitle"/>
                                <TextBlock Text="{Binding LiveTestNextAction}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ReadinessReportCopyStatus}"
                                           IsVisible="{Binding HasReadinessReportCopyStatus}"
                                           FontSize="11"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyReadinessReportCommand}"
                                    Classes="SecondaryAction"
                                    MinWidth="112"
                                    Height="34"
                                    Padding="12,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.LiveTest.CopyReport}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Border Grid.Column="2"
                                    Classes="Pill"
                                    VerticalAlignment="Top"
                                    Margin="0,8,0,0">
                                <TextBlock Text="{Binding LiveTestStatusText}"/>
                            </Border>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding LiveTestSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                    <Border Classes="DiagnosticRow"
                                            Classes.Ready="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}"
                                            Classes.Blocked="{Binding IsBlocked}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Classes="DiagnosticPanel"
                        IsVisible="{Binding HasSetupActionItems}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{DynamicResource Lang.Diagnostics.SetupActions.Title}"
                                   Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding SetupActionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                    <Border Classes="DiagnosticRow"
                                            Classes.Ready="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}"
                                            Classes.Blocked="{Binding IsBlocked}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="160"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="DiagnosticPanel">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="14">
                        <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.Updates.Title}"
                                           Classes="SectionTitle"/>
                                <TextBlock Text="{Binding ApplicationUpdateActionStatus}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ApplicationVersionText}"
                                           FontSize="11"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CheckApplicationUpdateCommand}"
                                    Classes="SecondaryAction"
                                    MinWidth="104"
                                    Height="34"
                                    Padding="12,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.Updates.Check}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding DownloadApplicationUpdateCommand}"
                                    Classes="SecondaryAction"
                                    MinWidth="104"
                                    Height="34"
                                    Padding="12,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.Updates.Download}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding PlanApplicationRestartCommand}"
                                    Classes="SecondaryAction"
                                    MinWidth="112"
                                    Height="34"
                                    Padding="12,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.Updates.RestartPlan}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ApplicationUpdateItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                    <Border Classes="DiagnosticRow"
                                            Classes.Ready="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}"
                                            Classes.Blocked="{Binding IsBlocked}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="220"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Classes="DiagnosticPanel"
                        IsVisible="{Binding HasBlockingItems}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Lang.Diagnostics.BlockingItems.Title}"
                                   Classes="SectionTitle"
                                   Foreground="{DynamicResource AccentErrorBrush}"/>
                        <ItemsControl ItemsSource="{Binding BlockingItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4"
                      ColumnDefinitions="*, *"
                      RowDefinitions="Auto, Auto"
                      ColumnSpacing="16"
                      RowSpacing="16">
                    <Border Grid.Row="0" Grid.Column="0" Classes="DiagnosticPanel">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource Lang.Diagnostics.AiRuntime.Title}"
                                       Classes="SectionTitle"/>
                            <ItemsControl ItemsSource="{Binding AiRuntimeItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                        <Border Classes="DiagnosticRow"
                                                Classes.Ready="{Binding IsReady}"
                                                Classes.Warning="{Binding IsWarning}"
                                                Classes.Blocked="{Binding IsBlocked}">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                                <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                                <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Value}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="190"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Classes="DiagnosticPanel">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource Lang.Diagnostics.Integrations.Title}"
                                       Classes="SectionTitle"/>
                            <ItemsControl ItemsSource="{Binding IntegrationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                        <Border Classes="DiagnosticRow"
                                                Classes.Ready="{Binding IsReady}"
                                                Classes.Warning="{Binding IsWarning}">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                                <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Value}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="DiagnosticPanel">
                        <Grid RowDefinitions="Auto, Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                <TextBlock Text="{DynamicResource Lang.Diagnostics.LocalRuntime.Title}"
                                           Classes="SectionTitle"/>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SkillSmokeStatus}"
                                               FontSize="11"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Command="{Binding RunSkillSmokeCommand}"
                                            Classes="SecondaryAction"
                                            MinWidth="132"
                                            Height="34"
                                            Padding="12,0"
                                            >
                                        <TextBlock Text="{DynamicResource Lang.Diagnostics.SkillSmoke.Run}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding LastRefreshText}"
                                           FontSize="11"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RuntimeItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                        <Border Classes="DiagnosticRow"
                                                Classes.Ready="{Binding IsReady}"
                                                Classes.Warning="{Binding IsWarning}"
                                                Classes.Blocked="{Binding IsBlocked}">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                                <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                                <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Value}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
