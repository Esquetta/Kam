<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.RuntimeDiagnosticsView"
             x:DataType="vm:RuntimeDiagnosticsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.ReadinessCard">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="112"/>
        </Style>

        <Style Selector="Border.DiagnosticPanel">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="Border.DiagnosticRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style Selector="Border.ReadinessCard.Blocked">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentErrorGlowBrush}"/>
        </Style>

        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Ellipse.ReadyDot">
            <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>

        <Style Selector="Ellipse.WarningDot">
            <Setter Property="Fill" Value="{DynamicResource AccentOrangeBrush}"/>
        </Style>

        <Style Selector="Ellipse.BlockedDot">
            <Setter Property="Fill" Value="{DynamicResource AccentErrorBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
              Classes="WorkbenchPage"
              Margin="32,28,32,40"
              HorizontalAlignment="Stretch">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Runtime diagnostics"
                               Classes="PageTitle"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Live readiness of the model, host, skills and integrations."
                                   Classes="PageSubtitle"
                                   VerticalAlignment="Center"/>
                        <Border Classes="Pill Accent">
                            <TextBlock Text="{Binding CoreReadinessStatus}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Classes="SecondaryAction"
                        MinWidth="112"
                        Height="36"
                        Padding="14,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.01 17.75,13.96 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12C20,7.58 16.42,4 12,4M6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18C8.69,18 6,15.31 6,12C6,10.99 6.25,10.04 6.7,9.2Z"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              Fill="{DynamicResource AccentBrush}"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryCards}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                        <Border Classes="ReadinessCard"
                                Classes.Ready="{Binding IsReady}"
                                Classes.Warning="{Binding IsWarning}"
                                Classes.Blocked="{Binding IsBlocked}"
                                Margin="0,0,12,12">
                            <Grid RowDefinitions="Auto, Auto, *" RowSpacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                    <Ellipse Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                    <Ellipse Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                    <Ellipse Classes="StatusDot" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsNeutral}"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Value}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Detail}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Classes="DiagnosticPanel">
                <Grid RowDefinitions="Auto, Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Live production test"
                                       Classes="SectionTitle"/>
                            <TextBlock Text="{Binding LiveTestNextAction}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ReadinessReportCopyStatus}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CopyReadinessReportCommand}"
                                Classes="SecondaryAction"
                                MinWidth="112"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="Copy Report"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Border Grid.Column="2"
                                Classes="Pill"
                                VerticalAlignment="Top"
                                Margin="0,8,0,0">
                            <TextBlock Text="{Binding LiveTestStatus}"/>
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LiveTestSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                <Border Classes="DiagnosticRow"
                                        Classes.Ready="{Binding IsReady}"
                                        Classes.Warning="{Binding IsWarning}"
                                        Classes.Blocked="{Binding IsBlocked}">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                        <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                        <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                        <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Classes="DiagnosticPanel"
                    IsVisible="{Binding HasSetupActionItems}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Setup actions"
                               Classes="SectionTitle"/>
                    <ItemsControl ItemsSource="{Binding SetupActionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                <Border Classes="DiagnosticRow"
                                        Classes.Ready="{Binding IsReady}"
                                        Classes.Warning="{Binding IsWarning}"
                                        Classes.Blocked="{Binding IsBlocked}">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                        <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                        <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                        <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="160"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Classes="DiagnosticPanel">
                <Grid RowDefinitions="Auto, Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="App updates"
                                       Classes="SectionTitle"/>
                            <TextBlock Text="{Binding ApplicationUpdateActionStatus}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ApplicationVersionText}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CheckApplicationUpdateCommand}"
                                Classes="SecondaryAction"
                                MinWidth="104"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="Check"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding DownloadApplicationUpdateCommand}"
                                Classes="SecondaryAction"
                                MinWidth="104"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="Download"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding PlanApplicationRestartCommand}"
                                Classes="SecondaryAction"
                                MinWidth="112"
                                Height="34"
                                Padding="12,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="Restart Plan"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ApplicationUpdateItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                <Border Classes="DiagnosticRow"
                                        Classes.Ready="{Binding IsReady}"
                                        Classes.Warning="{Binding IsWarning}"
                                        Classes.Blocked="{Binding IsBlocked}">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                        <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                        <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                        <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="220"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    Classes="DiagnosticPanel"
                    IsVisible="{Binding HasBlockingItems}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Blocking items"
                               Classes="SectionTitle"
                               Foreground="{DynamicResource AccentErrorBrush}"/>
                    <ItemsControl ItemsSource="{Binding BlockingItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="6"
                  ColumnDefinitions="*, *"
                  RowDefinitions="Auto, Auto"
                  ColumnSpacing="16"
                  RowSpacing="16">
                <Border Grid.Row="0" Grid.Column="0" Classes="DiagnosticPanel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AI runtime"
                                   Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding AiRuntimeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                    <Border Classes="DiagnosticRow"
                                            Classes.Ready="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}"
                                            Classes.Blocked="{Binding IsBlocked}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="190"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Classes="DiagnosticPanel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Integrations"
                                   Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding IntegrationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                    <Border Classes="DiagnosticRow"
                                            Classes.Ready="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="DiagnosticPanel">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                            <TextBlock Text="Local runtime"
                                       Classes="SectionTitle"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SkillSmokeStatus}"
                                           FontSize="11"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Command="{Binding RunSkillSmokeCommand}"
                                        Classes="SecondaryAction"
                                        MinWidth="132"
                                        Height="34"
                                        Padding="12,0"
                                        >
                                    <TextBlock Text="Run Skill Smoke"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding LastRefreshText}"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RuntimeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                    <Border Classes="DiagnosticRow"
                                            Classes.Ready="{Binding IsReady}"
                                            Classes.Warning="{Binding IsWarning}"
                                            Classes.Blocked="{Binding IsBlocked}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Classes="StatusDot ReadyDot" IsVisible="{Binding IsReady}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot WarningDot" IsVisible="{Binding IsWarning}"/>
                                            <Ellipse Grid.Column="0" Classes="StatusDot BlockedDot" IsVisible="{Binding IsBlocked}"/>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
