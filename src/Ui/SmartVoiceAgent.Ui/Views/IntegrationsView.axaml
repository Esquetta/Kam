<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             xmlns:services="clr-namespace:SmartVoiceAgent.Ui.Services"
             xmlns:converters="clr-namespace:SmartVoiceAgent.Ui.Converters"
             x:Class="SmartVoiceAgent.Ui.Views.IntegrationsView"
             x:DataType="vm:IntegrationsViewModel">

    <UserControl.Resources>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Pane body: the fields and the actions under the head -->
        <Style Selector="StackPanel.PaneBody">
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Spacing" Value="16"/>
        </Style>
        <!-- Actions sit on the right: Clear (only when something is saved), then Save -->
        <Style Selector="StackPanel.FormActions">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="StackPanel.FormActions > Button">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The Pane border closes the last CLI row -->
        <Style Selector="ItemsControl.CliRows ContentPresenter:nth-last-child(1) > Border.PaneRow">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Classes="WorkbenchPage PageColumn Form" RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Integrations.Title}" Classes="PageTitle"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Lang.Integrations.Subtitle}" Classes="PageSubtitle"/>
                        <Button Grid.Column="1"
                                Classes="InfoTip"
                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                ToolTip.Tip="{DynamicResource Lang.Integrations.Info}">
                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- One Pane per integration -->
            <StackPanel Grid.Row="1" Spacing="16">

                <!-- Todoist -->
                <Border Classes="Pane">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Todoist" Classes="SectionTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{Binding TodoistDescription}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.Todoist.Subtitle}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="PaneStatus">
                                    <Border Classes="StatusDot"
                                            Classes.Success="{Binding TodoistBadge.IsSuccess}"
                                            Classes.Warning="{Binding TodoistBadge.IsWarning}"
                                            Classes.Danger="{Binding TodoistBadge.IsDanger}"
                                            Classes.Accent="{Binding TodoistBadge.IsAccent}"/>
                                    <TextBlock Text="{Binding TodoistStatusText}" Classes="Secondary"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Classes="PaneBody">
                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Todoist.ApiKey}" Classes="Label"/>
                                <TextBox Text="{Binding TodoistApiKey, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource Lang.Integrations.Todoist.ApiKeyPlaceholder}"
                                         PasswordChar="●"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Todoist.ApiKey}"/>
                            </StackPanel>
                            <StackPanel Classes="FormActions">
                                <Button Command="{Binding ClearTodoistCommand}"
                                        Classes="GhostAction Sm"
                                        IsVisible="{Binding HasSavedTodoist}"
                                        Content="{DynamicResource Lang.Common.Clear}"/>
                                <Button Command="{Binding SaveTodoistCommand}"
                                        Classes.PrimaryAction="{Binding IsTodoistDirty}"
                                        Classes.SecondaryAction="{Binding !IsTodoistDirty}"
                                        IsEnabled="{Binding TodoistApiKey, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                                        Content="{DynamicResource Lang.Common.Save}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Web search -->
                <Border Classes="Pane">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.WebSearch.Title}" Classes="SectionTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{Binding WebSearchDescription}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.WebSearch.Subtitle}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- Search works with or without a Google key, so the status names the source -->
                                <StackPanel Grid.Column="1" Classes="PaneStatus">
                                    <Border Classes="StatusDot"
                                            Classes.Success="{Binding WebSearchBadge.IsSuccess}"
                                            Classes.Warning="{Binding WebSearchBadge.IsWarning}"
                                            Classes.Danger="{Binding WebSearchBadge.IsDanger}"
                                            Classes.Accent="{Binding WebSearchBadge.IsAccent}"/>
                                    <TextBlock Text="{Binding WebSearchStatusText}" Classes="Secondary"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Classes="PaneBody">
                            <!-- Both fields are short, so they share a row -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Classes="Field">
                                    <TextBlock Text="{DynamicResource Lang.Integrations.WebSearch.ApiKey}" Classes="Label"/>
                                    <TextBox Text="{Binding WebSearchApiKey, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Lang.Integrations.WebSearch.ApiKeyPlaceholder}"
                                             PasswordChar="●"
                                             AutomationProperties.Name="{DynamicResource Lang.Integrations.WebSearch.ApiKey}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="Field">
                                    <TextBlock Text="{DynamicResource Lang.Integrations.WebSearch.EngineId}" Classes="Label"/>
                                    <TextBox Text="{Binding WebSearchEngineId, Mode=TwoWay}"
                                             PlaceholderText="{DynamicResource Lang.Integrations.WebSearch.EngineIdPlaceholder}"
                                             AutomationProperties.Name="{DynamicResource Lang.Integrations.WebSearch.EngineId}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Classes="FormActions">
                                <Button Command="{Binding ClearWebSearchCommand}"
                                        Classes="GhostAction Sm"
                                        IsVisible="{Binding IsWebSearchConfigured}"
                                        Content="{DynamicResource Lang.Common.Clear}"/>
                                <Button Command="{Binding SaveWebSearchCommand}"
                                        Classes.PrimaryAction="{Binding IsWebSearchDirty}"
                                        Classes.SecondaryAction="{Binding !IsWebSearchDirty}"
                                        IsEnabled="{Binding CanSaveWebSearch}"
                                        Content="{DynamicResource Lang.Common.Save}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Coding agent CLIs: the user's own signed-in Codex CLI runs delegated tasks on its plan. -->
                <Border Classes="Pane"
                        DataContext="{Binding CliAgents}"
                        x:DataType="vm:CliAgentsViewModel">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.CliAgents.Title}" Classes="SectionTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{DynamicResource Lang.Integrations.CliAgents.Description}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.CliAgents.Subtitle}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="IconButton"
                                        VerticalAlignment="Center"
                                        Command="{Binding RefreshCommand}"
                                        AutomationProperties.Name="{DynamicResource Lang.Integrations.CliAgents.Refresh}"
                                        ToolTip.Tip="{DynamicResource Lang.Integrations.CliAgents.Refresh}"
                                        IsEnabled="{Binding !IsChecking}">
                                    <Viewbox Width="16" Height="16"><Path Classes="Icon" Data="{StaticResource IconRefresh}"/></Viewbox>
                                </Button>
                            </Grid>
                        </Border>

                        <ItemsControl Classes="CliRows" ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CliAgentRowViewModel">
                                    <Border Classes="PaneRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" Classes="RowTitle"/>
                                                    <TextBlock Text="{Binding VersionText}"
                                                               Classes="Caption Mono"
                                                               VerticalAlignment="Center"/>
                                                    <Button Classes="InfoTip"
                                                            AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                            ToolTip.Tip="{Binding Note}">
                                                        <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Classes="PaneStatus" HorizontalAlignment="Left">
                                                    <Border Classes="StatusDot"
                                                            Classes.Success="{Binding Badge.IsSuccess}"
                                                            Classes.Warning="{Binding Badge.IsWarning}"
                                                            Classes.Danger="{Binding Badge.IsDanger}"
                                                            Classes.Accent="{Binding Badge.IsAccent}"/>
                                                    <TextBlock Text="{Binding StatusText}" Classes="Secondary"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <ToggleSwitch Grid.Column="1"
                                                          Classes="RowToggle"
                                                          AutomationProperties.Name="{Binding Name}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanToggle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- GitHub -->
                <Border Classes="Pane">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="GitHub" Classes="SectionTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{Binding GitHubAppDescription}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.GitHub.Subtitle}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="PaneStatus">
                                    <Border Classes="StatusDot"
                                            Classes.Success="{Binding GitHubBadge.IsSuccess}"
                                            Classes.Warning="{Binding GitHubBadge.IsWarning}"
                                            Classes.Danger="{Binding GitHubBadge.IsDanger}"
                                            Classes.Accent="{Binding GitHubBadge.IsAccent}"/>
                                    <TextBlock Text="{Binding GitHubAppStatusText}" Classes="Secondary"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Classes="PaneBody">
                            <Border Classes="Note">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding GitHubConnectionStatusText}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding GitHubConnectionDetailText}"/>
                                    <TextBlock Text="{Binding GitHubRepositoryPreviewText}"
                                               IsVisible="{Binding HasGitHubRepositoryPreview}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Classes="FormActions">
                                <Button Command="{Binding ToggleGitHubAppAdvancedSettingsCommand}"
                                        Classes="GhostAction"
                                        Content="{DynamicResource Lang.Integrations.GitHub.Advanced}"/>
                                <Button Command="{Binding ListGitHubAppRepositoriesCommand}"
                                        Classes="SecondaryAction"
                                        IsEnabled="{Binding CanListGitHubAppRepositories}"
                                        Content="{DynamicResource Lang.Integrations.GitHub.RefreshRepositories}"/>
                                <Button Command="{Binding ConnectGitHubCommand}"
                                        Classes="SecondaryAction"
                                        IsEnabled="{Binding CanConnectGitHub}"
                                        Content="{DynamicResource Lang.Integrations.GitHub.Connect}"/>
                            </StackPanel>

                            <StackPanel Spacing="16"
                                        IsVisible="{Binding ShowGitHubAppAdvancedSettings}">
                                <StackPanel Spacing="8"
                                            IsVisible="{Binding HasGitHubAppSetupSteps}">
                                    <TextBlock Text="{DynamicResource Lang.Integrations.GitHub.SetupChecklist}" Classes="Label"/>
                                    <ItemsControl ItemsSource="{Binding GitHubAppSetupSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RuntimeDiagnosticItemViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="10"
                                                      Margin="0,0,0,8">
                                                    <Ellipse Grid.Column="0"
                                                             Width="6"
                                                             Height="6"
                                                             Fill="{DynamicResource AccentGreenBrush}"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsReady}"/>
                                                    <Ellipse Grid.Column="0"
                                                             Width="6"
                                                             Height="6"
                                                             Fill="{DynamicResource AccentOrangeBrush}"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsWarning}"/>
                                                    <Ellipse Grid.Column="0"
                                                             Width="6"
                                                             Height="6"
                                                             Fill="{DynamicResource AccentErrorBrush}"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsBlocked}"/>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" Classes="RowTitle"/>
                                                        <TextBlock Text="{Binding Detail}" Classes="Secondary" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Value}"
                                                               Classes="Caption Mono"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               MaxWidth="120"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Classes="Field">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.GitHub.AppId}" Classes="Label"/>
                                        <TextBox Text="{Binding GitHubAppId, Mode=TwoWay}"
                                                 PlaceholderText="123456"
                                                 AutomationProperties.Name="{DynamicResource Lang.Integrations.GitHub.AppId}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Classes="Field">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.GitHub.InstallationId}" Classes="Label"/>
                                        <TextBox Text="{Binding GitHubInstallationId, Mode=TwoWay}"
                                                 PlaceholderText="987654"
                                                 AutomationProperties.Name="{DynamicResource Lang.Integrations.GitHub.InstallationId}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Classes="Field">
                                    <TextBlock Text="{DynamicResource Lang.Integrations.GitHub.PrivateKeyPath}" Classes="Label"/>
                                    <TextBox Text="{Binding GitHubPrivateKeyPath, Mode=TwoWay}"
                                             PlaceholderText="C:\secure\kam-github-app.pem"
                                             AutomationProperties.Name="{DynamicResource Lang.Integrations.GitHub.PrivateKeyPath}"/>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.GitHub.PrivateKeyHint}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Classes="FormActions">
                                    <Button Command="{Binding ClearGitHubAppCommand}"
                                            Classes="GhostAction Sm"
                                            IsVisible="{Binding HasSavedGitHubApp}"
                                            Content="{DynamicResource Lang.Common.Clear}"/>
                                    <Button Command="{Binding ListGitHubAppRepositoriesCommand}"
                                            Classes="SecondaryAction"
                                            IsEnabled="{Binding CanListGitHubAppRepositories}"
                                            Content="{DynamicResource Lang.Integrations.GitHub.ListRepositories}"/>
                                    <Button Command="{Binding TestGitHubAppConnectionCommand}"
                                            Classes="SecondaryAction"
                                            IsEnabled="{Binding CanTestGitHubAppConnection}"
                                            Content="{DynamicResource Lang.Integrations.GitHub.TestConnection}"/>
                                    <Button Command="{Binding SaveGitHubAppCommand}"
                                            Classes.PrimaryAction="{Binding IsGitHubAppDirty}"
                                            Classes.SecondaryAction="{Binding !IsGitHubAppDirty}"
                                            Content="{DynamicResource Lang.Common.Save}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Email (SMTP) -->
                <Border Classes="Pane">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.Email.Title}" Classes="SectionTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{Binding EmailDescription}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.Email.Subtitle}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="PaneStatus">
                                    <Border Classes="StatusDot"
                                            Classes.Success="{Binding EmailBadge.IsSuccess}"
                                            Classes.Warning="{Binding EmailBadge.IsWarning}"
                                            Classes.Danger="{Binding EmailBadge.IsDanger}"
                                            Classes.Accent="{Binding EmailBadge.IsAccent}"/>
                                    <TextBlock Text="{Binding EmailStatusText}" Classes="Secondary"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Classes="PaneBody">
                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Email.Provider}" Classes="Label"/>
                                <ComboBox ItemsSource="{Binding EmailProviderOptions}"
                                          SelectedItem="{Binding SelectedEmailProviderOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.Provider}"/>
                            </StackPanel>

                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Email.Username}" Classes="Label"/>
                                <TextBox Text="{Binding SmtpUsername, Mode=TwoWay}"
                                         PlaceholderText="your.email@gmail.com"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.Username}"/>
                            </StackPanel>

                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Email.Password}" Classes="Label"/>
                                <TextBox Text="{Binding SmtpPassword, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource Lang.Integrations.Email.PasswordPlaceholder}"
                                         PasswordChar="●"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.Password}"/>
                                <TextBlock Text="{DynamicResource Lang.Integrations.Email.GmailTip}"
                                           Classes="Secondary"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding EmailProvider, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Gmail}"/>
                            </StackPanel>

                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Email.Sender}" Classes="Label"/>
                                <TextBox Text="{Binding SenderEmail, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource Lang.Integrations.Email.SenderPlaceholder}"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.Sender}"/>
                            </StackPanel>

                            <ToggleButton Classes="Disclosure"
                                          IsChecked="{Binding ShowEmailAdvanced, Mode=TwoWay}"
                                          HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="Chevron" Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconChevronDown}"/></Viewbox>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.Email.Advanced}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <StackPanel IsVisible="{Binding ShowEmailAdvanced}" Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Classes="Field">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.Email.SmtpHost}" Classes="Label"/>
                                        <TextBox Text="{Binding SmtpHost, Mode=TwoWay}"
                                                 PlaceholderText="smtp.gmail.com"
                                                 AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.SmtpHost}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Classes="Field" Width="100">
                                        <TextBlock Text="{DynamicResource Lang.Integrations.Email.Port}" Classes="Label"/>
                                        <TextBox Text="{Binding SmtpPort, Mode=TwoWay}"
                                                 PlaceholderText="587"
                                                 AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.Port}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="{DynamicResource Lang.Integrations.Email.EnableSsl}"
                                               Classes="RowTitle"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1"
                                                  Classes="RowToggle"
                                                  AutomationProperties.Name="{DynamicResource Lang.Integrations.Email.EnableSsl}"
                                                  IsChecked="{Binding SmtpEnableSsl, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Classes="FormActions">
                                <Button Command="{Binding ClearEmailCommand}"
                                        Classes="GhostAction Sm"
                                        IsVisible="{Binding HasSavedEmail}"
                                        Content="{DynamicResource Lang.Common.Clear}"/>
                                <Button Command="{Binding SaveEmailCommand}"
                                        Classes.PrimaryAction="{Binding IsEmailDirty}"
                                        Classes.SecondaryAction="{Binding !IsEmailDirty}"
                                        Content="{DynamicResource Lang.Common.Save}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SMS (Twilio) -->
                <Border Classes="Pane">
                    <StackPanel>
                        <Border Classes="PaneHead">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="SMS (Twilio)" Classes="SectionTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{Binding SmsDescription}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Integrations.Sms.Subtitle}" Classes="Secondary" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="PaneStatus">
                                    <Border Classes="StatusDot"
                                            Classes.Success="{Binding SmsBadge.IsSuccess}"
                                            Classes.Warning="{Binding SmsBadge.IsWarning}"
                                            Classes.Danger="{Binding SmsBadge.IsDanger}"
                                            Classes.Accent="{Binding SmsBadge.IsAccent}"/>
                                    <TextBlock Text="{Binding SmsStatusText}" Classes="Secondary"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Classes="PaneBody">
                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Sms.AccountSid}" Classes="Label"/>
                                <TextBox Text="{Binding TwilioAccountSid, Mode=TwoWay}"
                                         PlaceholderText="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Sms.AccountSid}"/>
                            </StackPanel>

                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Sms.AuthToken}" Classes="Label"/>
                                <TextBox Text="{Binding TwilioAuthToken, Mode=TwoWay}"
                                         PlaceholderText="{DynamicResource Lang.Integrations.Sms.AuthTokenPlaceholder}"
                                         PasswordChar="●"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Sms.AuthToken}"/>
                            </StackPanel>

                            <StackPanel Classes="Field">
                                <TextBlock Text="{DynamicResource Lang.Integrations.Sms.PhoneNumber}" Classes="Label"/>
                                <TextBox Text="{Binding TwilioPhoneNumber, Mode=TwoWay}"
                                         PlaceholderText="+1234567890"
                                         AutomationProperties.Name="{DynamicResource Lang.Integrations.Sms.PhoneNumber}"/>
                                <TextBlock Text="{DynamicResource Lang.Integrations.Sms.PhoneNumberFormat}" Classes="Secondary"/>
                            </StackPanel>

                            <StackPanel Classes="FormActions">
                                <Button Command="{Binding ClearSmsCommand}"
                                        Classes="GhostAction Sm"
                                        IsVisible="{Binding HasSavedSms}"
                                        Content="{DynamicResource Lang.Common.Clear}"/>
                                <Button Command="{Binding SaveSmsCommand}"
                                        Classes.PrimaryAction="{Binding IsSmsDirty}"
                                        Classes.SecondaryAction="{Binding !IsSmsDirty}"
                                        Content="{DynamicResource Lang.Common.Save}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
