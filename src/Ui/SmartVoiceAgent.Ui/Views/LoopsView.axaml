<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartVoiceAgent.Ui.ViewModels.PageModels"
             xmlns:services="using:SmartVoiceAgent.Ui.Services"
             x:Class="SmartVoiceAgent.Ui.Views.LoopsView"
             x:DataType="vm:LoopsViewModel">
    <UserControl.Styles>
        <!-- The input sits on the right of its label; below 760 px it moves under the label -->
        <Style Selector="Grid.SettingRow > TextBox.WithUnit">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
        </Style>
        <Style Selector="StackPanel.WorkbenchPage.narrow Grid.SettingRow">
            <Setter Property="RowSpacing" Value="8"/>
        </Style>
        <Style Selector="StackPanel.WorkbenchPage.narrow Grid.SettingRow > TextBox.WithUnit">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage PageColumn Form"
                    Classes.narrow="{Binding Source={x:Static services:WindowStateManager.Instance}, Path=IsRailCompact}">

            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Loops.Title}" Classes="PageTitle"/>
                    <TextBlock Text="{DynamicResource Lang.Loops.Subtitle}" Classes="PageSubtitle"/>
                </StackPanel>
            </Grid>

            <!-- Limits: saved on commit and used by the next message -->
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Lang.Loops.Limits.Title}" Classes="SectionTitle" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding ResetCommand}"
                            Classes="GhostAction Sm"
                            Content="{DynamicResource Lang.Loops.Reset}"/>
                </Grid>

                <Border Classes="Pane">
                    <StackPanel Classes="SettingRows">
                        <Border Classes="PaneRow">
                            <Grid Classes="SettingRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Classes="SettingText">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource Lang.Loops.Steps.Label}" Classes="RowTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{DynamicResource Lang.Loops.Steps.Tip}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Loops.Steps.Help}" Classes="Secondary"/>
                                </StackPanel>
                                <TextBox Classes="WithUnit"
                                         Text="{Binding MaxIterationsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="OnLimitKeyDown"
                                         AutomationProperties.Name="{DynamicResource Lang.Loops.Steps.Label}">
                                    <TextBox.InnerRightContent>
                                        <TextBlock Text="{DynamicResource Lang.Loops.Steps.Unit}" Classes="UnitSuffix"/>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>
                        </Border>
                        <Border Classes="PaneRow">
                            <Grid Classes="SettingRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Classes="SettingText">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource Lang.Loops.Result.Label}" Classes="RowTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{DynamicResource Lang.Loops.Result.Tip}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Loops.Result.Help}" Classes="Secondary"/>
                                </StackPanel>
                                <TextBox Classes="WithUnit"
                                         Text="{Binding MaxToolResultCharactersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="OnLimitKeyDown"
                                         AutomationProperties.Name="{DynamicResource Lang.Loops.Result.Label}">
                                    <TextBox.InnerRightContent>
                                        <TextBlock Text="{DynamicResource Lang.Loops.Result.Unit}" Classes="UnitSuffix"/>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>
                        </Border>
                        <Border Classes="PaneRow">
                            <Grid Classes="SettingRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Classes="SettingText">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{DynamicResource Lang.Loops.Context.Label}" Classes="RowTitle"/>
                                        <Button Classes="InfoTip"
                                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                                ToolTip.Tip="{DynamicResource Lang.Loops.Context.Tip}">
                                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Lang.Loops.Context.Help}" Classes="Secondary"/>
                                </StackPanel>
                                <TextBox Classes="WithUnit"
                                         Text="{Binding ContextTokenBudgetText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="OnLimitKeyDown"
                                         AutomationProperties.Name="{DynamicResource Lang.Loops.Context.Label}">
                                    <TextBox.InnerRightContent>
                                        <TextBlock Text="{DynamicResource Lang.Loops.Context.Unit}" Classes="UnitSuffix"/>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
