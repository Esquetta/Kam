<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.RunsView"
             x:DataType="vm:RunsViewModel">
    <UserControl.Styles>
        <!-- The table: Name, Model, Status, Steps, When. The header and every row share these columns;
             below 640 px the table scrolls sideways. A task's subagent runs sit under it, indented on a tree line. -->
        <Style Selector="TextBox.RunsSearch">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.narrow TextBox.RunsSearch">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Nested rows drop the hairline above them, so the tree line runs on from the task row -->
        <Style Selector="Border.TableRow.Nested">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Border.TreeLine">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="9,0,14,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderMutedBrush}"/>
        </Style>

        <!-- The chevron points right when folded and down when open -->
        <Style Selector="Viewbox.RowChevron">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
        </Style>
        <Style Selector="Viewbox.RowChevron.open">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
        <Style Selector="Button.ChildrenToggle">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page" Classes="WorkbenchPage PageColumn List">

            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Runs.Title}" Classes="PageTitle"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Lang.Runs.Subtitle}" Classes="PageSubtitle"/>
                        <Button Grid.Column="1"
                                Classes="InfoTip"
                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                ToolTip.Tip="{DynamicResource Lang.Runs.SubtitleTip}">
                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Toolbar: filter on the left, search on the right -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                <Border Classes="Segmented" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="DrawerTab" Classes.Selected="{Binding IsFilterAll}" MinWidth="72"
                                Content="{DynamicResource Lang.Runs.Filter.All}"
                                Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                        <Button Classes="DrawerTab" Classes.Selected="{Binding IsFilterTasks}" MinWidth="72"
                                Content="{DynamicResource Lang.Runs.Filter.Tasks}"
                                Command="{Binding SetFilterCommand}" CommandParameter="Tasks"/>
                        <Button Classes="DrawerTab" Classes.Selected="{Binding IsFilterAgentRuns}" MinWidth="72"
                                Content="{DynamicResource Lang.Runs.Filter.AgentRuns}"
                                Command="{Binding SetFilterCommand}" CommandParameter="AgentRuns"/>
                    </StackPanel>
                </Border>
                <TextBox Classes="Search RunsSearch"
                         Text="{Binding SearchText}"
                         PlaceholderText="{DynamicResource Lang.Runs.Search.Placeholder}">
                    <TextBox.InnerLeftContent>
                        <Viewbox Classes="SearchIcon">
                            <Path Classes="Icon Muted" Data="{StaticResource IconSearch}"/>
                        </Viewbox>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>

            <!-- Empty state: no history yet, or nothing matches the filter -->
            <StackPanel Classes="EmptyState" IsVisible="{Binding IsEmpty}">
                <Viewbox><Path Classes="Icon" Data="{StaticResource IconHistory}"/></Viewbox>
                <TextBlock Text="{Binding EmptyTitle}" Classes="EmptyTitle"/>
                <TextBlock Text="{Binding EmptyBody}" Classes="EmptyBody"/>
            </StackPanel>

            <!-- The table scrolls sideways when the page is narrower than 640 px -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
                <Border Classes="Pane" MinWidth="640">
                    <StackPanel>
                        <Grid Classes="TableHeader" ColumnDefinitions="*,160,120,56,88">
                            <TextBlock Grid.Column="0" Text="{DynamicResource Lang.Runs.Column.Name}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Lang.Runs.Column.Model}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Lang.Runs.Column.Status}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Lang.Runs.Column.Count}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource Lang.Runs.Column.When}" TextAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RunRowViewModel">
                                    <StackPanel>
                                        <Border Classes="TableRow"
                                                Classes.Nested="{Binding IsNested}"
                                                Cursor="Hand"
                                                Tapped="OnRowTapped">
                                            <Grid ColumnDefinitions="*,160,120,56,88">
                                                <!-- Name: tree line for a subagent run, chevron for a task with runs or a run with detail -->
                                                <Grid ColumnDefinitions="Auto,20,*" ColumnSpacing="6">
                                                    <Border Classes="TreeLine" IsVisible="{Binding IsNested}"/>
                                                    <Button Grid.Column="1"
                                                            Classes="IconButton ChildrenToggle"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasChildren}"
                                                            AutomationProperties.Name="{DynamicResource Lang.Runs.ToggleSubagents}"
                                                            ToolTip.Tip="{DynamicResource Lang.Runs.ToggleSubagents}"
                                                            Command="{Binding $parent[UserControl].((vm:RunsViewModel)DataContext).ToggleChildrenCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Viewbox Classes="RowChevron" Classes.open="{Binding IsChildrenExpanded}">
                                                            <Path Classes="Icon" Data="{StaticResource IconChevronDown}"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <Viewbox Grid.Column="1"
                                                             Classes="RowChevron"
                                                             Classes.open="{Binding IsExpanded}"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding CanExpand}">
                                                        <Path Classes="Icon Muted" Data="{StaticResource IconChevronDown}"/>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Name}"
                                                               Classes="RowTitle"
                                                               FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip.Tip="{Binding ContextTooltip}"/>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding ModelText}"
                                                           Classes="Secondary Mono"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding ModelText}"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Classes="StatusDot"
                                                            Classes.Accent="{Binding IsRunning}"
                                                            Classes.Warning="{Binding IsNeedsYou}"
                                                            Classes.Success="{Binding IsDone}"
                                                            Classes.Danger="{Binding IsFailed}"/>
                                                    <TextBlock Text="{Binding StatusText}" Classes="StatusText" Classes.Danger="{Binding IsFailed}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Count}"
                                                           Classes="Secondary"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding CountTooltip}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding WhenText}"
                                                           Classes="Secondary"
                                                           TextAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding WhenTooltip}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Agent run detail: task, tool calls, then the response or the error -->
                                        <Border Padding="42,4,16,16" IsVisible="{Binding IsExpanded}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{DynamicResource Lang.Runs.Detail.Task}" Classes="Caption"/>
                                                    <SelectableTextBlock Text="{Binding TaskText}" TextWrapping="Wrap"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4" IsVisible="{Binding HasObservations}">
                                                    <TextBlock Text="{DynamicResource Lang.Runs.Detail.ToolCalls}" Classes="Caption"/>
                                                    <ItemsControl ItemsSource="{Binding Observations}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:RunObservationItem">
                                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                                    <Border Classes="StatusDot" Classes.Success="{Binding Success}" Classes.Danger="{Binding !Success}"/>
                                                                    <TextBlock Text="{Binding Skill}" Classes="Secondary Mono"/>
                                                                    <TextBlock Text="{Binding Summary}" FontSize="12"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               TextWrapping="Wrap" MaxWidth="560"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Spacing="4" IsVisible="{Binding HasResponse}">
                                                    <TextBlock Text="{DynamicResource Lang.Runs.Detail.Response}" Classes="Caption"/>
                                                    <SelectableTextBlock Text="{Binding ResponseText}" TextWrapping="Wrap"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4" IsVisible="{Binding HasError}">
                                                    <TextBlock Text="{DynamicResource Lang.Runs.Detail.Error}" Classes="Caption"/>
                                                    <SelectableTextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                                                                         Foreground="{DynamicResource AccentErrorBrush}"/>
                                                </StackPanel>
                                                <Button Classes="LinkAction" HorizontalAlignment="Left"
                                                        IsVisible="{Binding IsSubagent}"
                                                        Content="{DynamicResource Lang.Runs.Detail.OpenGraph}"
                                                        Command="{Binding $parent[UserControl].((vm:RunsViewModel)DataContext).OpenGraphCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </StackPanel>
    </ScrollViewer>
</UserControl>
