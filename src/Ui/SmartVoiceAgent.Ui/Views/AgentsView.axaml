<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagevm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.AgentsView"
             x:DataType="pagevm:AgentsViewModel">

    <UserControl.Styles>
        <!-- Two columns (.a-cols): the list on the left, the detail on the right. The code-behind sets "narrow"
             on the page, and the panes then stack. -->
        <Style Selector="StackPanel.AgentsListPane">
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style Selector="Border.AgentsDetailPane">
            <Setter Property="Grid.Column" Value="2"/>
        </Style>
        <Style Selector="StackPanel.narrow StackPanel.AgentsListPane">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
        </Style>
        <Style Selector="StackPanel.narrow Border.AgentsDetailPane">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <!-- A list row is a flat button around a ListRow card -->
        <Style Selector="Button.AgentRowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.AgentRowButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.AgentRowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.ListRow.Selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Border.AgentAvatar">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.AgentAvatar TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.AgentValue">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Page"
                    Classes="WorkbenchPage"
                    Margin="16,18"
                    Spacing="14">

            <!-- Page head: eyebrow, title and the explanation strip -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{DynamicResource Lang.Agents.Eyebrow}" Classes="Overline" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lang.Agents.Title}" Classes="PageTitle" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Classes="Explain">
                    <TextBlock Text="{DynamicResource Lang.Agents.Explain}"/>
                </Border>
            </StackPanel>

            <Grid ColumnDefinitions="340,16,*" RowDefinitions="Auto,Auto">

                <!-- List -->
                <StackPanel Classes="AgentsListPane" Spacing="14">

                    <!-- Coding agents -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Lang.Agents.Group.Coding}" Classes="GroupTitle"/>
                        <ItemsControl ItemsSource="{Binding CodingAgents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="pagevm:AgentsCodingAgentItem">
                                    <Button Classes="AgentRowButton" Command="{Binding SelectCommand}">
                                        <Border Classes="ListRow" Classes.Selected="{Binding IsSelected}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="AgentAvatar">
                                                    <TextBlock Text="{Binding Initials}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" Classes="RowTitle"/>
                                                        <TextBlock Text="{Binding VersionText}" Classes="Caption Mono" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SignInText}" Classes="Caption" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <Button Classes="LinkAction"
                                                            HorizontalAlignment="Left"
                                                            Content="{DynamicResource Lang.Agents.SetUp}"
                                                            Command="{Binding OpenIntegrationsCommand}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Classes="Pill"
                                                        Classes.Success="{Binding IsReady}"
                                                        Classes.Warning="{Binding IsSignedOut}"
                                                        VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Classes="ChipDot"/>
                                                        <TextBlock Text="{Binding StatusText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Recent role agents -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource Lang.Agents.Group.Roles}" Classes="GroupTitle"/>
                            <TextBlock Text="{Binding RoleAgents.Count}" Classes="GroupCount" IsVisible="{Binding HasRoleAgents}"/>
                        </StackPanel>

                        <!-- Empty state -->
                        <Border Classes="Note" IsVisible="{Binding HasNoRoleAgents}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Lang.Agents.Empty.Title}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Lang.Agents.Empty.Body}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding RoleAgents}" IsVisible="{Binding HasRoleAgents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="pagevm:AgentsRoleRunItem">
                                    <Button Classes="AgentRowButton" Command="{Binding SelectCommand}">
                                        <Border Classes="ListRow" Classes.Selected="{Binding IsSelected}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="AgentAvatar">
                                                    <TextBlock Text="{Binding Initials}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AgentName}" Classes="RowTitle" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Role}" Classes="Caption" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                                    <Border Classes="Pill"
                                                            Classes.Accent="{Binding IsRunning}"
                                                            Classes.Success="{Binding IsSucceeded}"
                                                            Classes.Danger="{Binding IsFailed}"
                                                            HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Classes="ChipDot"/>
                                                            <TextBlock Text="{Binding StatusText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding RelativeTimeText}" Classes="Caption" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Detail -->
                <Border Classes="Pane AgentsDetailPane" VerticalAlignment="Top">
                    <Panel>

                        <!-- A role-agent run -->
                        <ContentControl Content="{Binding SelectedRole}" IsVisible="{Binding SelectedRole, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="pagevm:AgentsRoleRunItem">
                                    <StackPanel>
                                        <Border Classes="PaneHead">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="AgentAvatar">
                                                    <TextBlock Text="{Binding Initials}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding AgentName}" Classes="SectionTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2"
                                                        Classes="Pill"
                                                        Classes.Accent="{Binding IsRunning}"
                                                        Classes.Success="{Binding IsSucceeded}"
                                                        Classes.Danger="{Binding IsFailed}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Classes="ChipDot"/>
                                                        <TextBlock Text="{Binding StatusText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Classes="PaneRow">
                                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                                                <TextBlock Grid.Row="0" Text="{DynamicResource Lang.Agents.Detail.Role}" Classes="KvKey"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Role}" Classes="KvValue AgentValue"/>
                                                <TextBlock Grid.Row="1" Text="{DynamicResource Lang.Agents.Detail.Model}" Classes="KvKey"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelId}" Classes="KvValue AgentValue Mono"/>
                                                <TextBlock Grid.Row="2" Text="{DynamicResource Lang.Agents.Detail.Started}" Classes="KvKey"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StartedText}" Classes="KvValue AgentValue"/>
                                                <TextBlock Grid.Row="3" Text="{DynamicResource Lang.Agents.Detail.Finished}" Classes="KvKey"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FinishedText}" Classes="KvValue AgentValue"/>
                                                <TextBlock Grid.Row="4" Text="{DynamicResource Lang.Agents.Detail.Duration}" Classes="KvKey"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DurationText}" Classes="KvValue AgentValue"/>
                                            </Grid>
                                        </Border>

                                        <Border Classes="PaneRow">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{DynamicResource Lang.Agents.Detail.Task}" Classes="Overline"/>
                                                <SelectableTextBlock Text="{Binding Task}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Classes="PaneRow" IsVisible="{Binding HasObservations}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource Lang.Agents.Detail.Tools}" Classes="Overline"/>
                                                <ItemsControl ItemsSource="{Binding Observations}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="pagevm:AgentsToolObservationItem">
                                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                                <Border Classes="StatusDot"
                                                                        Classes.Success="{Binding Success}"
                                                                        Classes.Danger="{Binding Failed}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ToolName}" Classes="Caption Mono" TextWrapping="NoWrap"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="Secondary" TextWrapping="Wrap" TextTrimming="None"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Classes="PaneRow" BorderThickness="0">
                                            <StackPanel Spacing="6">
                                                <StackPanel Spacing="6" IsVisible="{Binding HasResponse}">
                                                    <TextBlock Text="{DynamicResource Lang.Agents.Detail.Response}" Classes="Overline"/>
                                                    <SelectableTextBlock Text="{Binding Response}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Spacing="6" IsVisible="{Binding HasError}">
                                                    <TextBlock Text="{DynamicResource Lang.Agents.Detail.Error}" Classes="Overline"/>
                                                    <SelectableTextBlock Text="{Binding ErrorMessage}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AccentErrorBrush}"/>
                                                </StackPanel>
                                                <StackPanel Spacing="6" IsVisible="{Binding HasLastMessageOnly}">
                                                    <TextBlock Text="{DynamicResource Lang.Agents.Detail.Progress}" Classes="Overline"/>
                                                    <TextBlock Text="{Binding LastMessage}" Classes="Secondary" TextWrapping="Wrap" TextTrimming="None"/>
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource Lang.Agents.Detail.NoOutput}" Classes="EmptyText" IsVisible="{Binding HasNoOutput}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- A coding agent -->
                        <ContentControl Content="{Binding SelectedCoding}" IsVisible="{Binding SelectedCoding, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="pagevm:AgentsCodingAgentItem">
                                    <StackPanel>
                                        <Border Classes="PaneHead">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="AgentAvatar">
                                                    <TextBlock Text="{Binding Initials}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="SectionTitle" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2"
                                                        Classes="Pill"
                                                        Classes.Success="{Binding IsReady}"
                                                        Classes.Warning="{Binding IsSignedOut}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Classes="ChipDot"/>
                                                        <TextBlock Text="{Binding StatusText}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Classes="PaneRow">
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>

                                        <Border Classes="PaneRow" BorderThickness="0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource Lang.Agents.Cli.Detail.Note}" Classes="Caption"/>
                                                <Button Classes="SecondaryAction Sm"
                                                        HorizontalAlignment="Left"
                                                        Content="{DynamicResource Lang.Agents.SetUp}"
                                                        Command="{Binding OpenIntegrationsCommand}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Panel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
