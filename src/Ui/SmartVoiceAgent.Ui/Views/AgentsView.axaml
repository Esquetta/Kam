<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pagevm="clr-namespace:SmartVoiceAgent.Ui.ViewModels.PageModels"
             x:Class="SmartVoiceAgent.Ui.Views.AgentsView"
             x:DataType="pagevm:AgentsViewModel">

    <UserControl.Styles>
        <!-- A role-agent row is a flat button around a TableRow; it opens the run's detail under it -->
        <Style Selector="Button.AgentRowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.AgentRowButton /template/ ContentPresenter#PART_ContentPresenter, Button.AgentRowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.AgentRowButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.TableRow.Selected">
            <Setter Property="Background" Value="{DynamicResource RaisedBgBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="WorkbenchPage PageColumn List">

            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                <StackPanel Classes="PageHeaderText">
                    <TextBlock Text="{DynamicResource Lang.Agents.Title}" Classes="PageTitle"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Lang.Agents.Subtitle}" Classes="PageSubtitle"/>
                        <Button Grid.Column="1"
                                Classes="InfoTip"
                                AutomationProperties.Name="{DynamicResource Lang.Common.MoreInfo}"
                                ToolTip.Tip="{DynamicResource Lang.Agents.SubtitleTip}">
                            <Viewbox Width="14" Height="14"><Path Classes="Icon" Data="{StaticResource IconInfo}"/></Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Coding agents: one row per CLI; Configure opens Integrations -->
            <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource Lang.Agents.Group.Coding}" Classes="SectionTitle"/>
                <Border Classes="Pane">
                    <ItemsControl ItemsSource="{Binding CodingAgents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="pagevm:AgentsCodingAgentItem">
                                <Border Classes="ListRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Border Classes="KindIcon" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" Classes="RowTitle"/>
                                                <TextBlock Text="{Binding VersionText}" Classes="Caption Mono" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SignInText}" Classes="Secondary" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="StatusDot"
                                                    Classes.Success="{Binding IsReady}"
                                                    Classes.Warning="{Binding IsSignedOut}"/>
                                            <TextBlock Text="{Binding StatusText}" Classes="StatusText"/>
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Classes="LinkAction"
                                                Content="{DynamicResource Lang.Agents.Configure}"
                                                Command="{Binding OpenIntegrationsCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Recent role agents: a table; a row opens the run's detail under it -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{DynamicResource Lang.Agents.Group.Roles}" Classes="SectionTitle"/>
                    <TextBlock Text="{Binding RoleAgents.Count}" Classes="Caption" VerticalAlignment="Center" IsVisible="{Binding HasRoleAgents}"/>
                </StackPanel>

                <!-- Empty: one line in the section, no slab -->
                <TextBlock Text="{DynamicResource Lang.Agents.Empty.Body}"
                           Classes="Secondary"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasNoRoleAgents}"/>

                <!-- The table scrolls sideways when the page is narrower than 600 px -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasRoleAgents}">
                    <Border Classes="Pane" MinWidth="600">
                        <StackPanel>
                            <Grid Classes="TableHeader" ColumnDefinitions="160,*,120,56,88">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Lang.Agents.Detail.Role}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Lang.Agents.Detail.Task}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Lang.Agents.Detail.Status}"/>
                                <TextBlock Grid.Column="3" Text="{DynamicResource Lang.Agents.Column.Steps}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{DynamicResource Lang.Agents.Column.When}" TextAlignment="Right"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RoleAgents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="pagevm:AgentsRoleRunItem">
                                        <StackPanel>
                                            <Button Classes="AgentRowButton" Command="{Binding SelectCommand}">
                                                <Border Classes="TableRow" Classes.Selected="{Binding IsSelected}">
                                                    <Grid ColumnDefinitions="160,*,120,56,88">
                                                        <TextBlock Text="{Binding AgentName}"
                                                                   Classes="RowTitle"
                                                                   FontWeight="Normal"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding Role}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Task}"
                                                                   Classes="Secondary"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Border Classes="StatusDot"
                                                                    Classes.Accent="{Binding IsRunning}"
                                                                    Classes.Success="{Binding IsSucceeded}"
                                                                    Classes.Danger="{Binding IsFailed}"/>
                                                            <TextBlock Text="{Binding StatusText}" Classes="StatusText" Classes.Danger="{Binding IsFailed}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Observations.Count}"
                                                                   Classes="Secondary"
                                                                   TextAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding RelativeTimeText}"
                                                                   Classes="Secondary"
                                                                   TextAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding StartedText}"/>
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <!-- The selected run: facts, task, tool results, then the answer -->
                                            <Border Padding="16,8,16,16" IsVisible="{Binding IsSelected}">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                                        <TextBlock Grid.Row="0" Text="{DynamicResource Lang.Agents.Detail.Model}" Classes="KvKey"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelId}" Classes="KvValue Mono" TextAlignment="Left"/>
                                                        <TextBlock Grid.Row="1" Text="{DynamicResource Lang.Agents.Detail.Started}" Classes="KvKey"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartedText}" Classes="KvValue" TextAlignment="Left"/>
                                                        <TextBlock Grid.Row="2" Text="{DynamicResource Lang.Agents.Detail.Finished}" Classes="KvKey"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FinishedText}" Classes="KvValue" TextAlignment="Left"/>
                                                        <TextBlock Grid.Row="3" Text="{DynamicResource Lang.Agents.Detail.Duration}" Classes="KvKey"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DurationText}" Classes="KvValue" TextAlignment="Left"/>
                                                    </Grid>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{DynamicResource Lang.Agents.Detail.Task}" Classes="Caption"/>
                                                        <SelectableTextBlock Text="{Binding Task}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="6" IsVisible="{Binding HasObservations}">
                                                        <TextBlock Text="{DynamicResource Lang.Agents.Detail.Tools}" Classes="Caption"/>
                                                        <ItemsControl ItemsSource="{Binding Observations}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="pagevm:AgentsToolObservationItem">
                                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                                        <Border Classes="StatusDot"
                                                                                Classes.Success="{Binding Success}"
                                                                                Classes.Danger="{Binding Failed}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding ToolName}" Classes="Secondary Mono" TextWrapping="NoWrap"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="Secondary" TextWrapping="Wrap"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4" IsVisible="{Binding HasResponse}">
                                                        <TextBlock Text="{DynamicResource Lang.Agents.Detail.Response}" Classes="Caption"/>
                                                        <SelectableTextBlock Text="{Binding Response}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4" IsVisible="{Binding HasError}">
                                                        <TextBlock Text="{DynamicResource Lang.Agents.Detail.Error}" Classes="Caption"/>
                                                        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AccentErrorBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4" IsVisible="{Binding HasLastMessageOnly}">
                                                        <TextBlock Text="{DynamicResource Lang.Agents.Detail.Progress}" Classes="Caption"/>
                                                        <TextBlock Text="{Binding LastMessage}" Classes="Secondary" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource Lang.Agents.Detail.NoOutput}" Classes="EmptyText" IsVisible="{Binding HasNoOutput}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
