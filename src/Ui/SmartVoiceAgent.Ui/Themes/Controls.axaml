<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Kam design system.
        Surfaces:   PanelBg (window) < SurfaceBg (content) < CardBg (cards) < CardBgHover (hover/pressed)
        Accent:     AccentBrush for text and icons, AccentStrongBrush for fills and focus, AccentSubtleBrush for tints
        Type scale: PageTitle 24 / SectionTitle 15 / Body 13 / Caption 11-12 / Overline 11 caps
        Shape:      RadiusSmall 6 (chips), RadiusMedium 8 (controls, cards), RadiusLarge 10 (panels)
    -->

    <!-- ========================= -->
    <!-- WINDOW + TEXT DEFAULTS -->
    <!-- ========================= -->

    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>

    <!-- ========================= -->
    <!-- ICONS -->
    <!-- ========================= -->

    <!-- Stroke icons drawn on a 24x24 grid; wrap in a sized Viewbox -->
    <Style Selector="Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ========================= -->
    <!-- CARD + SURFACES -->
    <!-- ========================= -->

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.Card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
    </Style>

    <Style Selector="Border.Surface">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    </Style>

    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <!-- ========================= -->
    <!-- WORKBENCH PAGE CHROME -->
    <!-- ========================= -->

    <Style Selector="Grid.WorkbenchPage">
        <Setter Property="Margin" Value="0" />
        <Setter Property="RowSpacing" Value="20" />
        <Setter Property="MaxWidth" Value="1040" />
    </Style>

    <Style Selector="StackPanel.WorkbenchPage">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Spacing" Value="20" />
        <Setter Property="MaxWidth" Value="1040" />
    </Style>

    <Style Selector="Border.WorkbenchSection">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>

    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.Overline">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>

    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    </Style>

    <!-- ========================= -->
    <!-- BUTTONS -->
    <!-- ========================= -->

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.PrimaryAction">
        <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PrimaryAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentStrongHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="Button.PrimaryAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="Button.PrimaryAction TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="Button.PrimaryAction Path">
        <Setter Property="Fill" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="Button.PrimaryAction Path.Icon">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="Button.PrimaryAction:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.PrimaryAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="Button.SecondaryAction">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.SecondaryAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SecondaryAction:pointerover Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Disabled actions keep their shape and fade instead of turning into grey slabs -->
    <Style Selector="Button.SecondaryAction:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.SecondaryAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.DestructiveAction">
        <Setter Property="Background" Value="{DynamicResource AccentErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentErrorOnBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.DestructiveAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentErrorDimBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentErrorOnBrush}" />
    </Style>

    <Style Selector="Button.GhostAction">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.GhostAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.GhostAction Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.GhostAction:pointerover Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!--
        Icon buttons. IconButton is a ghost square or circle; IconAction adds a hairline border.
        The hover and pressed fills cover the whole button, and the glyph brightens with them.
        Glyphs are Path.Icon in a Viewbox: they keep their 24x24 grid (Stretch None), so narrow
        icons such as the mic or the play triangle stay centered instead of hugging the left edge.
        Tint a glyph with Accent, Success or Danger; leave it plain for the muted default.
    -->
    <Style Selector="Button.IconButton">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.IconAction">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.IconButton /template/ ContentPresenter#PART_ContentPresenter, Button.IconAction /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.IconAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <Style Selector="Button.IconAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
    </Style>

    <Style Selector="Button.IconButton:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.IconAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
    </Style>

    <Style Selector="Button.IconButton:disabled, Button.IconAction:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.IconButton:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.IconAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.IconButton Path.Icon, Button.IconAction Path.Icon">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.IconButton:pointerover Path.Icon, Button.IconAction:pointerover Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Tinted glyphs keep their color on hover; the fill behind them still changes. -->
    <Style Selector="Path.Icon.Accent">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Path.Icon.Success">
        <Setter Property="Stroke" Value="{DynamicResource AccentGreenBrush}" />
    </Style>

    <Style Selector="Path.Icon.Danger">
        <Setter Property="Stroke" Value="{DynamicResource AccentErrorBrush}" />
    </Style>

    <Style Selector="Path.Icon.Muted">
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Border.IconBadge">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.IconBadge Path">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.IconBadge Path.Icon">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Talk button: the whole round button turns red while recording a command. -->
    <Style Selector="Button.TalkButton.listening /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentErrorBrush}" />
    </Style>

    <Style Selector="Button.TalkButton.listening:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentErrorDimBrush}" />
    </Style>

    <Style Selector="Button.TalkButton.listening Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <Style Selector="ProgressBar.VoiceMeter">
        <Setter Property="Width" Value="44" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <Style Selector="Button.CompactIconButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.CompactAction">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.CompactAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    </Style>

    <!-- ========================= -->
    <!-- PILLS / BADGES -->
    <!-- ========================= -->

    <!-- A pill that acts as a button, such as the title bar status. -->
    <Style Selector="Button.PillButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PillButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.PillButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.PillButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.PillButton:pointerover Border.Pill">
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <!-- Segmented control: the activity drawer tabs and the Extensions tabs -->
    <Style Selector="Border.Segmented">
        <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <Style Selector="Button.DrawerTab">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.DrawerTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.DrawerTab.Selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.DrawerTab.Selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BoxShadow" Value="0 1 2 0 #1F000000"/>
    </Style>

    <Style Selector="Button.DrawerTab Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="Button.DrawerTab:pointerover Path.Icon, Button.DrawerTab.Selected Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Filter chips, such as the kinds on the Extensions page -->
    <Style Selector="Button.Chip">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.Chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.Chip.Selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.Chip.Selected /template/ ContentPresenter#PART_ContentPresenter, Button.Chip.Selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.Chip TextBlock.ChipCount">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style Selector="Button.Chip.Selected TextBlock.ChipCount">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.Pill">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.Pill TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.Pill.Accent">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="Border.Pill.Accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.Pill.Success">
        <Setter Property="Background" Value="{DynamicResource AccentGreenGlowBrush}" />
    </Style>
    <Style Selector="Border.Pill.Success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
    </Style>

    <Style Selector="Border.Pill.Warning">
        <Setter Property="Background" Value="{DynamicResource AccentOrangeGlowBrush}" />
    </Style>
    <Style Selector="Border.Pill.Warning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
    </Style>

    <Style Selector="Border.Pill.Danger">
        <Setter Property="Background" Value="{DynamicResource AccentErrorGlowBrush}" />
    </Style>
    <Style Selector="Border.Pill.Danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentErrorBrush}" />
    </Style>

    <!-- ========================= -->
    <!-- INPUTS -->
    <!-- ========================= -->

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AccentOnBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Disabled inputs keep their surface and fade, like disabled actions -->
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
    </Style>

    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="ComboBox:disabled /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
    </Style>

    <!-- ========================= -->
    <!-- SCROLLVIEWER -->
    <!-- ========================= -->

    <Style Selector="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- ========================= -->
    <!-- TOOLTIP -->
    <!-- ========================= -->

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBgElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Markdown in chat replies (Controls/MarkdownView.cs) -->
    <Style Selector="SelectableTextBlock.Markdown">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="SelectableTextBlock.MarkdownHeading">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style Selector="SelectableTextBlock.MarkdownHeading.H1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style Selector="SelectableTextBlock.MarkdownHeading.H2">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="25" />
    </Style>

    <Style Selector="SelectableTextBlock.MarkdownHeading.H3">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style Selector="TextBlock.MarkdownListMarker">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="2,0,8,0" />
    </Style>

    <Style Selector="Border.MarkdownQuote">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="12,2,0,2" />
    </Style>

    <Style Selector="Border.MarkdownRule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>

    <Style Selector="Border.MarkdownCodeBlock">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Grid.MarkdownCodeHeader">
        <Setter Property="Margin" Value="12,5,5,0" />
    </Style>

    <Style Selector="TextBlock.MarkdownCodeLanguage">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="SelectableTextBlock.MarkdownCode">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Margin" Value="12,2,12,12" />
    </Style>

    <Style Selector="Button.MarkdownCopy">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.MarkdownCopy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.MarkdownCopy Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.MarkdownCopy:pointerover Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.MarkdownTable">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.MarkdownTableCell">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.MarkdownTableCell.Header">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    </Style>

    <Style Selector="Border.MarkdownTableCell.Header SelectableTextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- List pages (Extensions, Skills): rows, group headers, status dots and row toggles -->
    <Style Selector="Border.ListRow">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.ListRow:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}"/>
    </Style>

    <Style Selector="Border.KindIcon">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
    </Style>

    <Style Selector="Border.KindIcon Path.Icon">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.StatusDot">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="Border.StatusDot.Success">
        <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
    </Style>

    <Style Selector="Border.StatusDot.Danger">
        <Setter Property="Background" Value="{DynamicResource AccentErrorBrush}"/>
    </Style>

    <Style Selector="Border.StatusDot.Accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.StatusDot.Warning">
        <Setter Property="Background" Value="{DynamicResource AccentOrangeBrush}"/>
    </Style>

    <Style Selector="TextBlock.GroupTitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.GroupCount">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.RowTitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.RowText">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.ErrorText">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentErrorBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.EmptyText">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Button.LinkAction">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.LinkAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}"/>
    </Style>

    <Style Selector="ToggleSwitch.RowToggle">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
