<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral surfaces (Kam Studio): window/page bg < panels and cards < raised fills < hover -->
    <Color x:Key="PanelBg">#0D0D12</Color>
    <Color x:Key="SurfaceBg">#0D0D12</Color>
    <Color x:Key="CardBg">#13131A</Color>
    <Color x:Key="SurfaceBgElevated">#13131A</Color>
    <Color x:Key="RaisedBg">#1A1A23</Color>
    <Color x:Key="CardBgHover">#20202B</Color>
    <!-- Translucent fills for ghost controls, so hover reads the same on any surface -->
    <Color x:Key="ControlHover">#10FFFFFF</Color>
    <Color x:Key="ControlPressed">#1CFFFFFF</Color>
    <Color x:Key="BorderSubtle">#262632</Color>
    <Color x:Key="BorderMuted">#363645</Color>
    <!-- Off switch track: 3:1 against cards and against the white knob -->
    <Color x:Key="SwitchOffTrack">#6B6979</Color>
    <Color x:Key="TextPrimary">#F2F1F7</Color>
    <Color x:Key="TextSecondary">#BAB9C7</Color>
    <Color x:Key="TextMuted">#8C8B9C</Color>

    <!-- Brand accent: Accent is for text and icons, AccentStrong for fills and focus rings -->
    <Color x:Key="Accent">#8B7CFF</Color>
    <Color x:Key="AccentStrong">#6E5BF0</Color>
    <Color x:Key="AccentStrongHover">#5F4BE6</Color>
    <Color x:Key="AccentSubtle">#248B7CFF</Color>
    <Color x:Key="AccentOn">#FFFFFF</Color>

    <!-- Status colors: ok (green), warn (orange), bad (error), info; *Glow is the soft fill behind them -->
    <Color x:Key="AccentGreen">#34D399</Color>
    <Color x:Key="AccentGreenDim">#10B981</Color>
    <Color x:Key="AccentGreenGlow">#2134D399</Color>
    <Color x:Key="AccentGreenOn">#04120C</Color>
    <Color x:Key="AccentPurple">#C084FC</Color>
    <Color x:Key="AccentPurpleDim">#A855F7</Color>
    <Color x:Key="AccentPurpleGlow">#1FC084FC</Color>
    <Color x:Key="AccentOrange">#FBBF24</Color>
    <Color x:Key="AccentOrangeDim">#F59E0B</Color>
    <Color x:Key="AccentOrangeGlow">#21FBBF24</Color>
    <Color x:Key="AccentError">#F87171</Color>
    <Color x:Key="AccentErrorDim">#EF4444</Color>
    <Color x:Key="AccentErrorGlow">#21F87171</Color>
    <Color x:Key="AccentErrorOn">#1A0505</Color>
    <Color x:Key="AccentInfo">#60A5FA</Color>
    <Color x:Key="AccentInfoGlow">#2160A5FA</Color>

    <!-- Diff lines -->
    <Color x:Key="DiffAddBg">#1A34D399</Color>
    <Color x:Key="DiffDelBg">#1AF87171</Color>

    <!-- Fluent theme accent overrides so built-in controls follow the brand accent -->
    <Color x:Key="SystemAccentColor">#6E5BF0</Color>
    <Color x:Key="SystemAccentColorLight1">#7B69F6</Color>
    <Color x:Key="SystemAccentColorLight2">#8B7CFF</Color>
    <Color x:Key="SystemAccentColorLight3">#A99EFF</Color>
    <Color x:Key="SystemAccentColorDark1">#5B45E0</Color>
    <Color x:Key="SystemAccentColorDark2">#4A35C9</Color>
    <Color x:Key="SystemAccentColorDark3">#3A28A8</Color>
</ResourceDictionary>
